# ============================================================
# 项目 .gitignore —— 白名单模式
#
# 原则：git 只跟踪「当前项目已有文件」；
#       后续产生的任何其他文件（运行产物 / 下载物 / 临时文件 / 密钥等）
#       默认全部忽略，不会上传。
#
# 维护方法：今后确有新文件需要跟踪时，在下方「放行清单」追加一行：
#     !/<文件或目录名>
#   （server/ views/ public/ 三个源码目录已整体放行，其内部新增源码自动可见）
# ============================================================

# ---------- 一、白名单：放行当前项目已有文件 ----------
/*
!/.gitignore
!/.eslintignore
!/.eslintrc.json
!/.eslintrc-frontend.json
!/AGENTS.md
!/LICENSE
!/README.md
!/部署指南.md
!/cdn-config.js
!/ecosystem.config.js
!/package.json
!/package-lock.json
!/server/
!/views/
!/public/

# ---------- 二、放行目录内部的运行产物（黑名单） ----------

# 依赖
node_modules/

# 数据库（SQLite 及其衍生文件）
database.sqlite
database.sqlite.tmp
database.sqlite.backup.*
database.sqlite-wal
database.sqlite-shm
database.sqlite-journal

# 用户上传文件（public/ 已放行，此处排除 uploads 全部内容，仅保留占位 .gitkeep）
public/uploads/*
!public/uploads/dynamics/
!public/uploads/dynamics/.gitkeep

# 日志
logs/
*.log
npm-debug.log*

# 备份
backups/

# 环境变量与密钥（生产密钥一律不上传；.env.example 示例文件亦不跟踪）
.env
.env.*
.session_secret
.dev_encryption_key
*.key
*.pem
config.json
security-config.json

# 临时 / 缓存 / 构建产物
tmp/
temp/
*.tmp
*.temp
.cache/
*.cache
.parcel-cache/
dist/
build/
coverage/
.nyc_output/
*.tgz
*.zip

# PM2 / 部署 / 运行时状态
.pm2/
.mimocode/.cron-lock
.setup_completed
deploy/
deploy_logs/

# 操作系统 / IDE / 编辑器
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
*.bak
*.orig

# Python（部署脚本与运行时产物一律不跟踪）
deploy.py
full_check.py
*.pyc
__pycache__/
*.pyo
*.pyd
.Python
venv/
ENV/
env/

# 其他工具产物
cookies.txt
login_result.html
.writerHelper
.mimocode/
