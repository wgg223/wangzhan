{
  "name": "website-with-admin",
  "version": "5.9.1",
  "description": "网站前端和后台管理系统 ",
  "main": "server/app.js",
  "scripts": {
    "start": "node --expose-gc --max-old-space-size=768 server/app.js",
    "dev": "node --expose-gc --max-old-space-size=768 server/app.js",
    "pm2": "pm2 start ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:logs": "pm2 logs website-admin",
    "pm2:monit": "pm2 monit",
    "start:prod": "npm run pm2",
    "health": "node -e \"fetch('http://localhost:3000/health').then(r=>r.json()).then(d=>console.log(JSON.stringify(d,null,2))).catch(e=>console.error('健康检查失败:',e.message))\"",
    "lint": "eslint . --ext .js,.mjs",
    "lint:fix": "eslint . --ext .js,.mjs --fix",
    "lint:frontend": "eslint public/js/ -c .eslintrc-frontend.json --ext .js",
    "lint:frontend:fix": "eslint public/js/ -c .eslintrc-frontend.json --ext .js --fix",
    "lint:server": "eslint server/ scripts/ --ext .js,.mjs",
    "lint:server:fix": "eslint server/ scripts/ --ext .js,.mjs --fix",
    "security:audit": "npm audit",
    "security:audit:fix": "npm audit fix",
    "security:check": "node -e \"const config = require('./security-config.json'); console.log('安全配置验证通过:', Object.keys(config).length, '个配置项');\""
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.17.3",
    "iconv-lite": "^0.6.3",
    "jsonwebtoken": "^9.0.2",
    "marked": "^12.0.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.4.1",
    "nodemailer": "^9.0.6",
    "quill": "^2.0.0",
    "sanitize-html": "^2.17.6",
    "sql.js": "^1.9.0",
    "svg-captcha": "^1.4.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.2"
  },
  "allowScripts": [
    "better-sqlite3"
  ],
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-security": "^2.1.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
