{
    "name":  "website-with-admin",
    "version":  "8.8.0",
    "description":  "网站前端和后台管理系统 ",
    "main":  "server/app.js",
    "scripts":  {
                    "start":  "node --expose-gc --max-old-space-size=768 server/app.js",
                    "dev":  "node --expose-gc --max-old-space-size=768 server/app.js",
                    "pm2":  "pm2 start ecosystem.config.js",
                    "pm2:restart":  "pm2 restart ecosystem.config.js",
                    "pm2:stop":  "pm2 stop ecosystem.config.js",
                    "pm2:logs":  "pm2 logs website-admin",
                    "pm2:monit":  "pm2 monit",
                    "build:univer":  "node scripts/build-univer.mjs",
                    "start:prod":  "npm run pm2",
                    "health":  "node -e \"fetch(\u0027http://localhost:3000/health\u0027).then(r=\u003er.json()).then(d=\u003econsole.log(JSON.stringify(d,null,2))).catch(e=\u003econsole.error(\u0027健康检查失败:\u0027,e.message))\"",
                    "lint":  "eslint . --ext .js,.mjs",
                    "lint:fix":  "eslint . --ext .js,.mjs --fix",
                    "lint:frontend":  "eslint public/js/ -c .eslintrc-frontend.json --ext .js",
                    "lint:frontend:fix":  "eslint public/js/ -c .eslintrc-frontend.json --ext .js --fix",
                    "lint:server":  "eslint server/ scripts/ --ext .js,.mjs",
                    "lint:server:fix":  "eslint server/ scripts/ --ext .js,.mjs --fix",
                    "security:audit":  "npm audit",
                    "security:audit:fix":  "npm audit fix",
                    "security:check":  "node -e \"const config = require(\u0027./security-config.json\u0027); console.log(\u0027安全配置验证通过:\u0027, Object.keys(config).length, \u0027个配置项\u0027);\""
                },
    "dependencies":  {
                         "@univerjs/preset-sheets-conditional-formatting":  "^1.0.0",
                         "@univerjs/preset-sheets-core":  "^1.0.0",
                         "@univerjs/preset-sheets-data-validation":  "^1.0.0",
                         "@univerjs/preset-sheets-filter":  "^1.0.0",
                         "@univerjs/preset-sheets-find-replace":  "^1.0.0",
                         "@univerjs/preset-sheets-hyper-link":  "^1.0.0",
                         "@univerjs/presets":  "^1.0.0",
                         "adm-zip":  "^0.6.0",
                         "axios":  "^1.18.1",
                         "bcryptjs":  "^2.4.3",
                         "better-sqlite3":  "13.0.3",
                         "cookie-parser":  "^1.4.7",
                         "dotenv":  "^17.4.2",
                         "echarts":  "^6.1.0",
                         "ejs":  "^3.1.9",
                         "express":  "^4.18.2",
                         "express-ejs-layouts":  "^2.5.1",
                         "express-session":  "^1.17.3",
                         "iconv-lite":  "^0.6.3",
                         "jsonwebtoken":  "^9.0.2",
                         "marked":  "^12.0.0",
                         "multer":  "^1.4.5-lts.1",
                         "node-cron":  "^4.4.1",
                         "nodemailer":  "^9.0.6",
                         "quill":  "^2.0.0",
                         "sanitize-html":  "^2.17.6",
                         "sql.js":  "^1.9.0",
                         "svg-captcha":  "^1.4.0",
                         "xlsx":  "^0.18.5"
                     },
    "allowScripts":  {
                         "0":  "better-sqlite3",
                         "better-sqlite3@11.10.0":  true
                     },
    "devDependencies":  {
                            "esbuild":  "^0.28.2",
                            "eslint":  "^8.56.0",
                            "eslint-plugin-node":  "^11.1.0",
                            "eslint-plugin-promise":  "^6.1.1",
                            "eslint-plugin-security":  "^2.1.0",
                            "nodemon":  "^3.0.2"
                        },
    "engines":  {
                    "node":  "\u003e=16.0.0"
                }
}
