# ============================================
# 网站环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ============================================

# ---- 基础配置 ----

# 运行环境：development / production
NODE_ENV=production

# 服务端口（默认 3000）
PORT=3000

# 会话密钥（生产环境必须设置，至少32位随机字符串）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_session_secret_here

# 数据加密密钥（用于加密SMTP密码等敏感数据，不设置则使用SESSION_SECRET）
# DATA_ENCRYPTION_KEY=your_encryption_key_here

# 站点URL（用于OAuth回调、邮件中的链接等）
# SITE_URL=https://your-domain.com

# ---- CDN配置（可选）----

# 是否启用CDN加速（true/false）
CDN_ENABLED=false

# CDN基础域名
CDN_BASE_URL=

# 原站域名
ORIGIN_URL=

# 资源版本号（更新缓存时修改此值）
CDN_VERSION=1.0.0

# ---- OAuth第三方登录（可选，在后台设置中配置）----

# GitHub OAuth
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- 部署相关 ----

# 信任代理层数（Nginx反向代理设为1，直接暴露设为0）
# TRUST_PROXY=1
