</style>

<script>
function getCsrfToken() {
  const meta = document.querySelector('meta[name="csrf-token"]');
  return meta ? meta.getAttribute('content') : '';
}

// 加载系统信息
async function loadSystemInfo() {
  try {
    const response = await fetch('/admin/system-update/status', {
      headers: {
        'CSRF-Token': getCsrfToken(),
        'X-Requested-With': 'XMLHttpRequest'
      }
    });
    
    const result = await response.json();
    
    if (result.success && result.data) {
      document.getElementById('currentVersion').textContent = result.data.currentVersion;
      document.getElementById('nodeVersion').textContent = result.data.nodeVersion;
      document.getElementById('platform').textContent = result.data.platform;
      
      const uptimeSeconds = Math.floor(result.data.uptime);
      const days = Math.floor(uptimeSeconds / 86400);
      const hours = Math.floor((uptimeSeconds % 86400) / 3600);
      const minutes = Math.floor((uptimeSeconds % 3600) / 60);
      let uptimeStr = '';
      if (days > 0) uptimeStr += days + '天';
      if (hours > 0) uptimeStr += hours + '小时';
      uptimeStr += minutes + '分钟';
      document.getElementById('uptime').textContent = uptimeStr;
    }
  } catch (error) {
    console.error('加载系统信息失败:', error);
  }
}

// 检查更新
let updateData = null;

async function checkUpdate() {
  const btn = document.getElementById('checkUpdateBtn');
  const btnText = btn.querySelector('.btn-text');
  const btnLoading = btn.querySelector('.btn-loading');
  const updateStatus = document.getElementById('updateStatus');
  const statusMsg = document.getElementById('statusMessage');
  
  btn.disabled = true;
  btnText.style.display = 'none';
  btnLoading.style.display = 'inline';
  
  try {
    const response = await fetch('/admin/system-update/check', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'CSRF-Token': getCsrfToken(),
        'X-Requested-With': 'XMLHttpRequest'
      }
    });
    
    const result = await response.json();
    
    if (result.success && result.data) {
      updateData = result.data;

      document.getElementById('currentVersion').textContent = result.data.currentVersion;
      document.getElementById('latestVersion').textContent = result.data.latestVersion;
      document.getElementById('latestVersionContainer').style.display = 'flex';

      if (result.data.hasUpdate) {
        updateStatus.className = 'update-status has-update';
        statusMsg.textContent = `发现新版本 ${result.data.latestVersion}！`;

        document.getElementById('releaseInfo').style.display = 'block';
        document.getElementById('releaseName').textContent = result.data.releaseName || '新版本可用';
        document.getElementById('publishedAt').textContent = result.data.publishedAt ? '发布时间: ' + new Date(result.data.publishedAt).toLocaleString() : '';
        document.getElementById('releaseBody').innerHTML = renderMarkdown(result.data.releaseBody || '暂无更新说明');

        if (result.data.releaseUrl) {
          document.getElementById('releaseUrl').href = result.data.releaseUrl;
        }

        document.getElementById('downloadBtn').style.display = 'inline-block';
        document.getElementById('forceUpdateBtn').style.display = 'inline-block';

        addUpdateLog(`发现新版本 ${result.data.latestVersion}`, 'info');
      } else {
        updateStatus.className = 'update-status no-update';
        statusMsg.textContent = '当前已是最新版本';
        document.getElementById('releaseInfo').style.display = 'none';
        document.getElementById('downloadBtn').style.display = 'none';
        document.getElementById('forceUpdateBtn').style.display = 'none';

        addUpdateLog('检查完成，当前已是最新版本', 'success');
      }

      if (result.data.changelog && result.data.changelog.length > 0) {
        renderChangelog(result.data.changelog);
      }
    } else {
      throw new Error(result.error || '检查更新失败');
    }
  } catch (error) {
    console.error('检查更新失败:', error);
    updateStatus.className = 'update-status error';
    statusMsg.textContent = `检查更新失败: ${error.message}`;
    
    addUpdateLog(`检查更新失败: ${error.message}`, 'error');
  } finally {
    btn.disabled = false;
    btnText.style.display = 'inline';
    btnLoading.style.display = 'none';
  }
}

// 启动更新任务（下载并安装最新版本，后台执行 + 进度轮询）
async function startUpdateTask(force) {
  const versionLabel = updateData && updateData.latestVersion ? updateData.latestVersion : '最新版';
  const msg = force
    ? `⚠️ 强制更新将直接下载并覆盖安装最新版本 v${versionLabel}，无论当前版本是否已是最新。\n\n更新前会自动备份，是否继续？`
    : `确定要下载并安装版本 ${versionLabel} 吗？\n\n更新前会自动备份当前项目。`;

  if (!confirm(msg)) return;

  const btn = document.getElementById(force ? 'forceUpdateBtn' : 'downloadBtn');
  const btnText = btn.querySelector('.btn-text');
  const btnLoading = btn.querySelector('.btn-loading');
  const statusEl = document.getElementById('updateStatus');
  const statusMsg = document.getElementById('statusMessage');

  setButtonsDisabled(true);
  btnText.style.display = 'none';
  btnLoading.style.display = 'inline';

  statusEl.className = 'update-status downloading';
  statusMsg.textContent = '正在启动更新任务...';
  document.getElementById('progressBar').style.display = 'block';
  document.getElementById('progressBarFill').style.width = '0%';

  addUpdateLog(`开始下载版本 v${versionLabel}`, 'info');

  try {
    const response = await fetch('/admin/system-update/download', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'CSRF-Token': getCsrfToken(),
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify({})
    });

    const result = await response.json();

    if (!result.success) {
      throw new Error(result.error || '启动更新失败');
    }

    addUpdateLog(result.message, 'info');
    startPolling();
  } catch (error) {
    console.error('启动更新失败:', error);
    statusEl.className = 'update-status error';
    statusMsg.textContent = '启动更新失败: ' + error.message;

    addUpdateLog(`启动更新失败: ${error.message}`, 'error');

    resetButtonStates();
  }
}

// 下载并安装更新
function downloadUpdate() {
  startUpdateTask(false);
}

// 重启服务器
async function restartServer() {
  if (!confirm('确定要重启服务器吗？\n\n服务器将在3秒后重启，所有连接将断开。')) {
    return;
  }
  
  const btn = document.getElementById('restartBtn');
  const btnText = btn.querySelector('.btn-text');
  const btnLoading = btn.querySelector('.btn-loading');
  const statusEl = document.getElementById('updateStatus');
  const statusMsg = document.getElementById('statusMessage');
  
  btn.disabled = true;
  btnText.style.display = 'none';
  btnLoading.style.display = 'inline';
  
  statusEl.className = 'update-status downloading';
  statusMsg.textContent = '服务器正在重启，请稍候...';
  
  addUpdateLog('服务器即将重启...', 'info');
  
  try {
    const response = await fetch('/admin/system-update/restart', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'CSRF-Token': getCsrfToken(),
        'X-Requested-With': 'XMLHttpRequest'
      }
    });
    
    const result = await response.json();
    
    if (!result.success) {
      throw new Error(result.error || '重启服务器失败');
    }
    
    addUpdateLog('服务器重启指令已发送', 'success');
    startRestartCountdown(3);
  } catch (error) {
    console.error('重启服务器失败:', error);
    statusEl.className = 'update-status error';
    statusMsg.textContent = '重启服务器失败: ' + error.message;
    
    addUpdateLog(`重启服务器失败: ${error.message}`, 'error');
    
    btn.disabled = false;
    btnText.style.display = 'inline';
    btnLoading.style.display = 'none';
  }
}

function addUpdateLog(message, type) {
  const logContainer = document.getElementById('updateLog');
  const timestamp = new Date().toLocaleString();
  
  const logEntry = document.createElement('div');
  logEntry.className = `log-entry log-${type}`;
  logEntry.innerHTML = `<span class="log-time">[${timestamp}]</span> ${message}`;
  
  if (logContainer.querySelector('.text-muted')) {
    logContainer.innerHTML = '';
  }
  
  logContainer.insertBefore(logEntry, logContainer.firstChild);
}

// ============ 更新任务进度轮询 ============
let pollTimer = null;

function startPolling() {
  if (pollTimer) return;
  pollTimer = setInterval(pollTaskProgress, 1000);
}

function stopPolling() {
  if (pollTimer) {
    clearInterval(pollTimer);
    pollTimer = null;
  }
}

async function pollTaskProgress() {
  try {
    const response = await fetch('/admin/system-update/progress', {
      headers: {
        'CSRF-Token': getCsrfToken(),
        'X-Requested-With': 'XMLHttpRequest'
      }
    });
    const result = await response.json();
    if (!result.success || !result.data) return;
    renderTask(result.data);
  } catch (e) {
    console.error('获取更新进度失败:', e);
    stopPolling();
  }
}

function renderTask(task) {
  const statusEl = document.getElementById('updateStatus');
  const statusMsg = document.getElementById('statusMessage');
  const barWrap = document.getElementById('progressBar');
  const barFill = document.getElementById('progressBarFill');

  if (task.status === 'idle') {
    stopPolling();
    return;
  }

  barWrap.style.display = 'block';
  barFill.style.width = (task.progress || 0) + '%';

  if (task.status === 'error') {
    statusEl.className = 'update-status error';
    statusMsg.textContent = task.message || '更新失败';
    addUpdateLog('更新失败: ' + (task.message || ''), 'error');
    resetButtonStates();
    stopPolling();
    return;
  }

  if (task.status === 'done') {
    statusEl.className = 'update-status success';
    statusMsg.textContent = task.message || '更新安装成功';
    addUpdateLog(`版本 v${task.version || ''} 安装成功`, 'success');
    if (task.backupPath) {
      addUpdateLog(`备份已保存到: ${task.backupPath}`, 'info');
    }
    document.getElementById('downloadBtn').style.display = 'none';
    document.getElementById('forceUpdateBtn').style.display = 'none';
    stopPolling();
    startRestartCountdown(3);
    return;
  }

  // 进行中
  statusEl.className = 'update-status downloading';
  statusMsg.textContent = task.message || '更新进行中...';
}

function setButtonsDisabled(disabled) {
  ['checkUpdateBtn', 'downloadBtn', 'forceUpdateBtn', 'restartBtn'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.disabled = disabled;
  });
}

function resetButtonStates() {
  ['checkUpdateBtn', 'downloadBtn', 'forceUpdateBtn', 'restartBtn'].forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    el.disabled = false;
    const text = el.querySelector('.btn-text');
    const loading = el.querySelector('.btn-loading');
    if (text) text.style.display = 'inline';
    if (loading) loading.style.display = 'none';
  });
}

function startRestartCountdown(seconds) {
  const statusMsg = document.getElementById('statusMessage');
  let countdown = seconds;
  const interval = setInterval(() => {
    statusMsg.textContent = `服务器将在 ${countdown} 秒后自动重启...`;
    countdown--;
    if (countdown < 0) {
      clearInterval(interval);
      statusMsg.textContent = '正在重启，请稍后刷新页面...';
      setTimeout(() => { window.location.reload(); }, 5000);
    }
  }, 1000);
}

// 页面加载时自动加载系统信息，并恢复进行中的更新任务状态
document.addEventListener('DOMContentLoaded', function() {
  loadSystemInfo();
  startPolling();
});

function renderMarkdown(text) {
  return text
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>')
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/^### (.*$)/gm, '<h4>$1</h4>')
    .replace(/^## (.*$)/gm, '<h3>$1</h3>')
    .replace(/^# (.*$)/gm, '<h2>$1</h2>')
    .replace(/^- (.*$)/gm, '<li>$1</li>')
    .replace(/(<li>.*<\/li>)/s, '<ul>$1</ul>')
    .replace(/\n/g, '<br>');
}

function renderChangelog(changelog) {
  var section = document.getElementById('changelogSection');
  var list = document.getElementById('changelogList');
  list.innerHTML = '';
  section.style.display = 'block';

  changelog.forEach(function(item) {
    var div = document.createElement('div');
    var cls = 'changelog-item';
    if (item.isCurrent) cls += ' current';
    div.className = cls;

    var badge = '';
    if (item.isCurrent) badge = '<span class="changelog-badge current">当前版本</span>';
    else if (item === changelog[0]) badge = '<span class="changelog-badge latest">最新版本</span>';

    var dateStr = item.publishedAt ? new Date(item.publishedAt).toLocaleDateString() : '';

    div.innerHTML =
      '<div class="changelog-header">' +
        '<span class="changelog-version">v' + item.version + '</span>' +
        badge +
        '<span class="changelog-date">' + dateStr + '</span>' +
      '</div>' +
      '<div class="changelog-body">' + renderMarkdown(item.body || '暂无更新说明') + '</div>';

    list.appendChild(div);
  });
}

async function forceUpdate() {
  startUpdateTask(true);
}
</script>
