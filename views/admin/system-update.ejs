<%# ===== 页面模板：admin/system-update.ejs =====%>
<%# 说明：后台-系统更新页（EJS 服务端模板，由 Express 渲染，变量与部分逻辑见对应路由） %>
<% var active = 'system-update' %>
<div class="admin-page">
  <div class="page-header">
    <h1>系统更新</h1>
    <p class="page-desc">检查并管理系统更新，支持自动下载和重启</p>
  </div>

  <div class="settings-section">
    <h2>版本信息</h2>
    
    <div class="update-info-card">
      <div class="version-display">
        <div class="current-version">
          <span class="label">当前版本</span>
          <span class="version" id="currentVersion">加载中...</span>
        </div>
        <div class="latest-version" id="latestVersionContainer" style="display: none;">
          <span class="label">最新版本</span>
          <span class="version" id="latestVersion">-</span>
        </div>
      </div>
      
      <div class="system-info" id="systemInfo">
        <div class="info-item">
          <span class="label">Node.js版本</span>
          <span class="value" id="nodeVersion">-</span>
        </div>
        <div class="info-item">
          <span class="label">运行平台</span>
          <span class="value" id="platform">-</span>
        </div>
        <div class="info-item">
          <span class="label">运行时间</span>
          <span class="value" id="uptime">-</span>
        </div>
      </div>
      
      <div class="update-status" id="updateStatus">
        <div class="status-message" id="statusMessage">点击下方按钮检查更新</div>
        <div class="progress-bar" id="progressBar" style="display: none;">
          <div class="progress-bar-fill" id="progressBarFill"></div>
        </div>
      </div>

      <div class="github-link-section">
        <a href="https://github.com/wgg223/wangzhan" target="_blank" rel="noopener noreferrer" class="github-repo-link">
          在 GitHub 上查看仓库
        </a>
      </div>
      
      <div class="release-info" id="releaseInfo" style="display: none;">
        <h3 id="releaseName"></h3>
        <div class="release-meta">
          <span id="publishedAt"></span>
        </div>
        <div class="release-body" id="releaseBody"></div>
        <div class="release-link">
          <a id="releaseUrl" href="#" target="_blank" rel="noopener noreferrer">在 GitHub 上查看此版本</a>
        </div>
      </div>

      <div class="update-actions">
        <button type="button" class="btn btn-primary" id="checkUpdateBtn" onclick="checkUpdate()">
          <span class="btn-text">检查更新</span>
          <span class="btn-loading" style="display: none;">检查中...</span>
        </button>
        <button type="button" class="btn btn-success" id="downloadBtn" onclick="downloadUpdate()" style="display: none;">
          <span class="btn-text">下载并安装更新</span>
          <span class="btn-loading" style="display: none;">下载中...</span>
        </button>
        <button type="button" class="btn btn-danger" id="forceUpdateBtn" onclick="forceUpdate()">
          <span class="btn-text">强制更新到最新版</span>
          <span class="btn-loading" style="display: none;">更新中...</span>
        </button>
        <button type="button" class="btn btn-warning" id="restartBtn" onclick="restartServer()">
          <span class="btn-text">重启服务器</span>
          <span class="btn-loading" style="display: none;">重启中...</span>
        </button>
      </div>
    </div>
  </div>

  <div class="settings-section" id="changelogSection" style="display: none;">
    <h2>更新日志</h2>
    <div class="changelog-list" id="changelogList"></div>
  </div>

  <div class="settings-section">
    <h2>操作日志</h2>
    <div class="update-log" id="updateLog">
      <p class="text-muted">暂无更新记录</p>
    </div>
  </div>
</div>

<style>
.update-info-card {
  background: var(--gray-50);
  border-radius: 8px;
  padding: 24px;
  margin-bottom: 20px;
}

.version-display {
  display: flex;
  gap: 40px;
  margin-bottom: 20px;
}

.current-version, .latest-version {
  display: flex;
  flex-direction: column;
}

.version-display .label {
  font-size: 12px;
  color: var(--text-muted);
  margin-bottom: 4px;
}

.version-display .version {
  font-size: 24px;
  font-weight: bold;
  color: var(--text-primary);
}

.latest-version .version {
  color: var(--primary);
}

.system-info {
  display: flex;
  gap: 30px;
  margin-bottom: 20px;
  padding: 15px;
  background: var(--bg-card);
  border-radius: 6px;
  border: 1px solid var(--border-color);
}

.system-info .info-item {
  display: flex;
  flex-direction: column;
}

.system-info .label {
  font-size: 11px;
  color: var(--text-muted);
  margin-bottom: 2px;
}

.system-info .value {
  font-size: 14px;
  font-weight: 500;
  color: var(--text-primary);
}

.update-status {
  padding: 16px;
  border-radius: 6px;
  margin-bottom: 20px;
}

.update-status.has-update {
  background: var(--warning-bg);
  border: 1px solid var(--warning);
}

.update-status.no-update {
  background: var(--success-bg);
  border: 1px solid var(--success);
}

.update-status.error {
  background: var(--danger-bg);
  border: 1px solid var(--danger);
}

.update-status.downloading {
  background: var(--info-bg);
  border: 1px solid var(--info);
}

.update-status.success {
  background: var(--success-bg);
  border: 1px solid var(--success);
}

.status-message {
  font-size: 14px;
}

.release-info {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 6px;
  padding: 20px;
  margin-bottom: 20px;
}

.release-info h3 {
  margin-top: 0;
  margin-bottom: 10px;
  font-size: 18px;
}

.release-meta {
  font-size: 12px;
  color: var(--text-muted);
  margin-bottom: 15px;
}

.release-body {
  max-height: 300px;
  overflow-y: auto;
  white-space: pre-wrap;
  font-size: 14px;
  line-height: 1.6;
}

.update-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.update-actions .btn {
  padding: 10px 20px;
  font-size: 14px;
  min-width: 140px;
}

.update-actions .btn-warning {
  background: var(--warning);
  border-color: var(--warning);
  color: var(--text-primary);
}

.update-actions .btn-warning:hover {
