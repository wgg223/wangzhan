<%# ===== 页面模板：admin/my-approvals.ejs =====%>
<%# 说明：后台-我的审批页：当前用户作为指定审批人的待办权限申请（EJS 服务端模板，由 Express 渲染，变量见 server/routes/admin/permissions.js） %>
<% var active = 'my-approvals' %>
<div class="admin-page">
  <div class="page-header">
    <h1>📝 我的审批</h1>
  </div>

  <div class="alert alert-info">
    <span>💡</span> 以下是等待您审批的权限申请。基础权限经您批准后由系统自动确认生效；
    高危权限您批准后将自动转交您的上级管理员终审；超高危权限（☣）二级批准后将转交超级管理员终审。全部申请可在 <a href="/admin/permissions">🔐 权限管理</a> 中查看。
  </div>

  <div class="section-card accent-warning">
    <div class="section-header bg-gradient-warning">
      <h2>⏳ 待我审批 <span class="badge badge-warning"><%= myPendingApplications.length %></span></h2>
    </div>
    <div class="section-body">
      <% if (myPendingApplications.length > 0) { %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>申请人</th>
              <th>申请权限</th>
              <th>类型</th>
              <th>当前阶段</th>
              <th>申请理由</th>
              <th>申请时间</th>
              <th>进度时间线</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            <% myPendingApplications.forEach(function(app) { %>
              <tr>
                <td>
                  <strong><%= app.username %></strong>
                  <a href="/admin/users?keyword=<%= encodeURIComponent(app.username) %>" class="link-user" title="在用户管理中查看该用户">👤</a>
                  <div style="font-size:var(--text-xs);color:var(--gray-400);"><%= app.email || '未填写邮箱' %></div>
                </td>
                <td><span class="perm-tag perm-default"><%= app.perm_name || app.perm_key %></span></td>
                <td>
                  <% if (app.perm_ultra_high_risk == 1) { %>
                    <span class="risk-badge risk-ultra">☣ 超高危</span>
                  <% } else if (app.high_risk) { %>
                    <span class="risk-badge risk-high">🔴 高危</span>
                  <% } else { %>
                    <span class="risk-badge risk-basic">🟢 基础</span>
                  <% } %>
                </td>
                <td>
                  <% if ((app.approval_stage || 1) === 1) { %>
                    <span class="stage-badge stage-1">一级 · 对应管理员审批</span>
                  <% } else if ((app.approval_stage || 1) === 3) { %>
                    <span class="stage-badge stage-3">三级 · 超级管理员终审</span>
                  <% } else { %>
                    <span class="stage-badge stage-2">二级 · 上级终审</span>
                  <% } %>
                </td>
                <td><%= app.reason || '无' %></td>
                <td><%= new Date(app.created_at).toLocaleString('zh-CN') %></td>
                <td>
                  <% if (app.approved_by_admin_at) { %>一级通过：<%= new Date(app.approved_by_admin_at).toLocaleString('zh-CN') %><br><% } %>
                  <% if (app.approved_by_superior_at) { %>二级通过：<%= new Date(app.approved_by_superior_at).toLocaleString('zh-CN') %><% } %>
                  <% if (!app.approved_by_admin_at && !app.approved_by_superior_at) { %>-<% } %>
                </td>
                <td class="actions">
                  <button class="btn btn-small btn-success" onclick="approveApplication(<%= app.id %>)">✓ 批准</button>
                  <button class="btn btn-small btn-danger" onclick="rejectApplication(<%= app.id %>)">✗ 拒绝</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state">
          <span class="empty-state-icon">🎉</span>
          <p class="empty-state-text">暂无等待您审批的申请</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- 拒绝申请弹窗 -->
<div id="rejectModal" class="modal-overlay" style="display: none;">
  <div class="modal-content">
    <div class="modal-header">
      <h3>拒绝权限申请</h3>
      <button class="modal-close" onclick="closeRejectModal()">&times;</button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="rejectApplicationId">
      <div class="form-group">
        <label>拒绝原因（可选）</label>
        <textarea id="rejectReasonInput" rows="4" placeholder="请输入拒绝原因，将展示给申请人..." style="width:100%;padding:10px;border:1px solid var(--gray-200);border-radius:var(--radius-sm);resize:vertical;font-family:inherit;"></textarea>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-danger" onclick="confirmReject()">确认拒绝</button>
      <button class="btn" onclick="closeRejectModal()">取消</button>
    </div>
  </div>
</div>

<script>
function getCsrfToken() {
  var meta = document.querySelector('meta[name="csrf-token"]');
  return meta ? meta.getAttribute('content') : '';
}

function approveApplication(applicationId) {
  if (!confirm('确定批准此权限申请吗？\n（高危申请一级批准后转交上级终审；超高危申请二级批准后转交超级管理员终审）')) return;

  fetch('/admin/permissions/approve', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': getCsrfToken()
    },
    body: JSON.stringify({ application_id: applicationId, _csrf: getCsrfToken() })
  })
  .then(function(response) { return response.json(); })
  .then(function(data) {
    if (data.success) {
      showToast(data.message || '已批准', 'success');
      setTimeout(function() { location.reload(); }, 900);
    } else {
      alert(data.error || '操作失败');
    }
  })
  .catch(function(err) {
    alert('操作失败: ' + err.message);
  });
}

function rejectApplication(applicationId) {
  document.getElementById('rejectApplicationId').value = applicationId;
  document.getElementById('rejectReasonInput').value = '';
  document.getElementById('rejectModal').style.display = 'flex';
}

function closeRejectModal() {
  document.getElementById('rejectModal').style.display = 'none';
}

function confirmReject() {
  var applicationId = document.getElementById('rejectApplicationId').value;
  var reason = document.getElementById('rejectReasonInput').value.trim();

  fetch('/admin/permissions/reject', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': getCsrfToken()
    },
    body: JSON.stringify({ application_id: applicationId, reason: reason, _csrf: getCsrfToken() })
  })
  .then(function(response) { return response.json(); })
  .then(function(data) {
    if (data.success) {
      showToast('已拒绝该申请', 'success');
      setTimeout(function() { location.reload(); }, 900);
    } else {
      alert(data.error || '操作失败');
    }
  })
  .catch(function(err) {
    alert('操作失败: ' + err.message);
  });
}

document.getElementById('rejectModal').addEventListener('click', function(e) {
  if (e.target === this) closeRejectModal();
});
</script>

<style>
.link-user {
  margin-left: 6px;
  font-size: var(--text-xs);
  text-decoration: none;
}

.link-user:hover {
  text-decoration: underline;
}

.risk-badge {
  display: inline-block;
  padding: 2px 8px;
  border-radius: var(--radius-xs);
  font-size: var(--text-xs);
  font-weight: 600;
  white-space: nowrap;
}

.risk-badge.risk-high {
  background: #fee2e2;
  color: #b91c1c;
}

.risk-badge.risk-basic {
  background: #d4edda;
  color: #155724;
}

.stage-badge {
  display: inline-block;
  padding: 2px 8px;
  border-radius: var(--radius-xs);
  font-size: var(--text-xs);
  font-weight: 600;
  white-space: nowrap;
}

.stage-badge.stage-1 {
  background: #fff3cd;
  color: #856404;
}

.stage-badge.stage-3 {
  background: #e5e0ff;
  color: #5b21b6;
}

.stage-badge.stage-2 {
  background: #e7f1ff;
  color: #1d6fa5;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(4px);
}

.modal-content {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  width: 480px;
  max-width: 90%;
  max-height: 80vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-xl);
  animation: modalSlideIn 0.2s ease;
}

@keyframes modalSlideIn {
  from { transform: translateY(-20px); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.modal-header {
  padding: var(--space-4) var(--space-6);
  background: var(--gray-50);
  border-bottom: 1px solid var(--gray-100);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-header h3 {
  margin: 0;
  font-size: var(--text-lg);
  color: var(--gray-800);
}

.modal-close {
  background: none;
  border: none;
  font-size: 24px;
  cursor: pointer;
  color: var(--gray-400);
  transition: var(--transition-fast);
}

.modal-close:hover {
  color: var(--gray-600);
}

.modal-body {
  padding: var(--space-6);
  overflow-y: auto;
  flex: 1;
}

.modal-footer {
  padding: var(--space-4) var(--space-6);
  background: var(--gray-50);
  border-top: 1px solid var(--gray-100);
  display: flex;
  justify-content: flex-end;
  gap: var(--space-3);
}
</style>

<script>
// 审批通知深链：?id=<申请id> 时高亮并滚动到对应申请行
(function () {
  try {
    var params = new URLSearchParams(window.location.search);
    var aid = params.get('id');
    if (aid) {
      var rows = document.querySelectorAll('.admin-table tbody tr');
      rows.forEach(function (tr) {
        var btn = tr.querySelector('button[onclick*="' + aid + ')"]');
        if (btn) {
          tr.style.outline = '2px solid #f59e0b';
          tr.style.boxShadow = '0 0 10px rgba(245, 158, 11, 0.45)';
          tr.scrollIntoView({ behavior: 'smooth', block: 'center' });
          setTimeout(function () { tr.style.outline = ''; tr.style.boxShadow = ''; }, 4000);
        }
      });
    }
  } catch (e) {}
})();
</script>
