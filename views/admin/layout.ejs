<%# ===== 页面模板：admin/layout.ejs =====%>
<%# 说明：后台公共布局：侧边栏+顶栏+权限菜单渲染（EJS 服务端模板，由 Express 渲染，变量与部分逻辑见对应路由） %>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <script>
  // 全局 CSRF 拦截器：自动为所有非 GET fetch 请求注入 CSRF-Token 头
  (function() {
    var _origFetch = window.fetch;
    window.fetch = function(url, opts) {
      opts = opts || {};
      var method = (opts.method || 'GET').toUpperCase();
      if (method !== 'GET' && method !== 'HEAD' && method !== 'OPTIONS') {
        opts.headers = opts.headers || {};
        // 兼容 Headers 对象和普通对象
        var hasCsrf = false;
        if (opts.headers instanceof Headers) {
          hasCsrf = opts.headers.has('CSRF-Token') || opts.headers.has('X-CSRF-Token');
        } else {
          var keys = Object.keys(opts.headers);
          for (var i = 0; i < keys.length; i++) {
            if (keys[i].toLowerCase() === 'csrf-token' || keys[i].toLowerCase() === 'x-csrf-token') {
              hasCsrf = true; break;
            }
          }
        }
        if (!hasCsrf) {
          var meta = document.querySelector('meta[name="csrf-token"]');
          var token = meta ? meta.getAttribute('content') : '';
          if (token) {
            if (opts.headers instanceof Headers) {
              opts.headers.set('CSRF-Token', token);
            } else {
              opts.headers['CSRF-Token'] = token;
            }
          }
        }
      }
      return _origFetch.call(this, url, opts);
    };
  })();
  </script>
  <title>后台管理 - 网站管理系统</title>
  <link rel="stylesheet" href="<%= typeof cdn !== 'undefined' ? cdn.getUrl('/css/admin.css') : '/css/admin.css' %>">
  <link rel="stylesheet" href="<%= typeof cdn !== 'undefined' ? cdn.getUrl('/css/anime-theme.css') : '/css/anime-theme.css' %>">
  <!-- Quill rich text editor CSS + JS - 使用本地版本，备用 CDN -->
  <link href="<%= typeof cdn !== 'undefined' ? cdn.getUrl('/vendor/quill/quill.snow.css') : '/vendor/quill/quill.snow.css' %>" rel="stylesheet" id="quill-css">
  <script src="<%= typeof cdn !== 'undefined' ? cdn.getUrl('/vendor/quill/quill.js') : '/vendor/quill/quill.js' %>"></script>
  <!-- 备用 CDN (如果本地加载失败) -->
  <script>
    if (typeof Quill === 'undefined') {
      var cssLink = document.createElement('link');
      cssLink.rel = 'stylesheet';
      cssLink.href = 'https://cdnjs.cloudflare.com/ajax/libs/quill/2.0.0/quill.snow.css';
      document.head.appendChild(cssLink);
      
      var scriptTag = document.createElement('script');
      scriptTag.src = 'https://cdnjs.cloudflare.com/ajax/libs/quill/2.0.0/quill.min.js';
      document.head.appendChild(scriptTag);
    }
  </script>
</head>
<body>
<%
  // 辅助函数：检查用户是否拥有某个权限（精确匹配 + 通配符 xxx.* + 层级 xxx.edit.all 覆盖 xxx.edit.own）
  function hasPerm(permissions, permKey) {
    if (!permissions || !Array.isArray(permissions)) return false;
    if (permissions.indexOf(permKey) !== -1) return true;
    var wildcard = permKey.split('.')[0] + '.*';
    if (permissions.indexOf(wildcard) !== -1) return true;
    return permissions.some(function(key) {
      var kp = key.split('.');
      var pp = permKey.split('.');
      // 层级匹配：articles.edit.all 覆盖 articles.edit.own
      if (kp.length === 3 && kp[2] === 'all' && kp[0] === pp[0] && kp[1] === pp[1]) return true;
      return false;
    });
  }
  // 辅助函数：判断当前菜单是否处于激活状态
  var _cur = typeof currentPath !== 'undefined' ? currentPath : '';
  function isActive(path) {
    if (!_cur) return false;
    if (path === '/admin' && _cur !== '/admin') return false;
    return _cur.indexOf(path) === 0;
  }
  var _isSuper = user && user.role === 'super_admin';
  var _roleName = _isSuper ? '超级管理员' : (user.role === 'admin' ? '管理员' : (user.role === 'visitor' ? '访客' : '普通用户'));
  var _roleIcon = _isSuper ? '👑' : (user.role === 'admin' ? '🛡️' : (user.role === 'visitor' ? '👁️' : '👤'));
%>
<div class="admin-container">
    <aside class="sidebar">
      <div class="sidebar-header">
        <h2>后台管理</h2>
      </div>
      <div class="sidebar-user">
        <div class="sidebar-user-avatar"><%= _roleIcon %></div>
        <div class="sidebar-user-info">
          <span class="sidebar-user-name"><%= user.username %></span>
          <span class="sidebar-user-role role-<%= user.role %>"><%= _roleName %></span>
        </div>
      </div>
      <nav class="sidebar-nav">
        <% if (typeof userPermissions !== 'undefined' && (hasPerm(userPermissions, 'site_stats.view') || user.role === 'super_admin')) { %>
        <div class="nav-group">
          <p class="nav-group-title">概览</p>
          <ul>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'site_stats.view')) { %>
            <li><a href="/admin/site-stats" class="<%= isActive('/admin/site-stats') ? 'active' : '' %>">📈 站点统计</a></li>
            <% } %>
            <% if (user.role === 'super_admin') { %>
            <li><a href="/admin" class="<%= isActive('/admin') ? 'active' : '' %>">📊 仪表盘</a></li>
            <li><a href="/admin/activity-logs" class="<%= isActive('/admin/activity-logs') ? 'active' : '' %>">📋 操作日志</a></li>
            <li><a href="/admin/server-logs" class="<%= isActive('/admin/server-logs') ? 'active' : '' %>">🖥️ 服务器日志</a></li>
            <% } %>
          </ul>
        </div>
        <% } %>
        <% if (typeof userPermissions !== 'undefined' && (hasPerm(userPermissions, 'pages.manage') || hasPerm(userPermissions, 'articles.manage') || hasPerm(userPermissions, 'novels.manage') || hasPerm(userPermissions, 'comments.manage') || hasPerm(userPermissions, 'prompts.view') || hasPerm(userPermissions, 'prompts.manage') || hasPerm(userPermissions, 'imagegen.manage') || hasPerm(userPermissions, 'aichat.manage') || hasPerm(userPermissions, 'spreadsheet.manage'))) { %>
        <div class="nav-group">
          <p class="nav-group-title">内容管理</p>
          <ul>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'pages.manage')) { %>
            <li><a href="/admin/pages" class="<%= isActive('/admin/pages') ? 'active' : '' %>">📄 页面管理</a></li>
            <% } %>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'articles.manage')) { %>
            <li><a href="/admin/articles" class="<%= isActive('/admin/articles') ? 'active' : '' %>">📝 文章管理</a></li>
            <% } %>
            <% if (typeof userPermissions !== 'undefined' && (hasPerm(userPermissions, 'prompts.view') || hasPerm(userPermissions, 'prompts.manage'))) { %>
            <li><a href="/admin/prompts" class="<%= isActive('/admin/prompts') ? 'active' : '' %>">🤖 AI提示词</a></li>
            <% } %>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'imagegen.manage')) { %>
            <li><a href="/admin/ai-image" class="<%= isActive('/admin/ai-image') ? 'active' : '' %>">🎨 AI生图</a></li>
            <% } %>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'aichat.manage')) { %>
            <li><a href="/admin/ai-chat" class="<%= isActive('/admin/ai-chat') ? 'active' : '' %>">🤖 AI聊天</a></li>
            <% } %>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'novels.manage')) { %>
            <li><a href="/admin/novels" class="<%= isActive('/admin/novels') ? 'active' : '' %>">📚 小说管理</a></li>
            <% } %>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'comments.manage')) { %>
            <li><a href="/admin/comments" class="<%= isActive('/admin/comments') ? 'active' : '' %>">💬 评论管理</a></li>
            <% } %>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'spreadsheet.manage')) { %>
            <li><a href="/admin/spreadsheets" class="<%= isActive('/admin/spreadsheets') ? 'active' : '' %>">📂 在线Office</a></li>
            <% } %>
          </ul>
        </div>
        <% } %>
        <% if (typeof userPermissions !== 'undefined' && (hasPerm(userPermissions, 'messages.manage') || hasPerm(userPermissions, 'image-share.manage') || hasPerm(userPermissions, 'shares.manage'))) { %>
        <div class="nav-group">
          <p class="nav-group-title">社区互动</p>
          <ul>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'messages.manage')) { %>
            <li><a href="/admin/messages" class="<%= isActive('/admin/messages') ? 'active' : '' %>">📬 站内信</a></li>
            <% } %>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'image-share.manage')) { %>
            <li><a href="/admin/image-share" class="<%= isActive('/admin/image-share') ? 'active' : '' %>">🖼️ 图片分享</a></li>
            <% } %>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'shares.manage')) { %>
            <li><a href="/admin/shares" class="<%= isActive('/admin/shares') ? 'active' : '' %>">🔗 分享管理</a></li>
            <% } %>
          </ul>
        </div>
        <% } %>
        <div class="nav-group">
          <p class="nav-group-title">用户与权限</p>
          <ul>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'users.manage')) { %>
            <li><a href="/admin/users" class="<%= isActive('/admin/users') ? 'active' : '' %>">👥 用户管理</a></li>
            <% } %>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'permissions.manage')) { %>
            <li><a href="/admin/permissions" class="<%= isActive('/admin/permissions') ? 'active' : '' %>">🔐 权限管理</a></li>
            <% } %>
            <% if (user.role === 'admin' || user.role === 'super_admin') { %>
            <li><a href="/admin/my-approvals" class="<%= isActive('/admin/my-approvals') ? 'active' : '' %>">📝 我的审批</a></li>
            <% } %>
            <li><a href="/permissions/apply" class="<%= isActive('/permissions/apply') ? 'active' : '' %>">🔑 权限申请</a></li>
          </ul>
        </div>
        <% if (user.role === 'super_admin') { %>
        <div class="nav-group">
          <p class="nav-group-title">网站设置</p>
          <ul>
            <li><a href="/admin/settings/basic" class="<%= isActive('/admin/settings/basic') ? 'active' : '' %>">⚙️ 基础设置</a></li>
            <li><a href="/admin/settings/smtp" class="<%= isActive('/admin/settings/smtp') ? 'active' : '' %>">📧 SMTP配置</a></li>
            <li><a href="/admin/settings/oauth" class="<%= isActive('/admin/settings/oauth') ? 'active' : '' %>">🔗 第三方登录</a></li>
            <li><a href="/admin/settings/agreement" class="<%= isActive('/admin/settings/agreement') ? 'active' : '' %>">📄 协议设置</a></li>
            <li><a href="/admin/settings/popup" class="<%= isActive('/admin/settings/popup') ? 'active' : '' %>">🪟 弹窗设置</a></li>
            <li><a href="/admin/music" class="<%= isActive('/admin/music') ? 'active' : '' %>">🎵 音乐播放</a></li>
          </ul>
        </div>
        <% } %>
        <% if (user.role === 'super_admin') { %>
        <div class="nav-group">
          <p class="nav-group-title">服务器设置</p>
          <ul>
            <li><a href="/admin/settings" class="<%= isActive('/admin/settings') && !isActive('/admin/settings/basic') && !isActive('/admin/settings/smtp') && !isActive('/admin/settings/oauth') && !isActive('/admin/settings/agreement') && !isActive('/admin/settings/popup') ? 'active' : '' %>">🚀 CDN设置</a></li>
            <li><a href="/admin/system-update" class="<%= isActive('/admin/system-update') ? 'active' : '' %>">🔄 系统更新</a></li>
            <li><a href="/admin/backup" class="<%= isActive('/admin/backup') ? 'active' : '' %>">💾 备份管理</a></li>
            <li><a href="/admin/maintenance" class="<%= isActive('/admin/maintenance') ? 'active' : '' %>">🔧 服务器维护</a></li>
            <li><a href="/admin/projects" class="<%= isActive('/admin/projects') ? 'active' : '' %>">📦 项目管理</a></li>
            <li><a href="/admin/reset" class="danger-link <%= isActive('/admin/reset') ? 'active' : '' %>">⚠️ 重置服务器</a></li>
          </ul>
        </div>
        <% } %>
      </nav>
      <div class="sidebar-footer">
        <p>当前用户：<%= user.username %></p>
        <a href="/admin/profile">账户设置</a>
        <%# 登出为 POST + CSRF（防跨站 GET 触发会话销毁），按钮样式沿用 .sidebar-footer a %>
        <form method="POST" action="/auth/logout" style="margin:0;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" style="display:flex;align-items:center;gap:var(--space-2);width:100%;background:none;border:none;cursor:pointer;color:rgba(255,255,255,0.6);margin:var(--space-1) 0;font-size:var(--text-sm);padding:var(--space-1) var(--space-2);border-radius:var(--radius-xs);font-family:inherit;text-align:left;">退出登录</button>
        </form>
        <a href="/" target="_blank">查看网站</a>
      </div>
    </aside>
    <main class="admin-main">
      <div class="admin-topbar">
        <% if (typeof showBindEmailPrompt !== 'undefined' && showBindEmailPrompt) { %>
          <a href="/account#bind-email" class="admin-bind-email-banner">📧 您尚未绑定邮箱，绑定后可接收审批待办与系统告警邮件 →</a>
        <% } %>
        <div class="admin-notify" id="admin-notify">
          <button type="button" class="admin-notify-btn" id="admin-notify-btn" aria-label="通知中心" title="通知中心">
            <span aria-hidden="true">🔔</span>
            <span class="admin-notify-badge" id="admin-notify-badge" hidden>0</span>
          </button>
          <div class="admin-notify-panel" id="admin-notify-panel" hidden>
            <div class="admin-notify-head">
              <strong>通知中心</strong>
              <button type="button" class="admin-notify-readall" id="admin-notify-readall">全部标为已读</button>
            </div>
            <div class="admin-notify-list" id="admin-notify-list">
              <div class="admin-notify-empty">加载中…</div>
            </div>
            <div class="admin-notify-foot">
              <a href="/messages">全部通知与站内信 →</a>
            </div>
          </div>
        </div>
      </div>
      <%- body %>
    </main>
  </div>
  <script>
  window.addEventListener('load', function() {
    if (typeof Quill === 'undefined') {
      console.warn('Quill编辑器CDN加载失败，编辑器功能将不可用');
      document.querySelectorAll('#editor-container').forEach(function(el) {
        el.innerHTML = '<div style="padding:20px;color:#999;text-align:center;">⚠️ 编辑器组件加载失败，请刷新页面重试</div>';
      });
    }
  });
  </script>
  <script src="<%= typeof cdn !== 'undefined' ? cdn.getUrl('/js/utils.js') : '/js/utils.js' %>"></script>
  <script src="<%= typeof cdn !== 'undefined' ? cdn.getUrl('/js/admin.js') : '/js/admin.js' %>"></script>
  <script>
  // ============ 后台通知中心（铃铛） ============
  (function() {
    var notifyRoot = document.getElementById('admin-notify');
    if (!notifyRoot) return;
    var btn = document.getElementById('admin-notify-btn');
    var badge = document.getElementById('admin-notify-badge');
    var panel = document.getElementById('admin-notify-panel');
    var list = document.getElementById('admin-notify-list');
    var readAllBtn = document.getElementById('admin-notify-readall');

    // SQLite CURRENT_TIMESTAMP 为 UTC，补 Z 后再本地化；列表内展示相对时间
    function formatTime(value) {
      if (!value) return '';
      var str = String(value);
      if (!/[zZ]$|[+\-]\d{2}:\d{2}$/.test(str)) str = str.replace(' ', 'T') + 'Z';
      var date = new Date(str);
      if (isNaN(date.getTime())) return '';
      var diff = Date.now() - date.getTime();
      if (diff < 60000) return '刚刚';
      if (diff < 3600000) return Math.floor(diff / 60000) + ' 分钟前';
      if (diff < 86400000) return Math.floor(diff / 3600000) + ' 小时前';
      return date.toLocaleString('zh-CN', { hour12: false });
    }

    function updateBadge(count) {
      var value = Number(count) || 0;
      if (value > 0) {
        badge.textContent = value > 99 ? '99+' : String(value);
        badge.hidden = false;
      } else {
        badge.hidden = true;
      }
    }

    function refreshBadge() {
      fetch('/api/notifications/unread-count', { headers: { Accept: 'application/json' } })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data && data.success && data.data) updateBadge(data.data.count);
        })
        .catch(function() {});
    }

    function markRead(id) {
      fetch('/api/notifications/' + encodeURIComponent(id) + '/read', { method: 'PATCH', headers: { Accept: 'application/json' } })
        .then(function() { refreshBadge(); })
        .catch(function() {});
    }

    function renderList(items) {
      list.innerHTML = '';
      if (!items || items.length === 0) {
        var empty = document.createElement('div');
        empty.className = 'admin-notify-empty';
        empty.textContent = '暂无通知';
        list.appendChild(empty);
        return;
      }
      items.forEach(function(n) {
        var item = document.createElement('div');
        item.className = 'admin-notify-item' + (n.is_read ? '' : ' is-unread');

        var title = document.createElement('div');
        title.className = 'admin-notify-item-title';
        title.textContent = n.title || '通知';

        var content = document.createElement('div');
        content.className = 'admin-notify-item-content';
        content.textContent = n.content || '';

        var time = document.createElement('div');
        time.className = 'admin-notify-item-time';
        time.textContent = formatTime(n.created_at);

        item.appendChild(title);
        item.appendChild(content);
        item.appendChild(time);

        if (n.link) {
          item.classList.add('is-link');
          item.addEventListener('click', function() {
            if (!n.is_read) markRead(n.id);
            window.location.href = n.link;
          });
        } else {
          item.addEventListener('click', function() {
            if (!n.is_read) {
              markRead(n.id);
              n.is_read = 1;
              item.classList.remove('is-unread');
            }
          });
        }
        list.appendChild(item);
      });
    }

    function loadNotifications() {
      fetch('/api/notifications?limit=10', { headers: { Accept: 'application/json' } })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (!data || !data.success || !data.data) return;
          renderList(data.data.notifications || []);
          updateBadge(data.data.unread_count);
        })
        .catch(function() {
          list.innerHTML = '<div class="admin-notify-empty">通知加载失败</div>';
        });
    }

    btn.addEventListener('click', function(event) {
      event.stopPropagation();
      panel.hidden = !panel.hidden;
      if (!panel.hidden) loadNotifications();
    });

    readAllBtn.addEventListener('click', function(event) {
      event.stopPropagation();
      fetch('/api/notifications/read-all', { method: 'PATCH', headers: { Accept: 'application/json' } })
        .then(function() {
          updateBadge(0);
          loadNotifications();
        })
        .catch(function() {});
    });

    document.addEventListener('click', function(event) {
      if (!panel.hidden && !notifyRoot.contains(event.target)) panel.hidden = true;
    });
    document.addEventListener('keydown', function(event) {
      if (event.key === 'Escape') panel.hidden = true;
    });

    refreshBadge();
    // 每 60 秒刷新未读数（页面不可见时跳过，节省请求）
    setInterval(function() {
      if (document.visibilityState === 'visible') refreshBadge();
    }, 60000);
  })();
  </script>
</body>
</html>
