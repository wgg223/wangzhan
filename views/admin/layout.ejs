<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>后台管理 - 网站管理系统</title>
  <link rel="stylesheet" href="<%= typeof cdn !== 'undefined' ? cdn.getUrl('/css/admin.css') : '/css/admin.css' %>">
  <!-- Quill rich text editor CSS + JS - 使用本地版本，备用 CDN -->
  <link href="<%= typeof cdn !== 'undefined' ? cdn.getUrl('/vendor/quill/quill.snow.css') : '/vendor/quill/quill.snow.css' %>" rel="stylesheet" id="quill-css">
  <script src="<%= typeof cdn !== 'undefined' ? cdn.getUrl('/vendor/quill/quill.js') : '/vendor/quill/quill.js' %>"></script>
  <!-- 备用 CDN (如果本地加载失败) -->
  <script>
    if (typeof Quill === 'undefined') {
      var cssLink = document.createElement('link');
      cssLink.rel = 'stylesheet';
      cssLink.href = 'https://cdnjs.cloudflare.com/ajax/libs/quill/2.0.0/quill.snow.css';
      document.head.appendChild(cssLink);
      
      var scriptTag = document.createElement('script');
      scriptTag.src = 'https://cdnjs.cloudflare.com/ajax/libs/quill/2.0.0/quill.min.js';
      document.head.appendChild(scriptTag);
    }
  </script>
</head>
<body>
<%
  // 辅助函数：检查用户是否拥有某个权限（精确匹配 + 通配符 xxx.* + 层级 xxx.edit.all 覆盖 xxx.edit.own）
  function hasPerm(permissions, permKey) {
    if (!permissions || !Array.isArray(permissions)) return false;
    if (permissions.indexOf(permKey) !== -1) return true;
    var wildcard = permKey.split('.')[0] + '.*';
    if (permissions.indexOf(wildcard) !== -1) return true;
    return permissions.some(function(key) {
      var kp = key.split('.');
      var pp = permKey.split('.');
      // 层级匹配：articles.edit.all 覆盖 articles.edit.own
      if (kp.length === 3 && kp[2] === 'all' && kp[0] === pp[0] && kp[1] === pp[1]) return true;
      return false;
    });
  }
  // 辅助函数：判断当前菜单是否处于激活状态
  var _cur = typeof currentPath !== 'undefined' ? currentPath : '';
  function isActive(path) {
    if (!_cur) return false;
    if (path === '/admin' && _cur !== '/admin') return false;
    return _cur.indexOf(path) === 0;
  }
  var _isSuper = user && user.role === 'super_admin';
  var _roleName = _isSuper ? '超级管理员' : (user.role === 'admin' ? '管理员' : (user.role === 'visitor' ? '访客' : '普通用户'));
  var _roleIcon = _isSuper ? '👑' : (user.role === 'admin' ? '🛡️' : (user.role === 'visitor' ? '👁️' : '👤'));
%>
<div class="admin-container">
    <aside class="sidebar">
      <div class="sidebar-header">
        <h2>后台管理</h2>
      </div>
      <div class="sidebar-user">
        <div class="sidebar-user-avatar"><%= _roleIcon %></div>
        <div class="sidebar-user-info">
          <span class="sidebar-user-name"><%= user.username %></span>
          <span class="sidebar-user-role role-<%= user.role %>"><%= _roleName %></span>
        </div>
      </div>
      <nav class="sidebar-nav">
        <% if (typeof userPermissions !== 'undefined' && (hasPerm(userPermissions, 'site_stats.view') || user.role === 'super_admin')) { %>
        <div class="nav-group">
          <p class="nav-group-title">概览</p>
          <ul>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'site_stats.view')) { %>
            <li><a href="/admin/site-stats" class="<%= isActive('/admin/site-stats') ? 'active' : '' %>">📈 站点统计</a></li>
            <% } %>
            <% if (user.role === 'super_admin') { %>
            <li><a href="/admin" class="<%= isActive('/admin') ? 'active' : '' %>">📊 仪表盘</a></li>
            <li><a href="/admin/activity-logs" class="<%= isActive('/admin/activity-logs') ? 'active' : '' %>">📋 操作日志</a></li>
            <li><a href="/admin/server-logs" class="<%= isActive('/admin/server-logs') ? 'active' : '' %>">🖥️ 服务器日志</a></li>
            <% } %>
          </ul>
        </div>
        <% } %>
        <% if (typeof userPermissions !== 'undefined' && (hasPerm(userPermissions, 'pages.manage') || hasPerm(userPermissions, 'articles.manage') || hasPerm(userPermissions, 'novels.manage') || hasPerm(userPermissions, 'comments.manage'))) { %>
        <div class="nav-group">
          <p class="nav-group-title">内容管理</p>
          <ul>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'pages.manage')) { %>
            <li><a href="/admin/pages" class="<%= isActive('/admin/pages') ? 'active' : '' %>">📄 页面管理</a></li>
            <% } %>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'articles.manage')) { %>
            <li><a href="/admin/articles" class="<%= isActive('/admin/articles') ? 'active' : '' %>">📝 文章管理</a></li>
            <% } %>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'novels.manage')) { %>
            <li><a href="/admin/novels" class="<%= isActive('/admin/novels') ? 'active' : '' %>">📚 小说管理</a></li>
            <% } %>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'comments.manage')) { %>
            <li><a href="/admin/comments" class="<%= isActive('/admin/comments') ? 'active' : '' %>">💬 评论管理</a></li>
            <% } %>
          </ul>
        </div>
        <% } %>
        <% if (typeof userPermissions !== 'undefined' && (hasPerm(userPermissions, 'messages.manage') || hasPerm(userPermissions, 'leaderboard.manage') || hasPerm(userPermissions, 'image-share.manage'))) { %>
        <div class="nav-group">
          <p class="nav-group-title">社区互动</p>
          <ul>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'messages.manage')) { %>
            <li><a href="/admin/messages" class="<%= isActive('/admin/messages') ? 'active' : '' %>">📬 站内信</a></li>
            <% } %>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'leaderboard.manage')) { %>
            <li><a href="/admin/leaderboard" class="<%= isActive('/admin/leaderboard') ? 'active' : '' %>">🏆 排行榜</a></li>
            <% } %>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'image-share.manage')) { %>
            <li><a href="/admin/image-share" class="<%= isActive('/admin/image-share') ? 'active' : '' %>">🖼️ 图片分享</a></li>
            <% } %>
          </ul>
        </div>
        <% } %>
        <div class="nav-group">
          <p class="nav-group-title">用户与权限</p>
          <ul>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'users.manage')) { %>
            <li><a href="/admin/users" class="<%= isActive('/admin/users') ? 'active' : '' %>">👥 用户管理</a></li>
            <% } %>
            <% if (typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'permissions.manage')) { %>
            <li><a href="/admin/permissions" class="<%= isActive('/admin/permissions') ? 'active' : '' %>">🔐 权限管理</a></li>
            <% } %>
            <li><a href="/permissions/apply" class="<%= isActive('/permissions/apply') ? 'active' : '' %>">🔑 权限申请</a></li>
          </ul>
        </div>
        <% if ((user.role === 'admin' || user.role === 'super_admin') && typeof userPermissions !== 'undefined' && hasPerm(userPermissions, 'settings.manage')) { %>
        <div class="nav-group">
          <p class="nav-group-title">网站设置</p>
          <ul>
            <li><a href="/admin/settings/basic" class="<%= isActive('/admin/settings/basic') ? 'active' : '' %>">⚙️ 基础设置</a></li>
            <li><a href="/admin/settings/smtp" class="<%= isActive('/admin/settings/smtp') ? 'active' : '' %>">📧 SMTP配置</a></li>
            <li><a href="/admin/settings/oauth" class="<%= isActive('/admin/settings/oauth') ? 'active' : '' %>">🔗 第三方登录</a></li>
            <li><a href="/admin/settings/agreement" class="<%= isActive('/admin/settings/agreement') ? 'active' : '' %>">📄 协议设置</a></li>
            <li><a href="/admin/settings/popup" class="<%= isActive('/admin/settings/popup') ? 'active' : '' %>">🪟 弹窗设置</a></li>
          </ul>
        </div>
        <% } %>
        <% if (user.role === 'super_admin') { %>
        <div class="nav-group">
          <p class="nav-group-title">服务器设置</p>
          <ul>
            <li><a href="/admin/settings" class="<%= isActive('/admin/settings') && !isActive('/admin/settings/basic') && !isActive('/admin/settings/smtp') && !isActive('/admin/settings/oauth') && !isActive('/admin/settings/agreement') && !isActive('/admin/settings/popup') ? 'active' : '' %>">🚀 CDN设置</a></li>
            <li><a href="/admin/system-update" class="<%= isActive('/admin/system-update') ? 'active' : '' %>">🔄 系统更新</a></li>
            <li><a href="/admin/backup" class="<%= isActive('/admin/backup') ? 'active' : '' %>">💾 备份管理</a></li>
            <li><a href="/admin/maintenance" class="<%= isActive('/admin/maintenance') ? 'active' : '' %>">🔧 服务器维护</a></li>
            <li><a href="/admin/projects" class="<%= isActive('/admin/projects') ? 'active' : '' %>">📦 项目管理</a></li>
            <li><a href="/admin/reset" class="danger-link <%= isActive('/admin/reset') ? 'active' : '' %>">⚠️ 重置服务器</a></li>
          </ul>
        </div>
        <% } %>
      </nav>
      <div class="sidebar-footer">
        <p>当前用户：<%= user.username %></p>
        <a href="/admin/profile">账户设置</a>
        <a href="/auth/logout">退出登录</a>
        <a href="/" target="_blank">查看网站</a>
      </div>
    </aside>
    <main class="admin-main">
      <%- body %>
    </main>
  </div>
  <script>
  window.addEventListener('load', function() {
    if (typeof Quill === 'undefined') {
      console.warn('Quill编辑器CDN加载失败，编辑器功能将不可用');
      document.querySelectorAll('#editor-container').forEach(function(el) {
        el.innerHTML = '<div style="padding:20px;color:#999;text-align:center;">⚠️ 编辑器组件加载失败，请刷新页面重试</div>';
      });
    }
  });
  </script>
  <script src="<%= typeof cdn !== 'undefined' ? cdn.getUrl('/js/utils.js') : '/js/utils.js' %>"></script>
  <script src="<%= typeof cdn !== 'undefined' ? cdn.getUrl('/js/admin.js') : '/js/admin.js' %>"></script>
</body>
</html>
