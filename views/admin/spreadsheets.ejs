<%# ===== 页面模板：admin/spreadsheets.ejs =====%>
<%# 说明：后台在线表格管理列表页（Univer 模式） %>
<div class="admin-page-header">
  <h2>📊 在线表格管理</h2>
  <div style="display:flex;gap:10px;">
    <button class="btn btn-outline" onclick="openBatchImport()">📥 批量导入Excel</button>
    <a href="/admin/spreadsheets/create" class="btn btn-primary">➕ 创建表格</a>
  </div>
</div>

<div class="admin-card">
  <% if (sheets.length === 0) { %>
  <div class="empty-state">
    <p>暂无表格，点击右上角"创建表格"或"批量导入Excel"开始</p>
  </div>
  <% } else { %>
  <!-- 批量管理栏 -->
  <div style="display:flex;flex-wrap:wrap;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid #eee;background:#fafbfd;">
    <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px;font-weight:500;margin:0;">
      <input type="checkbox" id="sheetSelectAll" onchange="toggleSelectAllRows()"> 全选
    </label>
    <span id="batchSelectedInfo" style="font-size:13px;color:#666;">已选 0 个</span>
    <span style="flex:1;"></span>
    <button class="btn btn-outline" onclick="batchAction('restore')" title="恢复软删除的表格">♻️ 批量恢复</button>
    <button class="btn btn-outline" onclick="batchAction('lock')" title="锁定后禁止在线编辑">🔒 批量锁定</button>
    <button class="btn btn-outline" onclick="batchAction('unlock')" title="解除锁定">🔓 批量解锁</button>
    <button class="btn btn-outline" onclick="batchAction('public-read')" title="开启后所有登录用户可查看（只读）">🌐 公开只读</button>
    <button class="btn btn-outline" onclick="batchAction('public-read-off')" title="恢复私有访问（仅授权用户可查看）">🌐 取消公开</button>
    <button class="btn btn-outline" style="color:#dc3545;border-color:#dc3545;" onclick="batchAction('soft-delete')" title="软删除，可恢复">🗑️ 批量删除</button>
    <button class="btn btn-outline" style="color:#dc3545;border-color:#dc3545;" onclick="batchAction('hard-delete')" title="永久删除，不可恢复">💥 彻底删除</button>
  </div>
  <table class="admin-table">
    <thead>
      <tr>
        <th style="width:36px;"></th>
        <th>ID</th>
        <th>表格名称</th>
        <th>描述</th>
        <th>创建者</th>
        <th>创建时间</th>
        <th>状态</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% sheets.forEach(function(sheet) { %>
      <tr>
        <td><input type="checkbox" class="sheet-row-check" value="<%= sheet.id %>" onchange="updateBatchBar()"></td>
        <td><%= sheet.id %></td>
        <td><strong><%= sheet.name %></strong></td>
        <td><%= sheet.description || '-' %></td>
        <td><%= sheet.creator_name || '-' %></td>
        <td><%= new Date(sheet.created_at).toLocaleString('zh-CN') %></td>
        <td>
          <span class="status-badge <%= sheet.status === 'active' ? 'status-active' : 'status-inactive' %>">
            <%= sheet.status === 'active' ? '正常' : '已停用' %>
          </span>
          <% if (sheet.is_locked) { %>
          <span class="status-badge status-inactive" title="已锁定，禁止在线编辑">🔒 已锁定</span>
          <% } %>
          <% if (sheet.is_public_read) { %>
          <span class="status-badge" style="background:#f0fdfa;color:#0d9488;" title="公开只读：所有登录用户可查看">🌐 公开只读</span>
          <% } %>
        </td>
        <td class="table-actions">
          <a href="/spreadsheet/<%= sheet.id %>" class="action-link" target="_blank">打开</a>
          <a href="/admin/spreadsheets/<%= sheet.id %>/edit" class="action-link">编辑</a>
          <button class="action-link" onclick="openSheetPerms(<%= sheet.id %>)">权限</button>
          <button class="action-link danger" onclick="deleteSheet(<%= sheet.id %>, '<%= sheet.name.replace(/'/g, "\\'") %>')">删除</button>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } %>
</div>

<!-- 权限管理弹窗 -->
<div class="modal-overlay" id="sheetPermsModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;">
  <div class="modal" style="background:#fff;border-radius:8px;max-width:640px;width:90%;max-height:85vh;overflow-y:auto;">
    <div class="modal-header" style="padding:16px 20px;border-bottom:1px solid #eee;display:flex;justify-content:space-between;align-items:center;">
      <h3 style="margin:0;">🔐 权限管理：<span id="permSheetName"></span></h3>
      <button onclick="closeSheetPerms()" style="background:none;border:none;font-size:20px;cursor:pointer;color:#999;">&times;</button>
    </div>
    <div class="modal-body" id="sheetPermsBody" style="padding:20px;">
      <p style="color:#666;">加载中…</p>
    </div>
  </div>
</div>

<!-- 批量导入弹窗 -->
<div class="modal-overlay" id="batchImportModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;">
  <div class="modal" style="background:#fff;border-radius:8px;max-width:700px;width:90%;max-height:85vh;overflow-y:auto;">
    <div class="modal-header" style="padding:16px 20px;border-bottom:1px solid #eee;display:flex;justify-content:space-between;align-items:center;">
      <h3 style="margin:0;">📥 批量导入 Excel</h3>
      <button onclick="closeBatchImport()" style="background:none;border:none;font-size:20px;cursor:pointer;color:#999;">&times;</button>
    </div>
    <div class="modal-body" style="padding:20px;">
      <!-- 第一步：选择文件 -->
      <div id="batchStep1">
        <div style="margin-bottom:16px;">
          <label style="display:block;margin-bottom:8px;font-weight:500;">选择 Excel 文件（.xlsx/.xls，最大10MB）</label>
          <input type="file" id="batchImportFile" accept=".xlsx,.xls" style="width:100%;padding:12px;border:2px dashed #ddd;border-radius:6px;cursor:pointer;" />
        </div>
        <div style="background:#f0f4ff;padding:12px 16px;border-radius:6px;font-size:13px;color:#555;line-height:1.8;">
          <strong>说明：</strong><br>
          • 自动读取 Excel 中的所有工作表（Sheet）<br>
          • 每个工作表自动创建为一个独立的在线表格<br>
          • 自动检测表头行，支持合并单元格和日期格式<br>
          • 导入后可直接在 Univer 在线编辑器中编辑
        </div>
      </div>
      <!-- 第二步：预览并选择Sheet -->
      <div id="batchStep2" style="display:none;">
        <div style="margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;">
          <span style="font-weight:500;">文件：<span id="batchFileName"></span>（共 <span id="batchSheetCount"></span> 个工作表）</span>
          <label style="font-size:13px;cursor:pointer;"><input type="checkbox" id="batchSelectAll" checked onchange="toggleSelectAllSheets()"> 全选</label>
        </div>
        <div id="batchSheetList" style="max-height:350px;overflow-y:auto;border:1px solid #eee;border-radius:6px;"></div>
      </div>
      <!-- 导入结果 -->
      <div id="batchImportResult" style="margin-top:16px;display:none;">
        <h4 style="margin:0 0 10px 0;">导入结果</h4>
        <div id="batchImportResultList"></div>
      </div>
    </div>
    <div class="modal-footer" style="padding:16px 20px;border-top:1px solid #eee;display:flex;justify-content:flex-end;gap:10px;">
      <button class="btn btn-secondary" onclick="closeBatchImport()">取消</button>
      <button class="btn btn-outline" id="batchPreviewBtn" onclick="previewBatchFile()">🔍 预览工作表</button>
      <button class="btn btn-primary" id="batchImportBtn" style="display:none;" onclick="confirmBatchImport()">开始导入选中项</button>
    </div>
  </div>
</div>

<script>
function deleteSheet(id, name) {
  if (!confirm('确定要删除表格「' + name + '」吗？此为软删除，可稍后勾选该行通过"批量恢复"找回。')) return;
  fetch('/admin/spreadsheets/' + id, { method: 'DELETE' })
    .then(r => r.json())
    .then(data => {
      if (data.success) { alert('删除成功'); location.reload(); }
      else { alert(data.error || '删除失败'); }
    })
    .catch(err => alert('删除失败: ' + err.message));
}

// ===== 批量管理 =====
var BATCH_ACTION_META = {
  'restore': { label: '批量恢复', confirm: '确定要恢复选中的 {n} 个表格吗？恢复后表格恢复正常访问。' },
  'lock': { label: '批量锁定', confirm: '确定要锁定选中的 {n} 个表格吗？锁定后将禁止在线编辑（查看不受影响）。' },
  'unlock': { label: '批量解锁', confirm: '确定要解锁选中的 {n} 个表格吗？' },
  'public-read': { label: '批量公开只读', confirm: '确定要开启选中的 {n} 个表格的公开只读吗？\n\n开启后所有登录用户均可只读查看（内容保护与水印仍生效）。' },
  'public-read-off': { label: '取消公开只读', confirm: '确定要关闭选中的 {n} 个表格的公开只读吗？\n\n关闭后仅创建者与被授权用户可以访问。' },
  'soft-delete': { label: '批量删除', confirm: '确定要删除选中的 {n} 个表格吗？\n\n此为软删除（可恢复），已开启的分享链接将同步失效。' },
  'hard-delete': { label: '彻底删除', confirm: '⚠️ 确定要彻底删除选中的 {n} 个表格吗？\n\n所有工作表、批注、版本、图表、权限与分享记录将被永久删除，不可恢复！' }
};

function getSelectedSheetIds() {
  return Array.prototype.map.call(document.querySelectorAll('.sheet-row-check:checked'), function (cb) {
    return parseInt(cb.value, 10);
  });
}

function updateBatchBar() {
  var all = document.querySelectorAll('.sheet-row-check');
  var checked = document.querySelectorAll('.sheet-row-check:checked');
  document.getElementById('batchSelectedInfo').textContent = '已选 ' + checked.length + ' 个';
  document.getElementById('sheetSelectAll').checked = all.length > 0 && checked.length === all.length;
}

function toggleSelectAllRows() {
  var checked = document.getElementById('sheetSelectAll').checked;
  document.querySelectorAll('.sheet-row-check').forEach(function (cb) { cb.checked = checked; });
  updateBatchBar();
}

function batchAction(action) {
  var ids = getSelectedSheetIds();
  if (!ids.length) { alert('请先勾选要操作的表格'); return; }
  var meta = BATCH_ACTION_META[action];
  if (!confirm(meta.confirm.replace('{n}', ids.length))) return;
  fetch('/admin/spreadsheets/batch', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ ids: ids, action: action })
  })
    .then(r => r.json())
    .then(res => {
      if (res.success) {
        var msg = meta.label + '完成：成功 ' + res.data.ok + '/' + res.data.total;
        if (res.data.failed) msg += '，失败 ' + res.data.failed;
        alert(msg);
        location.reload();
      } else {
        alert(res.error || '操作失败');
      }
    })
    .catch(err => alert('操作失败: ' + err.message));
}

// ===== 权限管理弹窗 =====
var PERM_NAMES = { view: '只读查看', comment: '评论', edit: '编辑', download: '下载', copy: '创建副本' };
var permsSheetId = null;
var permsCreatedBy = 0;

function escHtml(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
  });
}

function openSheetPerms(id) {
  permsSheetId = id;
  document.getElementById('permSheetName').textContent = '#' + id;
  document.getElementById('sheetPermsBody').innerHTML = '<p style="color:#666;">加载中…</p>';
  document.getElementById('sheetPermsModal').style.display = 'flex';
  loadSheetPerms();
}

function closeSheetPerms() {
  document.getElementById('sheetPermsModal').style.display = 'none';
  permsSheetId = null;
}

function loadSheetPerms() {
  fetch('/admin/spreadsheets/' + permsSheetId + '/permissions')
    .then(r => r.json())
    .then(res => {
      if (!res.success) { alert(res.error || '加载失败'); return; }
      renderSheetPerms(res.data);
    })
    .catch(err => alert('加载失败: ' + err.message));
}

function renderSheetPerms(data) {
  permsCreatedBy = data.createdBy;
  document.getElementById('permSheetName').textContent = data.name || ('#' + data.id);
  var body = document.getElementById('sheetPermsBody');
  var html = '';

  // 公开只读开关
  html += '<div style="padding:6px 0 14px;border-bottom:1px solid #eee;">';
  html += '<label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-weight:500;">';
  html += '<input type="checkbox" id="permPublicRead"' + (data.isPublicRead ? ' checked' : '') + '> 🌐 公开只读（所有登录用户可查看）</label>';
  html += '<div style="font-size:12px;color:#999;margin:6px 0 0 24px;">开启后无需逐个授权；只读访客受内容保护与水印约束，不能编辑/导出。</div>';
  html += '</div>';

  // 添加授权（下拉展示全部用户）
  html += '<div style="padding:14px 0;">';
  html += '<h4 style="margin:0 0 10px;">添加授权</h4>';
  html += '<div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">';
  html += '<select id="permGrantUser" style="padding:8px;border:1px solid #ddd;border-radius:6px;max-width:240px;">';
  html += '<option value="">—— 选择用户（共 ' + data.users.length + ' 人） ——</option>';
  data.users.forEach(function (u) {
    if (u.id === permsCreatedBy) return; // 创建者无需授权
    var label = (u.nickname && u.nickname !== u.username) ? (u.username + '（' + u.nickname + '）') : u.username;
    html += '<option value="' + u.id + '">' + escHtml(label) + '</option>';
  });
  html += '</select>';
  html += '<select id="permGrantType" style="padding:8px;border:1px solid #ddd;border-radius:6px;">';
  ['view', 'comment', 'edit', 'download', 'copy'].forEach(function (t) {
    html += '<option value="' + t + '">' + PERM_NAMES[t] + '</option>';
  });
  html += '</select>';
  html += '<button class="btn btn-primary" style="padding:8px 16px;" onclick="grantSheetPerm()">授予</button>';
  html += '</div></div>';

  // 已授权用户
  html += '<h4 style="margin:0 0 10px;">已授权用户（' + data.permissions.length + '）</h4>';
  if (!data.permissions.length) {
    html += '<p style="color:#999;font-size:13px;">暂无授权记录</p>';
  } else {
    html += '<table class="admin-table"><thead><tr><th>用户</th><th>权限</th><th>授权时间</th><th>操作</th></tr></thead><tbody>';
    data.permissions.forEach(function (p) {
      html += '<tr><td>' + escHtml(p.username || p.email || ('用户 #' + p.user_id)) + '</td>';
      html += '<td>' + (PERM_NAMES[p.perm_type] || escHtml(p.perm_type)) + '</td>';
      html += '<td>' + (p.created_at ? new Date(p.created_at).toLocaleString('zh-CN') : '-') + '</td>';
      html += '<td><button class="action-link danger" onclick="revokeSheetPerm(' + p.user_id + ',\'' + p.perm_type + '\')">撤销</button></td></tr>';
    });
    html += '</tbody></table>';
  }
  body.innerHTML = html;

  // 公开只读开关事件
  document.getElementById('permPublicRead').addEventListener('change', function () {
    var to = this.checked;
    var cb = this;
    fetch('/admin/spreadsheets/' + permsSheetId + '/public-read', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ enabled: to })
    })
      .then(r => r.json())
      .then(res => {
        if (res.success) { alert(to ? '已开启公开只读' : '已关闭公开只读'); }
        else { alert(res.error || '操作失败'); cb.checked = !to; }
      })
      .catch(err => { alert('操作失败: ' + err.message); cb.checked = !to; });
  });
}

function grantSheetPerm() {
  var uid = document.getElementById('permGrantUser').value;
  var permType = document.getElementById('permGrantType').value;
  if (!uid) { alert('请选择要授权的用户'); return; }
  fetch('/admin/spreadsheets/' + permsSheetId + '/permissions', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ user_id: parseInt(uid, 10), perm_type: permType })
  })
    .then(r => r.json())
    .then(res => {
      if (res.success) { alert(res.message || '已授予'); loadSheetPerms(); }
      else { alert(res.error || '授予失败'); }
    })
    .catch(err => alert('授予失败: ' + err.message));
}

function revokeSheetPerm(userId, permType) {
  var target = document.querySelector('#sheetPermsBody option[value="' + userId + '"]');
  var name = target ? target.textContent : ('用户 #' + userId);
  if (!confirm('确定撤销「' + name + '」的「' + PERM_NAMES[permType] + '」权限吗？')) return;
  fetch('/admin/spreadsheets/' + permsSheetId + '/permissions/' + userId, {
    method: 'DELETE',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ perm_type: permType })
  })
    .then(r => r.json())
    .then(res => {
      if (res.success) { alert(res.message || '已撤销'); loadSheetPerms(); }
      else { alert(res.error || '撤销失败'); }
    })
    .catch(err => alert('撤销失败: ' + err.message));
}

var batchPreviewData = null;

function openBatchImport() {
  document.getElementById('batchImportFile').value = '';
  document.getElementById('batchStep1').style.display = 'block';
  document.getElementById('batchStep2').style.display = 'none';
  document.getElementById('batchImportResult').style.display = 'none';
  document.getElementById('batchPreviewBtn').style.display = 'inline-block';
  document.getElementById('batchImportBtn').style.display = 'none';
  batchPreviewData = null;
  document.getElementById('batchImportModal').style.display = 'flex';
}

function closeBatchImport() {
  document.getElementById('batchImportModal').style.display = 'none';
}

function previewBatchFile() {
  var fileInput = document.getElementById('batchImportFile');
  if (!fileInput.files || fileInput.files.length === 0) {
    alert('请选择 Excel 文件');
    return;
  }
  var file = fileInput.files[0];
  var maxSize = 10 * 1024 * 1024; // 10MB
  if (file.size > maxSize) {
    alert('文件大小超过 10MB 限制，请压缩或拆分后再上传');
    return;
  }
  var btn = document.getElementById('batchPreviewBtn');
  btn.disabled = true;
  btn.textContent = '解析中...';
  var formData = new FormData();
  formData.append('file', file);
  fetch('/admin/spreadsheets/batch-preview', { method: 'POST', body: formData })
    .then(function(r) {
      if (r.status === 413) {
        throw new Error('文件过大，服务器拒绝接收（413）。如果使用了 Nginx 反向代理，请在 nginx.conf 的 http 或 server 块中添加 client_max_body_size 200m;');
      }
      return r.json();
    })
    .then(function(res) {
      if (res.success) {
        batchPreviewData = res.data;
        document.getElementById('batchFileName').textContent = res.data.filename;
        document.getElementById('batchSheetCount').textContent = res.data.totalSheets;
        var listHtml = '';
        res.data.sheets.forEach(function(sheet, idx) {
          listHtml += '<div style="padding:12px;border-bottom:1px solid #eee;display:flex;gap:12px;align-items:flex-start;">';
          listHtml += '<input type="checkbox" class="sheet-checkbox" data-sheet-name="' + sheet.name.replace(/"/g, '&quot;') + '" checked style="margin-top:3px;">';
          listHtml += '<div style="flex:1;">';
          listHtml += '<div style="font-weight:500;margin-bottom:4px;">' + sheet.name + '</div>';
          listHtml += '<div style="font-size:12px;color:#666;margin-bottom:4px;">' + sheet.columns + ' 列 · ' + sheet.rows + ' 行' + (sheet.headerRow ? '（表头第' + sheet.headerRow + '行）' : '') + '</div>';
          if (sheet.headers && sheet.headers.length > 0) {
            listHtml += '<div style="font-size:12px;color:#999;">表头：' + sheet.headers.slice(0,6).join('、') + (sheet.headers.length > 6 ? '...' : '') + '</div>';
          }
          listHtml += '</div></div>';
        });
        document.getElementById('batchSheetList').innerHTML = listHtml;
        document.getElementById('batchStep1').style.display = 'none';
        document.getElementById('batchStep2').style.display = 'block';
        document.getElementById('batchPreviewBtn').style.display = 'none';
        document.getElementById('batchImportBtn').style.display = 'inline-block';
      } else {
        alert(res.error || '预览失败');
      }
    })
    .catch(function(err) { alert('预览失败: ' + err.message); })
    .finally(function() {
      btn.disabled = false;
      btn.textContent = '🔍 预览工作表';
    });
}

function toggleSelectAllSheets() {
  var checked = document.getElementById('batchSelectAll').checked;
  document.querySelectorAll('.sheet-checkbox').forEach(function(cb) { cb.checked = checked; });
}

function confirmBatchImport() {
  var fileInput = document.getElementById('batchImportFile');
  var selectedSheets = [];
  document.querySelectorAll('.sheet-checkbox:checked').forEach(function(cb) {
    selectedSheets.push(cb.getAttribute('data-sheet-name'));
  });
  if (selectedSheets.length === 0) {
    alert('请至少选择一个工作表');
    return;
  }
  var btn = document.getElementById('batchImportBtn');
  btn.disabled = true;
  btn.textContent = '导入中...';
  var formData = new FormData();
  formData.append('file', fileInput.files[0]);
  formData.append('selectedSheets', JSON.stringify(selectedSheets));
  fetch('/admin/spreadsheets/batch-import', { method: 'POST', body: formData })
    .then(function(r) {
      if (r.status === 413) {
        throw new Error('文件过大，服务器拒绝接收（413）。如果使用了 Nginx 反向代理，请在 nginx.conf 的 http 或 server 块中添加 client_max_body_size 200m;');
      }
      return r.json();
    })
    .then(function(res) {
      if (res.success) {
        var resultDiv = document.getElementById('batchImportResult');
        var listDiv = document.getElementById('batchImportResultList');
        var html = '<p style="margin:0 0 10px 0;color:#28a745;"><strong>导入完成！</strong> 共 ' + res.data.importedSheets + '/' + res.data.totalSheets + ' 个表格</p>';
        html += '<table style="width:100%;border-collapse:collapse;font-size:13px;">';
        html += '<thead><tr style="background:#f5f5f5;"><th style="padding:8px;text-align:left;border:1px solid #ddd;">工作表</th><th style="padding:8px;text-align:left;border:1px solid #ddd;">状态</th><th style="padding:8px;text-align:left;border:1px solid #ddd;">列数</th><th style="padding:8px;text-align:left;border:1px solid #ddd;">行数</th></tr></thead><tbody>';
        res.data.results.forEach(function(r) {
          html += '<tr>';
          html += '<td style="padding:8px;border:1px solid #ddd;">' + (r.name || '-') + '</td>';
          if (r.success) {
            html += '<td style="padding:8px;border:1px solid #ddd;color:#28a745;">✓ 成功</td>';
            html += '<td style="padding:8px;border:1px solid #ddd;">' + r.columns + '</td>';
            html += '<td style="padding:8px;border:1px solid #ddd;">' + r.rows + '</td>';
          } else {
            html += '<td style="padding:8px;border:1px solid #ddd;color:#dc3545;">✗ ' + (r.error || '失败') + '</td>';
            html += '<td style="padding:8px;border:1px solid #ddd;">-</td>';
            html += '<td style="padding:8px;border:1px solid #ddd;">-</td>';
          }
          html += '</tr>';
        });
        html += '</tbody></table>';
        listDiv.innerHTML = html;
        resultDiv.style.display = 'block';
        document.getElementById('batchStep2').style.display = 'none';
        btn.textContent = '关闭并刷新';
        btn.onclick = function() { location.reload(); };
      } else {
        alert(res.error || '导入失败');
        btn.disabled = false;
        btn.textContent = '开始导入选中项';
      }
    })
    .catch(function(err) { alert('导入失败: ' + err.message); })
    .finally(function() {
      if (!btn.onclick) {
        btn.disabled = false;
        btn.textContent = '开始导入选中项';
      }
    });
}
</script>
