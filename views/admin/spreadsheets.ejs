<%# ===== 页面模板：admin/spreadsheets.ejs =====%>
<%# 说明：后台在线表格管理列表页 %>
<div class="admin-page-header">
  <h2>📊 在线表格管理</h2>
  <div style="display:flex;gap:10px;">
    <button class="btn btn-outline" onclick="openBatchImport()">📥 批量导入</button>
    <a href="/admin/spreadsheets/create" class="btn btn-primary">➕ 创建表格</a>
  </div>
</div>

<div class="admin-card">
  <% if (sheets.length === 0) { %>
  <div class="empty-state">
    <p>暂无表格，点击右上角"创建表格"开始</p>
  </div>
  <% } else { %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>表格名称</th>
        <th>描述</th>
        <th>列数</th>
        <th>行数</th>
        <th>创建者</th>
        <th>创建时间</th>
        <th>状态</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% sheets.forEach(function(sheet) { %>
      <tr>
        <td><%= sheet.id %></td>
        <td><strong><%= sheet.name %></strong></td>
        <td><%= sheet.description || '-' %></td>
        <td><%= sheet.col_count %></td>
        <td><%= sheet.row_count %></td>
        <td><%= sheet.creator_name || '-' %></td>
        <td><%= new Date(sheet.created_at).toLocaleString('zh-CN') %></td>
        <td>
          <span class="status-badge <%= sheet.status === 'active' ? 'status-active' : 'status-inactive' %>">
            <%= sheet.status === 'active' ? '正常' : '已停用' %>
          </span>
        </td>
        <td class="table-actions">
          <a href="/spreadsheet/<%= sheet.id %>" class="action-link" target="_blank">查看</a>
          <a href="/admin/spreadsheets/<%= sheet.id %>/edit" class="action-link">编辑</a>
          <a href="/admin/spreadsheets/<%= sheet.id %>/columns" class="action-link">列管理</a>
          <button class="action-link danger" onclick="deleteSheet(<%= sheet.id %>, '<%= sheet.name.replace(/'/g, "\\'") %>')">删除</button>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } %>
</div>

<!-- 批量导入弹窗 -->
<div class="modal-overlay" id="batchImportModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;display:none;align-items:center;justify-content:center;">
  <div class="modal" style="background:#fff;border-radius:8px;max-width:550px;width:90%;max-height:80vh;overflow-y:auto;">
    <div class="modal-header" style="padding:16px 20px;border-bottom:1px solid #eee;display:flex;justify-content:space-between;align-items:center;">
      <h3 style="margin:0;">📥 批量导入表格</h3>
      <button onclick="closeBatchImport()" style="background:none;border:none;font-size:20px;cursor:pointer;color:#999;">&times;</button>
    </div>
    <div class="modal-body" style="padding:20px;">
      <div style="margin-bottom:16px;">
        <label style="display:block;margin-bottom:8px;font-weight:500;">选择 Excel 文件（.xlsx/.xls，最大50MB）</label>
        <input type="file" id="batchImportFile" accept=".xlsx,.xls" style="width:100%;padding:12px;border:2px dashed #ddd;border-radius:6px;cursor:pointer;" />
      </div>
      <div style="background:#f0f4ff;padding:12px 16px;border-radius:6px;font-size:13px;color:#555;line-height:1.6;">
        <strong>说明：</strong><br>
        • 系统会自动读取 Excel 文件中的所有工作表（Sheet）<br>
        • 每个工作表自动创建为一个新的在线表格<br>
        • 工作表第一行作为表头，自动创建对应列<br>
        • 表格名称使用工作表名称
      </div>
      <div id="batchImportResult" style="margin-top:16px;display:none;">
        <h4 style="margin:0 0 10px 0;">导入结果</h4>
        <div id="batchImportResultList"></div>
      </div>
    </div>
    <div class="modal-footer" style="padding:16px 20px;border-top:1px solid #eee;display:flex;justify-content:flex-end;gap:10px;">
      <button class="btn btn-secondary" onclick="closeBatchImport()">取消</button>
      <button class="btn btn-primary" id="batchImportBtn" onclick="confirmBatchImport()">开始导入</button>
    </div>
  </div>
</div>

<script>
function deleteSheet(id, name) {
  if (!confirm('确定要删除表格「' + name + '」吗？此操作不可恢复，所有列和行数据将被删除。')) return;
  fetch('/admin/spreadsheets/' + id, { method: 'DELETE' })
    .then(r => r.json())
    .then(data => {
      if (data.success) {
        alert('删除成功');
        location.reload();
      } else {
        alert(data.error || '删除失败');
      }
    })
    .catch(err => alert('删除失败: ' + err.message));
}

function openBatchImport() {
  document.getElementById('batchImportFile').value = '';
  document.getElementById('batchImportResult').style.display = 'none';
  document.getElementById('batchImportModal').style.display = 'flex';
}

function closeBatchImport() {
  document.getElementById('batchImportModal').style.display = 'none';
}

function confirmBatchImport() {
  var fileInput = document.getElementById('batchImportFile');
  if (!fileInput.files || fileInput.files.length === 0) {
    alert('请选择 Excel 文件');
    return;
  }

  var btn = document.getElementById('batchImportBtn');
  btn.disabled = true;
  btn.textContent = '导入中...';

  var formData = new FormData();
  formData.append('file', fileInput.files[0]);

  fetch('/admin/spreadsheets/batch-import', {
    method: 'POST',
    body: formData
  })
  .then(function(r) { return r.json(); })
  .then(function(res) {
    if (res.success) {
      var resultDiv = document.getElementById('batchImportResult');
      var listDiv = document.getElementById('batchImportResultList');
      var html = '<p style="margin:0 0 10px 0;color:#28a745;"><strong>导入完成！</strong> 共 ' + res.data.importedSheets + '/' + res.data.totalSheets + ' 个表格，' + res.data.totalRows + ' 行数据</p>';
      html += '<table style="width:100%;border-collapse:collapse;font-size:13px;">';
      html += '<thead><tr style="background:#f5f5f5;"><th style="padding:8px;text-align:left;border:1px solid #ddd;">工作表</th><th style="padding:8px;text-align:left;border:1px solid #ddd;">状态</th><th style="padding:8px;text-align:left;border:1px solid #ddd;">列数</th><th style="padding:8px;text-align:left;border:1px solid #ddd;">行数</th></tr></thead><tbody>';
      res.data.results.forEach(function(r) {
        html += '<tr>';
        html += '<td style="padding:8px;border:1px solid #ddd;">' + (r.name || '-') + '</td>';
        if (r.success) {
          html += '<td style="padding:8px;border:1px solid #ddd;color:#28a745;">✓ 成功</td>';
          html += '<td style="padding:8px;border:1px solid #ddd;">' + r.columns + '</td>';
          html += '<td style="padding:8px;border:1px solid #ddd;">' + r.rows + '</td>';
        } else {
          html += '<td style="padding:8px;border:1px solid #ddd;color:#dc3545;">✗ ' + (r.error || '失败') + '</td>';
          html += '<td style="padding:8px;border:1px solid #ddd;">-</td>';
          html += '<td style="padding:8px;border:1px solid #ddd;">-</td>';
        }
        html += '</tr>';
      });
      html += '</tbody></table>';
      listDiv.innerHTML = html;
      resultDiv.style.display = 'block';
      btn.textContent = '关闭';
      btn.onclick = function() { location.reload(); };
    } else {
      alert(res.error || '导入失败');
      btn.disabled = false;
      btn.textContent = '开始导入';
    }
  })
  .catch(function(err) {
    alert('导入失败: ' + err.message);
    btn.disabled = false;
    btn.textContent = '开始导入';
  });
}
</script>
