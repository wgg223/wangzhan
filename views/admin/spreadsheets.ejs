<%# ===== 页面模板：admin/spreadsheets.ejs =====%>
<%# 说明：后台在线表格管理列表页（Luckysheet 模式） %>
<div class="admin-page-header">
  <h2>📊 在线表格管理</h2>
  <div style="display:flex;gap:10px;">
    <button class="btn btn-outline" onclick="openBatchImport()">📥 批量导入Excel</button>
    <a href="/admin/spreadsheets/create" class="btn btn-primary">➕ 创建表格</a>
  </div>
</div>

<div class="admin-card">
  <% if (sheets.length === 0) { %>
  <div class="empty-state">
    <p>暂无表格，点击右上角"创建表格"或"批量导入Excel"开始</p>
  </div>
  <% } else { %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>表格名称</th>
        <th>描述</th>
        <th>创建者</th>
        <th>创建时间</th>
        <th>状态</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% sheets.forEach(function(sheet) { %>
      <tr>
        <td><%= sheet.id %></td>
        <td><strong><%= sheet.name %></strong></td>
        <td><%= sheet.description || '-' %></td>
        <td><%= sheet.creator_name || '-' %></td>
        <td><%= new Date(sheet.created_at).toLocaleString('zh-CN') %></td>
        <td>
          <span class="status-badge <%= sheet.status === 'active' ? 'status-active' : 'status-inactive' %>">
            <%= sheet.status === 'active' ? '正常' : '已停用' %>
          </span>
        </td>
        <td class="table-actions">
          <a href="/spreadsheet/<%= sheet.id %>" class="action-link" target="_blank">打开</a>
          <a href="/admin/spreadsheets/<%= sheet.id %>/edit" class="action-link">编辑</a>
          <button class="action-link danger" onclick="deleteSheet(<%= sheet.id %>, '<%= sheet.name.replace(/'/g, "\\'") %>')">删除</button>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } %>
</div>

<!-- 批量导入弹窗 -->
<div class="modal-overlay" id="batchImportModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;">
  <div class="modal" style="background:#fff;border-radius:8px;max-width:700px;width:90%;max-height:85vh;overflow-y:auto;">
    <div class="modal-header" style="padding:16px 20px;border-bottom:1px solid #eee;display:flex;justify-content:space-between;align-items:center;">
      <h3 style="margin:0;">📥 批量导入 Excel</h3>
      <button onclick="closeBatchImport()" style="background:none;border:none;font-size:20px;cursor:pointer;color:#999;">&times;</button>
    </div>
    <div class="modal-body" style="padding:20px;">
      <!-- 第一步：选择文件 -->
      <div id="batchStep1">
        <div style="margin-bottom:16px;">
          <label style="display:block;margin-bottom:8px;font-weight:500;">选择 Excel 文件（.xlsx/.xls，最大200MB）</label>
          <input type="file" id="batchImportFile" accept=".xlsx,.xls" style="width:100%;padding:12px;border:2px dashed #ddd;border-radius:6px;cursor:pointer;" />
        </div>
        <div style="background:#f0f4ff;padding:12px 16px;border-radius:6px;font-size:13px;color:#555;line-height:1.8;">
          <strong>说明：</strong><br>
          • 自动读取 Excel 中的所有工作表（Sheet）<br>
          • 每个工作表自动创建为一个独立的在线表格<br>
          • 自动检测表头行，支持合并单元格和日期格式<br>
          • 导入后可直接在 Luckysheet 中编辑
        </div>
      </div>
      <!-- 第二步：预览并选择Sheet -->
      <div id="batchStep2" style="display:none;">
        <div style="margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;">
          <span style="font-weight:500;">文件：<span id="batchFileName"></span>（共 <span id="batchSheetCount"></span> 个工作表）</span>
          <label style="font-size:13px;cursor:pointer;"><input type="checkbox" id="batchSelectAll" checked onchange="toggleSelectAllSheets()"> 全选</label>
        </div>
        <div id="batchSheetList" style="max-height:350px;overflow-y:auto;border:1px solid #eee;border-radius:6px;"></div>
      </div>
      <!-- 导入结果 -->
      <div id="batchImportResult" style="margin-top:16px;display:none;">
        <h4 style="margin:0 0 10px 0;">导入结果</h4>
        <div id="batchImportResultList"></div>
      </div>
    </div>
    <div class="modal-footer" style="padding:16px 20px;border-top:1px solid #eee;display:flex;justify-content:flex-end;gap:10px;">
      <button class="btn btn-secondary" onclick="closeBatchImport()">取消</button>
      <button class="btn btn-outline" id="batchPreviewBtn" onclick="previewBatchFile()">🔍 预览工作表</button>
      <button class="btn btn-primary" id="batchImportBtn" style="display:none;" onclick="confirmBatchImport()">开始导入选中项</button>
    </div>
  </div>
</div>

<script>
function deleteSheet(id, name) {
  if (!confirm('确定要删除表格「' + name + '」吗？此操作不可恢复。')) return;
  fetch('/admin/spreadsheets/' + id, { method: 'DELETE' })
    .then(r => r.json())
    .then(data => {
      if (data.success) { alert('删除成功'); location.reload(); }
      else { alert(data.error || '删除失败'); }
    })
    .catch(err => alert('删除失败: ' + err.message));
}

var batchPreviewData = null;

function openBatchImport() {
  document.getElementById('batchImportFile').value = '';
  document.getElementById('batchStep1').style.display = 'block';
  document.getElementById('batchStep2').style.display = 'none';
  document.getElementById('batchImportResult').style.display = 'none';
  document.getElementById('batchPreviewBtn').style.display = 'inline-block';
  document.getElementById('batchImportBtn').style.display = 'none';
  batchPreviewData = null;
  document.getElementById('batchImportModal').style.display = 'flex';
}

function closeBatchImport() {
  document.getElementById('batchImportModal').style.display = 'none';
}

function previewBatchFile() {
  var fileInput = document.getElementById('batchImportFile');
  if (!fileInput.files || fileInput.files.length === 0) {
    alert('请选择 Excel 文件');
    return;
  }
  var file = fileInput.files[0];
  var maxSize = 200 * 1024 * 1024; // 200MB
  if (file.size > maxSize) {
    alert('文件大小超过 200MB 限制，请压缩后再上传');
    return;
  }
  var btn = document.getElementById('batchPreviewBtn');
  btn.disabled = true;
  btn.textContent = '解析中...';
  var formData = new FormData();
  formData.append('file', file);
  fetch('/admin/spreadsheets/batch-preview', { method: 'POST', body: formData })
    .then(function(r) {
      if (r.status === 413) {
        throw new Error('文件过大，服务器拒绝接收（413）。如果使用了 Nginx 反向代理，请在 nginx.conf 的 http 或 server 块中添加 client_max_body_size 200m;');
      }
      return r.json();
    })
    .then(function(res) {
      if (res.success) {
        batchPreviewData = res.data;
        document.getElementById('batchFileName').textContent = res.data.filename;
        document.getElementById('batchSheetCount').textContent = res.data.totalSheets;
        var listHtml = '';
        res.data.sheets.forEach(function(sheet, idx) {
          listHtml += '<div style="padding:12px;border-bottom:1px solid #eee;display:flex;gap:12px;align-items:flex-start;">';
          listHtml += '<input type="checkbox" class="sheet-checkbox" data-sheet-name="' + sheet.name.replace(/"/g, '&quot;') + '" checked style="margin-top:3px;">';
          listHtml += '<div style="flex:1;">';
          listHtml += '<div style="font-weight:500;margin-bottom:4px;">' + sheet.name + '</div>';
          listHtml += '<div style="font-size:12px;color:#666;margin-bottom:4px;">' + sheet.columns + ' 列 · ' + sheet.rows + ' 行' + (sheet.headerRow ? '（表头第' + sheet.headerRow + '行）' : '') + '</div>';
          if (sheet.headers && sheet.headers.length > 0) {
            listHtml += '<div style="font-size:12px;color:#999;">表头：' + sheet.headers.slice(0,6).join('、') + (sheet.headers.length > 6 ? '...' : '') + '</div>';
          }
          listHtml += '</div></div>';
        });
        document.getElementById('batchSheetList').innerHTML = listHtml;
        document.getElementById('batchStep1').style.display = 'none';
        document.getElementById('batchStep2').style.display = 'block';
        document.getElementById('batchPreviewBtn').style.display = 'none';
        document.getElementById('batchImportBtn').style.display = 'inline-block';
      } else {
        alert(res.error || '预览失败');
      }
    })
    .catch(function(err) { alert('预览失败: ' + err.message); })
    .finally(function() {
      btn.disabled = false;
      btn.textContent = '🔍 预览工作表';
    });
}

function toggleSelectAllSheets() {
  var checked = document.getElementById('batchSelectAll').checked;
  document.querySelectorAll('.sheet-checkbox').forEach(function(cb) { cb.checked = checked; });
}

function confirmBatchImport() {
  var fileInput = document.getElementById('batchImportFile');
  var selectedSheets = [];
  document.querySelectorAll('.sheet-checkbox:checked').forEach(function(cb) {
    selectedSheets.push(cb.getAttribute('data-sheet-name'));
  });
  if (selectedSheets.length === 0) {
    alert('请至少选择一个工作表');
    return;
  }
  var btn = document.getElementById('batchImportBtn');
  btn.disabled = true;
  btn.textContent = '导入中...';
  var formData = new FormData();
  formData.append('file', fileInput.files[0]);
  formData.append('selectedSheets', JSON.stringify(selectedSheets));
  fetch('/admin/spreadsheets/batch-import', { method: 'POST', body: formData })
    .then(function(r) {
      if (r.status === 413) {
        throw new Error('文件过大，服务器拒绝接收（413）。如果使用了 Nginx 反向代理，请在 nginx.conf 的 http 或 server 块中添加 client_max_body_size 200m;');
      }
      return r.json();
    })
    .then(function(res) {
      if (res.success) {
        var resultDiv = document.getElementById('batchImportResult');
        var listDiv = document.getElementById('batchImportResultList');
        var html = '<p style="margin:0 0 10px 0;color:#28a745;"><strong>导入完成！</strong> 共 ' + res.data.importedSheets + '/' + res.data.totalSheets + ' 个表格</p>';
        html += '<table style="width:100%;border-collapse:collapse;font-size:13px;">';
        html += '<thead><tr style="background:#f5f5f5;"><th style="padding:8px;text-align:left;border:1px solid #ddd;">工作表</th><th style="padding:8px;text-align:left;border:1px solid #ddd;">状态</th><th style="padding:8px;text-align:left;border:1px solid #ddd;">列数</th><th style="padding:8px;text-align:left;border:1px solid #ddd;">行数</th></tr></thead><tbody>';
        res.data.results.forEach(function(r) {
          html += '<tr>';
          html += '<td style="padding:8px;border:1px solid #ddd;">' + (r.name || '-') + '</td>';
          if (r.success) {
            html += '<td style="padding:8px;border:1px solid #ddd;color:#28a745;">✓ 成功</td>';
            html += '<td style="padding:8px;border:1px solid #ddd;">' + r.columns + '</td>';
            html += '<td style="padding:8px;border:1px solid #ddd;">' + r.rows + '</td>';
          } else {
            html += '<td style="padding:8px;border:1px solid #ddd;color:#dc3545;">✗ ' + (r.error || '失败') + '</td>';
            html += '<td style="padding:8px;border:1px solid #ddd;">-</td>';
            html += '<td style="padding:8px;border:1px solid #ddd;">-</td>';
          }
          html += '</tr>';
        });
        html += '</tbody></table>';
        listDiv.innerHTML = html;
        resultDiv.style.display = 'block';
        document.getElementById('batchStep2').style.display = 'none';
        btn.textContent = '关闭并刷新';
        btn.onclick = function() { location.reload(); };
      } else {
        alert(res.error || '导入失败');
        btn.disabled = false;
        btn.textContent = '开始导入选中项';
      }
    })
    .catch(function(err) { alert('导入失败: ' + err.message); })
    .finally(function() {
      if (!btn.onclick) {
        btn.disabled = false;
        btn.textContent = '开始导入选中项';
      }
    });
}
</script>
