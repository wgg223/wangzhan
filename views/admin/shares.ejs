<%# ===== 页面模板：admin/shares.ejs =====%>
<%# 说明：后台-分享管理页：查询全部用户的分享链接，停用/启用/取消分享（EJS 服务端模板，由 Express 渲染） %>
<div class="admin-page">
  <div class="page-header">
    <h1>🔗 分享管理</h1>
    <div class="actions">
      <span class="badge badge-primary"><%= total %> 条分享</span>
    </div>
  </div>

  <!-- 筛选 -->
  <div class="section-card accent-primary">
    <div class="section-body">
      <form method="GET" action="/admin/shares" class="filter-form">
        <div class="filter-row">
          <input type="text" name="keyword" value="<%= filters.keyword %>" placeholder="搜索：链接令牌 / 分享人 / 内容标题" class="form-input" style="flex:2;min-width:220px;">
          <select name="source_type" class="form-input" style="flex:1;">
            <option value="">全部类型</option>
            <option value="image" <%= filters.source_type === 'image' ? 'selected' : '' %>>图片</option>
            <option value="ai_image" <%= filters.source_type === 'ai_image' ? 'selected' : '' %>>AI生图</option>
            <option value="ai_chat" <%= filters.source_type === 'ai_chat' ? 'selected' : '' %>>AI对话</option>
          </select>
          <select name="status" class="form-input" style="flex:1;">
            <option value="">全部状态</option>
            <option value="1" <%= filters.status === '1' ? 'selected' : '' %>>生效中</option>
            <option value="0" <%= filters.status === '0' ? 'selected' : '' %>>已停用</option>
          </select>
          <button type="submit" class="btn btn-primary">🔍 搜索</button>
          <a href="/admin/shares" class="btn">重置</a>
        </div>
      </form>
    </div>
  </div>

  <!-- 列表 -->
  <div class="section-card accent-primary">
    <div class="section-header bg-gradient-primary">
      <h2>全部用户的分享 <span class="badge badge-primary"><%= total %></span></h2>
    </div>
    <div class="section-body" style="padding:0;">
      <div class="table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>类型</th>
              <th>内容</th>
              <th>分享人</th>
              <th>分享链接</th>
              <th>状态</th>
              <th>数据</th>
              <th>创建时间</th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            <% if (shares.length > 0) { %>
              <% shares.forEach(function(s) { %>
                <%
                  var typeName = s.source_type === 'image' ? '图片' : (s.source_type === 'ai_image' ? 'AI生图' : 'AI对话');
                  var typeClass = s.source_type === 'image' ? 'type-image' : (s.source_type === 'ai_image' ? 'type-aiimg' : 'type-aichat');
                  var active = s.status === 1;
                  var creatorName = s.creator_nickname || s.creator_username || '匿名';
                  var shareUrl = '/share/' + s.share_token;
                %>
                <tr>
                  <td><span class="id-mono">#<%= s.id %></span></td>
                  <td><span class="share-type <%= typeClass %>"><%= typeName %></span></td>
                  <td>
                    <div class="share-title-cell">
                      <% if ((s.source_type === 'image' || s.source_type === 'ai_image') && s.source_path) { %>
                        <img src="<%= s.source_path %>" alt="" class="share-thumb" loading="lazy" onerror="this.style.display='none'">
                      <% } %>
                      <span class="share-title-text" title="<%= s.source_title %>"><%= s.source_title || '（内容已删除）' %></span>
                    </div>
                  </td>
                  <td>
                    <div class="creator-cell">
                      <span class="creator-name"><%= creatorName %></span>
                      <% if (s.creator_username && s.creator_username !== creatorName) { %>
                        <span class="creator-username">@<%= s.creator_username %></span>
                      <% } %>
                    </div>
                  </td>
                  <td>
                    <a href="<%= shareUrl %>" target="_blank" rel="noopener" class="share-token-link" title="<%= shareUrl %>">/share/<%= s.share_token %></a>
                  </td>
                  <td>
                    <% if (active) { %>
                      <span class="share-status status-on">● 生效中</span>
                    <% } else { %>
                      <span class="share-status status-off">○ 已停用</span>
                    <% } %>
                  </td>
                  <td>
                    <span class="share-stat">👁 <%= s.view_count %></span>
                    <span class="share-stat">⬇ <%= s.download_count %></span>
                  </td>
                  <td class="share-time"><%= new Date(s.created_at).toLocaleString('zh-CN') %></td>
                  <td class="actions-cell">
                    <div class="action-row">
                      <a href="<%= shareUrl %>" target="_blank" rel="noopener" class="btn btn-small btn-outline">查看</a>
                      <% if (active) { %>
                        <form action="/admin/shares/<%= s.id %>/disable" method="POST" class="inline-form">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="keyword" value="<%= filters.keyword %>">
                          <input type="hidden" name="source_type" value="<%= filters.source_type %>">
                          <input type="hidden" name="status" value="<%= filters.status %>">
                          <input type="hidden" name="page" value="<%= page %>">
                          <button type="submit" class="btn btn-small btn-warning" onclick="return confirm('确定要停用该分享吗？停用后链接将无法访问。')">停用</button>
                        </form>
                      <% } else { %>
                        <form action="/admin/shares/<%= s.id %>/enable" method="POST" class="inline-form">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="keyword" value="<%= filters.keyword %>">
                          <input type="hidden" name="source_type" value="<%= filters.source_type %>">
                          <input type="hidden" name="status" value="<%= filters.status %>">
                          <input type="hidden" name="page" value="<%= page %>">
                          <button type="submit" class="btn btn-small btn-success">启用</button>
                        </form>
                      <% } %>
                      <form action="/admin/shares/<%= s.id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('确定要取消该分享吗？删除后分享链接将永久失效，且无法恢复。')">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="keyword" value="<%= filters.keyword %>">
                        <input type="hidden" name="source_type" value="<%= filters.source_type %>">
                        <input type="hidden" name="status" value="<%= filters.status %>">
                        <input type="hidden" name="page" value="<%= page %>">
                        <button type="submit" class="btn btn-small btn-danger">取消分享</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="9" class="empty-row">暂无分享记录</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <% if (totalPages > 1) { %>
      <div class="pagination-row">
        <% if (page > 1) { %>
          <a href="/admin/shares?page=<%= page - 1 %>&keyword=<%= encodeURIComponent(filters.keyword) %>&source_type=<%= encodeURIComponent(filters.source_type) %>&status=<%= encodeURIComponent(filters.status) %>" class="btn btn-small btn-outline">← 上一页</a>
        <% } %>
        <span class="page-info">第 <%= page %> / <%= totalPages %> 页（共 <%= total %> 条）</span>
        <% if (page < totalPages) { %>
          <a href="/admin/shares?page=<%= page + 1 %>&keyword=<%= encodeURIComponent(filters.keyword) %>&source_type=<%= encodeURIComponent(filters.source_type) %>&status=<%= encodeURIComponent(filters.status) %>" class="btn btn-small btn-outline">下一页 →</a>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
</div>

<style>
.btn-outline {
  background: #fff;
  border: 1px solid var(--gray-300, #d1d5db);
  color: var(--gray-600, #475569);
}
.btn-outline:hover {
  border-color: var(--primary, #6366f1);
  color: var(--primary, #6366f1);
}
.form-input {
  border: 1px solid var(--gray-200, #e2e8f0);
  border-radius: 6px;
  padding: 0 10px;
  height: 36px;
  font-size: 13px;
  background: #fff;
  color: var(--gray-800, #1e293b);
}
.filter-form { display: flex; }
.filter-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; width: 100%; }
.filter-row .form-input { height: 36px; padding: 0 10px; border-radius: 6px; border: 1px solid var(--gray-200); font-size: 13px; }
.table-wrap { overflow-x: auto; }
.id-mono { font-family: var(--font-mono); color: var(--gray-400); font-size: var(--text-sm); }
.share-type {
  display: inline-block;
  padding: 2px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
}
.type-image { background: #ecfdf5; color: #059669; }
.type-aiimg { background: #fef3c7; color: #b45309; }
.type-aichat { background: #ede9fe; color: #6d28d9; }
.share-title-cell { display: flex; align-items: center; gap: 8px; min-width: 170px; }
.share-thumb { width: 36px; height: 36px; object-fit: cover; border-radius: 6px; flex-shrink: 0; }
.share-title-text {
  max-width: 220px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}
.creator-cell { display: flex; flex-direction: column; line-height: 1.3; }
.creator-name { font-weight: 600; white-space: nowrap; }
.creator-username { color: var(--gray-400); font-size: var(--text-xs); white-space: nowrap; }
.share-token-link {
  font-family: var(--font-mono);
  font-size: 12px;
  color: var(--primary);
  text-decoration: none;
  max-width: 160px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: inline-block;
  vertical-align: bottom;
}
.share-token-link:hover { text-decoration: underline; }
.share-status { font-size: 12px; font-weight: 600; white-space: nowrap; }
.status-on { color: #059669; }
.status-off { color: var(--gray-400); }
.share-stat { display: inline-block; font-size: 12px; color: var(--gray-500); margin-right: 6px; white-space: nowrap; }
.share-time { color: var(--gray-400); font-size: 12px; white-space: nowrap; }
.actions-cell .action-row { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
.action-row .btn { margin: 0; white-space: nowrap; }
.pagination-row { display: flex; justify-content: center; align-items: center; gap: 14px; padding: 16px; }
.page-info { font-size: 13px; color: var(--gray-500); }
</style>
