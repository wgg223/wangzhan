<%# ===== 页面模板：admin/spreadsheet-form.ejs =====%>
<%# 说明：后台在线表格创建/编辑表单页 %>
<div class="admin-page-header">
  <h2><%= sheet ? '✏️ 编辑表格' : '➕ 创建表格' %></h2>
  <a href="/admin/spreadsheets" class="btn btn-secondary">← 返回列表</a>
</div>

<div class="admin-card">
  <form id="sheetForm" onsubmit="return submitForm(event)">
    <div class="form-row">
      <div class="form-group">
        <label>表格名称 *</label>
        <input type="text" id="sheetName" value="<%= sheet ? sheet.name : '' %>" placeholder="请输入表格名称" required />
      </div>
      <div class="form-group">
        <label>每页显示行数</label>
        <input type="number" id="sheetPageSize" value="<%= sheet ? sheet.page_size : 20 %>" min="5" max="100" />
      </div>
      <div class="form-group">
        <label>状态</label>
        <select id="sheetStatus">
          <option value="active" <%= sheet && sheet.status === 'active' ? 'selected' : '' %>>正常</option>
          <option value="inactive" <%= sheet && sheet.status === 'inactive' ? 'selected' : '' %>>已停用</option>
        </select>
      </div>
    </div>
    <div class="form-group">
      <label>表格描述</label>
      <textarea id="sheetDesc" rows="3" placeholder="请输入表格描述（可选）"><%= sheet ? sheet.description : '' %></textarea>
    </div>

    <% if (!sheet) { %>
    <div class="form-group">
      <label>初始列配置</label>
      <p class="form-hint">创建后可在"列管理"中进一步调整。默认创建3列：名称、描述、状态。</p>
      <div id="initialColumns">
        <div class="col-config-item">
          <input type="text" class="col-name" value="名称" placeholder="列名" />
          <input type="text" class="col-key" value="name" placeholder="字段标识" />
          <select class="col-type">
            <option value="text">文本</option>
            <option value="number">数字</option>
            <option value="date">日期</option>
          </select>
          <input type="number" class="col-width" value="200" min="50" max="500" />
        </div>
        <div class="col-config-item">
          <input type="text" class="col-name" value="描述" placeholder="列名" />
          <input type="text" class="col-key" value="description" placeholder="字段标识" />
          <select class="col-type">
            <option value="text">文本</option>
            <option value="number">数字</option>
            <option value="date">日期</option>
          </select>
          <input type="number" class="col-width" value="300" min="50" max="500" />
        </div>
        <div class="col-config-item">
          <input type="text" class="col-name" value="状态" placeholder="列名" />
          <input type="text" class="col-key" value="status" placeholder="字段标识" />
          <select class="col-type">
            <option value="text">文本</option>
            <option value="number">数字</option>
            <option value="date">日期</option>
          </select>
          <input type="number" class="col-width" value="100" min="50" max="500" />
        </div>
      </div>
      <button type="button" class="btn btn-outline" onclick="addColConfig()">➕ 添加一列</button>
    </div>
    <% } %>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><%= sheet ? '保存修改' : '创建表格' %></button>
      <a href="/admin/spreadsheets" class="btn btn-secondary">取消</a>
    </div>
  </form>
</div>

<style>
.form-row { display: flex; gap: 16px; flex-wrap: wrap; }
.form-row .form-group { flex: 1; min-width: 150px; }
.form-hint { font-size: 12px; color: #999; margin: 4px 0 8px; }
.col-config-item { display: flex; gap: 8px; margin-bottom: 8px; align-items: center; }
.col-config-item input, .col-config-item select { padding: 6px 10px; border: 1px solid #ddd; border-radius: 4px; font-size: 13px; }
.col-config-item .col-name { flex: 1; }
.col-config-item .col-key { flex: 1; }
.col-config-item .col-width { width: 80px; }
.col-config-item .remove-col { background: #ffebee; color: #c62828; border: none; padding: 6px 10px; border-radius: 4px; cursor: pointer; }
</style>

<script>
function addColConfig() {
  var container = document.getElementById('initialColumns');
  var idx = container.children.length;
  var div = document.createElement('div');
  div.className = 'col-config-item';
  div.innerHTML =
    '<input type="text" class="col-name" placeholder="列名" />' +
    '<input type="text" class="col-key" placeholder="字段标识" />' +
    '<select class="col-type"><option value="text">文本</option><option value="number">数字</option><option value="date">日期</option></select>' +
    '<input type="number" class="col-width" value="150" min="50" max="500" />' +
    '<button type="button" class="remove-col" onclick="this.parentElement.remove()">✕</button>';
  container.appendChild(div);
}

function submitForm(e) {
  e.preventDefault();
  var name = document.getElementById('sheetName').value.trim();
  if (!name) { alert('请输入表格名称'); return false; }

  var data = {
    name: name,
    description: document.getElementById('sheetDesc').value,
    page_size: document.getElementById('sheetPageSize').value,
    status: document.getElementById('sheetStatus').value
  };

  <% if (!sheet) { %>
  var cols = [];
  document.querySelectorAll('#initialColumns .col-config-item').forEach(function(item) {
    var colName = item.querySelector('.col-name').value.trim();
    var colKey = item.querySelector('.col-key').value.trim();
    if (colName && colKey) {
      cols.push({
        name: colName,
        field_key: colKey,
        type: item.querySelector('.col-type').value,
        width: item.querySelector('.col-width').value
      });
    }
  });
  data.columns = cols;
  var url = '/admin/spreadsheets';
  var method = 'POST';
  <% } else { %>
  var url = '/admin/spreadsheets/<%= sheet.id %>';
  var method = 'POST';
  <% } %>

  fetch(url, {
    method: method,
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data)
  })
  .then(r => r.json())
  .then(res => {
    if (res.success) {
      alert('<%= sheet ? "保存成功" : "创建成功" %>');
      window.location.href = '/admin/spreadsheets';
    } else {
      alert(res.error || '操作失败');
    }
  })
  .catch(err => alert('操作失败: ' + err.message));

  return false;
}
</script>
