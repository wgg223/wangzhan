<%# ===== 页面模板：admin/spreadsheet-form.ejs =====%>
<%# 说明：后台在线表格创建/编辑表单页（Univer 模式） %>
<div class="admin-page-header">
  <h2><%= sheet ? '✏️ 编辑表格' : '➕ 创建表格' %></h2>
  <a href="/admin/spreadsheets" class="btn btn-secondary">← 返回列表</a>
</div>

<div class="admin-card">
  <form id="sheetForm" onsubmit="return submitForm(event)">
    <div class="form-row">
      <div class="form-group">
        <label>表格名称 *</label>
        <input type="text" id="sheetName" value="<%= sheet ? sheet.name : '' %>" placeholder="请输入表格名称" required />
      </div>
      <div class="form-group">
        <label>状态</label>
        <select id="sheetStatus">
          <option value="active" <%= sheet && sheet.status === 'active' ? 'selected' : '' %>>正常</option>
          <option value="deleted" <%= sheet && sheet.status === 'deleted' ? 'selected' : '' %>>已停用（软删除）</option>
        </select>
      </div>
      <div class="form-group">
        <label>锁定</label>
        <label style="display:flex;align-items:center;gap:8px;padding-top:6px;font-weight:400;">
          <input type="checkbox" id="sheetLocked" <%= sheet && sheet.is_locked ? 'checked' : '' %>>
          锁定后所有人只能查看，不能编辑
        </label>
      </div>
    </div>
    <div class="form-group">
      <label>表格描述</label>
      <textarea id="sheetDesc" rows="3" placeholder="请输入表格描述（可选）"><%= sheet ? sheet.description : '' %></textarea>
    </div>
    <div class="form-hint">
      创建后点击「打开」进入 Univer 在线表格编辑器，支持协同编辑、批注、图表与版本历史。
      <% if (sheet && typeof sheet.versions === 'number') { %><br>当前统计：v<%= sheet.doc_version %> · 历史版本 <%= sheet.versions %> · 批注 <%= sheet.comments %> · 图表 <%= sheet.charts %> · 授权用户 <%= sheet.perms %><% } %>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary"><%= sheet ? '保存修改' : '创建表格' %></button>
      <a href="/admin/spreadsheets" class="btn btn-secondary">取消</a>
    </div>
  </form>
</div>

<style>
.form-row { display: flex; gap: 16px; flex-wrap: wrap; }
.form-row .form-group { flex: 1; min-width: 200px; }
.form-hint { font-size: 13px; color: #666; margin: 8px 0 16px; padding: 10px 14px; background: #f0f4ff; border-radius: 6px; }
</style>

<script>
function submitForm(e) {
  e.preventDefault();
  var name = document.getElementById('sheetName').value.trim();
  if (!name) { alert('请输入表格名称'); return false; }

  var data = {
    name: name,
    description: document.getElementById('sheetDesc').value,
    status: document.getElementById('sheetStatus').value,
    isLocked: document.getElementById('sheetLocked').checked ? 1 : 0
  };

  var url = <%- JSON.stringify(sheet ? '/admin/spreadsheets/' + sheet.id : '/admin/spreadsheets') %>;
  var method = 'POST';

  fetch(url, {
    method: method,
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data)
  })
  .then(r => r.json())
  .then(res => {
    if (res.success) {
      alert('<%= sheet ? "保存成功" : "创建成功" %>');
      window.location.href = '/admin/spreadsheets';
    } else {
      alert(res.error || '操作失败');
    }
  })
  .catch(err => alert('操作失败: ' + err.message));

  return false;
}
</script>
