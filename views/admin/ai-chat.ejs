  function dwbBatch(path, payload, confirmText) {
    var ids = dwbSelectedIds();
    if (!ids.length) { alert('请先勾选要操作的条目'); return; }
    if (confirmText && !window.confirm(confirmText.replace('{n}', ids.length))) return;
    var fd = new FormData();
    fd.append('ids', ids.join(','));
    if (payload) Object.keys(payload).forEach(function (k) { fd.append(k, payload[k]); });
    csrfFetch(path, { method: 'POST', body: fd }, 30000)
      .then(function (json) {
        if (json.success) location.reload();
        else alert(json.error || '操作失败');
      })
      .catch(function (err) { alert(err.message || '操作失败'); });
  }

