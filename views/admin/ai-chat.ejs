  // ============ 全站角色卡（仅超级管理员） ============
  if (document.getElementById('tab-hub')) {
    window.hubPage = 1;
    var HUB_SOURCE_LABEL = { self: '自建', external: '外部导入', hub: '广场导入', official: '官方' };

    function hubEsc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function hubMsg(text, isErr) {
      var el = document.getElementById('hubMsg');
      el.textContent = text || '';
      el.className = 'ai-chat-msg' + (isErr ? ' err' : '');
    }

    function loadHubStats() {
      csrfFetch('/admin/ai-chat/roles/all/stats', { method: 'GET' }, 20000)
        .then(function (json) {
          if (!json.success) return;
          var d = json.data;
          var chips = ['总计 ' + d.total, '官方 ' + d.official, '已分享 ' + d.shared, '已屏蔽 ' + (d.blocked || 0),
            '含世界书 ' + d.with_book, '累计导入 ' + d.imports, '累计浏览 ' + d.views];
          (d.by_source || []).forEach(function (s) {
            chips.push((HUB_SOURCE_LABEL[s.source_type] || s.source_type) + ' ' + s.count);
          });
          document.getElementById('hubStats').innerHTML = chips.map(function (c) {
            return '<span style="padding:3px 9px;border:1px solid var(--border-color);border-radius:999px;background:var(--bg-card);">' + hubEsc(c) + '</span>';
          }).join('');
        })
        .catch(function () { /* 统计失败不阻塞列表 */ });
    }

    window.loadHubRoles = function (page) {
      page = Math.max(parseInt(page, 10) || 1, 1);
      var qs = new URLSearchParams({
        q: document.getElementById('hubQ').value.trim(),
        user_id: document.getElementById('hubUserId').value.trim(),
        source_type: document.getElementById('hubSource').value,
        shared: document.getElementById('hubShared').value,
        official: document.getElementById('hubOfficial').value,
        blocked: document.getElementById('hubBlocked').value,
        sort: document.getElementById('hubSort').value,
        page: String(page),
        per_page: '25'
      });
      hubMsg('查询中…');
      csrfFetch('/admin/ai-chat/roles/all?' + qs.toString(), { method: 'GET' }, 30000)
        .then(function (json) {
          if (!json.success) throw new Error(json.error || '查询失败');
          var d = json.data;
          window.hubPage = d.page;
          hubMsg('共 ' + d.total + ' 张');
          var body = document.getElementById('hubBody');
          if (!d.items.length) {
            body.innerHTML = '<tr><td colspan="12" style="color:var(--gray-500);">没有匹配的角色卡</td></tr>';
            hubUpdateBatchBar();
          } else {
            body.innerHTML = d.items.map(function (r) {
              var owner = r.user_id ? (hubEsc(r.owner_name || ('#' + r.user_id)) + (r.owner_role ? ' <span style="color:var(--gray-500);">(' + hubEsc(r.owner_role) + ')</span>' : '')) : '<span style="color:var(--gray-500);">系统官方</span>';
              var shared = r.is_shared
                ? '<span style="color:var(--success);">已分享</span>' + (r.share_url ? ' <a href="' + hubEsc(r.share_url) + '" target="_blank" rel="noopener">链接</a>' : '')
                : '<span style="color:var(--gray-500);">未分享</span>';
              var actions = '<button type="button" class="btn btn-sm" onclick="hubDetail(' + r.id + ')">详情</button>';
              if (!r.is_official) actions += ' <button type="button" class="btn btn-sm" onclick="hubPromote(' + r.id + ',1)">设为官方</button>';
              else actions += ' <button type="button" class="btn btn-sm" onclick="hubPromote(' + r.id + ',0)">取消官方</button>';
              actions += ' <button type="button" class="btn btn-sm" onclick="hubBlock(' + r.id + ',' + (r.is_blocked ? 0 : 1) + ')">' + (r.is_blocked ? '解除屏蔽' : '屏蔽') + '</button>';
              if (r.is_shared) actions += ' <button type="button" class="btn btn-sm" onclick="hubUnshare(' + r.id + ')">强制下架</button>';
              actions += ' <button type="button" class="btn btn-sm btn-danger" onclick="hubDelete(' + r.id + ')">删除</button>';
              var blockedCell = r.is_blocked
                ? '<span style="color:var(--danger);" title="' + hubEsc(r.block_reason || '') + '">⛔ 已屏蔽</span>'
                : '<span style="color:var(--gray-500);">—</span>';
              return '<tr>' +
                '<td><input type="checkbox" class="hub-select" value="' + r.id + '" onchange="hubUpdateBatchBar()" style="width:auto;margin:0;"></td>' +
                '<td>' + r.id + '</td>' +
                '<td>' + hubEsc(r.name) + '</td>' +
                '<td>' + owner + '</td>' +
                '<td>' + hubEsc(HUB_SOURCE_LABEL[r.source_type] || r.source_type) + '</td>' +
                '<td>' + hubEsc(r.category || 'default') + '</td>' +
                '<td>' + shared + '</td>' +
                '<td>' + blockedCell + '</td>' +
                '<td>' + (r.has_book ? '📖 ' + (r.world_book_length || 0) + ' 字符' : '—') + '</td>' +
                '<td>' + (r.import_count || 0) + ' / ' + (r.view_count || 0) + '</td>' +
                '<td>' + hubEsc((r.updated_at || r.created_at || '').slice(0, 16)) + '</td>' +
                '<td style="white-space:nowrap;">' + actions + '</td>' +
                '</tr>';
            }).join('');
            hubUpdateBatchBar();
          }
          var pages = Math.max(Math.ceil(d.total / d.per_page), 1);
          document.getElementById('hubPageInfo').textContent = '第 ' + d.page + ' / ' + pages + ' 页';
          document.getElementById('hubPrev').disabled = d.page <= 1;
          document.getElementById('hubNext').disabled = d.page >= pages;
        })
        .catch(function (err) { hubMsg(err.message || '查询失败', true); });
    };

    window.hubDetail = function (id) {
      csrfFetch('/admin/ai-chat/roles/all/detail?id=' + encodeURIComponent(id), { method: 'GET' }, 30000)
        .then(function (json) {
          if (!json.success) throw new Error(json.error || '加载失败');
          var d = json.data;
          document.getElementById('hubDetailTitle').textContent = '角色卡详情 #' + id + '：' + d.name;
          document.getElementById('hubDetailBody').textContent = JSON.stringify(d, null, 2);
          document.getElementById('hubDetailWrap').style.display = 'block';
          document.getElementById('hubDetailWrap').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        })
        .catch(function (err) { hubMsg(err.message || '加载失败', true); });
    };

    window.hubUnshare = function (id) {
      if (!confirm('强制下架该角色卡？分享链接会立即失效（已导入的用户副本不受影响）。')) return;
      var fd = new FormData();
      fd.append('id', id);
      csrfFetch('/admin/ai-chat/roles/all/unshare', { method: 'POST', body: fd }, 20000)
        .then(function (json) {
          hubMsg(json.success ? (json.message || '已下架') : (json.error || '操作失败'), !json.success);
          if (json.success) { loadHubRoles(window.hubPage); loadHubStats(); }
        })
        .catch(function (err) { hubMsg(err.message || '操作失败', true); });
    };

    window.hubPromote = function (id, official) {
      var fd = new FormData();
      fd.append('id', id);
      fd.append('official', official ? '1' : '0');
      csrfFetch('/admin/ai-chat/roles/all/promote', { method: 'POST', body: fd }, 20000)
        .then(function (json) {
          hubMsg(json.success ? '已更新官方标记' : (json.error || '操作失败'), !json.success);
          if (json.success) { loadHubRoles(window.hubPage); loadHubStats(); }
        })
        .catch(function (err) { hubMsg(err.message || '操作失败', true); });
    };

    window.hubBlock = function (id, blocked) {
      var reason = '';
      if (blocked) {
        reason = prompt('屏蔽该角色卡？屏蔽后广场仅上传者本人可见，分享链接同时失效。\n请填写屏蔽原因（可留空，仅后台可见）：', '');
        if (reason === null) return;
      } else if (!confirm('解除该角色卡的屏蔽？解除后作者需重新分享才能上架（原分享链接已失效）。')) return;
      var fd = new FormData();
      fd.append('ids', String(id));
      fd.append('blocked', blocked ? '1' : '0');
      fd.append('reason', reason);
      csrfFetch('/admin/ai-chat/roles/all/batch-block', { method: 'POST', body: fd }, 20000)
        .then(function (json) {
          hubMsg(json.success ? (json.message || '已更新') : (json.error || '操作失败'), !json.success);
          if (json.success) { loadHubRoles(window.hubPage); loadHubStats(); }
        })
        .catch(function (err) { hubMsg(err.message || '操作失败', true); });
    };

    window.hubDelete = function (id) {
      if (!confirm('强制删除该角色卡？所有引用它的会话将解除关联，此操作不可恢复。')) return;
      var fd = new FormData();
      fd.append('id', id);
      csrfFetch('/admin/ai-chat/roles/all/delete', { method: 'POST', body: fd }, 20000)
        .then(function (json) {
          hubMsg(json.success ? '已删除' : (json.error || '删除失败'), !json.success);
          if (json.success) { loadHubRoles(window.hubPage); loadHubStats(); }
        })
        .catch(function (err) { hubMsg(err.message || '删除失败', true); });
    };

    // ---- 批量管理（全站角色卡） ----
    function hubSelectedIds() {
      return Array.prototype.map.call(document.querySelectorAll('#hubBody .hub-select:checked'), function (c) { return c.value; });
    }

    window.hubUpdateBatchBar = function () {
      var ids = hubSelectedIds();
      var bar = document.getElementById('hubBatchBar');
      bar.style.display = ids.length ? '' : 'none';
      document.getElementById('hubBatchCount').textContent = '已选 ' + ids.length + ' 张';
      var all = document.querySelectorAll('#hubBody .hub-select');
      var selAll = document.getElementById('hubSelectAll');
      if (selAll) selAll.checked = all.length > 0 && ids.length === all.length;
    };

    window.hubToggleSelectAll = function (checked) {
      document.querySelectorAll('#hubBody .hub-select').forEach(function (c) { c.checked = checked; });
      hubUpdateBatchBar();
    };

    function hubBatchPost(path, payload, confirmText, okText) {
      var ids = hubSelectedIds();
      if (!ids.length) return;
      if (confirmText && !confirm(confirmText.replace('{n}', ids.length))) return;
      var fd = new FormData();
      fd.append('ids', ids.join(','));
      if (payload) Object.keys(payload).forEach(function (k) { fd.append(k, payload[k]); });
      csrfFetch(path, { method: 'POST', body: fd }, 30000)
        .then(function (json) {
          if (json.success) {
            var d = json.data || {};
            var n = d.updated != null ? d.updated : (d.deleted != null ? d.deleted : (d.changed != null ? d.changed : ids.length));
            var msg = json.message || (okText + ' ' + n + ' 张');
            if (!json.message && d.skipped && d.skipped.length) msg += '，跳过同名：' + d.skipped.join('、');
            hubMsg(msg);
            loadHubRoles(window.hubPage); loadHubStats();
          } else {
            hubMsg(json.error || '操作失败', true);
          }
        })
        .catch(function (err) { hubMsg(err.message || '操作失败', true); });
    }

    window.hubBatchBlock = function (blocked) {
      var reason = '';
      if (blocked) {
        reason = prompt('批量屏蔽选中的角色卡？屏蔽后广场仅上传者本人可见，分享链接同时失效。\n请填写屏蔽原因（可留空，仅后台可见）：', '');
        if (reason === null) return;
      }
      hubBatchPost('/admin/ai-chat/roles/all/batch-block', { blocked: blocked ? '1' : '0', reason: reason },
        blocked ? null : '解除选中的 {n} 张卡的屏蔽？解除后作者需重新分享才能上架。',
        blocked ? '已屏蔽' : '已解除屏蔽');
    };
    window.hubBatchUnshare = function () {
      hubBatchPost('/admin/ai-chat/roles/all/batch-unshare', null, '强制下架选中的 {n} 张角色卡？分享链接会立即失效（已导入的用户副本不受影响）。', '已下架');
    };
    window.hubBatchPromote = function (official) {
      hubBatchPost('/admin/ai-chat/roles/all/batch-promote', { official: official ? '1' : '0' },
        official ? '将选中的 {n} 张设为官方？设官方后对全站可见。' : '取消选中的 {n} 张的官方标记？取消后降为自建、不再对全站可见。',
        official ? '已设为官方' : '已取消官方');
    };
    window.hubBatchDelete = function () {
      hubBatchPost('/admin/ai-chat/roles/all/batch-delete', null, '强制删除选中的 {n} 张角色卡？所有引用会话将解除关联，此操作不可恢复！', '已删除');
    };

    ['hubQ', 'hubUserId'].forEach(function (id) {
      document.getElementById(id).addEventListener('keydown', function (e) {
        if (e.key === 'Enter') loadHubRoles(1);
      });
    });
    loadHubStats();
  }
})();
</script>
