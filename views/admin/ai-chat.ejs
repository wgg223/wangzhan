        var html = '<table class="admin-table" style="max-width:900px;"><thead><tr><th>用户</th><th>角色</th><th>今日已用</th><th>每日限额</th><th>累计已用</th><th>总量限额</th><th>操作</th></tr></thead><tbody>';
        rows.forEach(function (r) {
          html += '<tr data-quota-user="' + r.user_id + '">' +
            '<td>' + (r.nickname || r.username || ('#' + r.user_id)) + '</td>' +
            '<td>' + (r.role || 'user') + '</td>' +
            '<td>' + r.daily_used + '</td>' +
            '<td><input type="number" min="0" value="' + r.daily_limit + '" style="width:80px; padding:4px 6px; border:1px solid var(--border-color); border-radius:6px; background:var(--bg-card);" data-field="daily_limit"></td>' +
