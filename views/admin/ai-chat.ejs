<%# ===== 页面模板：admin/ai-chat.ejs =====%>
<%# 说明：后台-AI聊天管理页：会话记录、额度、开关（EJS 服务端模板，由 Express 渲染，变量与部分逻辑见对应路由） %>
<div class="page-header">
  <h1>🤖 AI聊天管理</h1>
  <p class="text-muted">模型 / 角色 / 设置 / 知识库 / 配额统计</p>
</div>

<style>
  .ai-chat-tabs { display: flex; gap: 8px; margin-bottom: 18px; flex-wrap: wrap; }
  .ai-chat-tabs button { padding: 8px 16px; border: 1px solid var(--border-color); background: var(--bg-card); color: var(--gray-600); border-radius: 8px; cursor: pointer; font-size: 13px; }
  .ai-chat-tabs button.active { background: linear-gradient(135deg, var(--primary, #ec4899), var(--primary-dark, #8b5cf6)); color: #fff; border-color: transparent; }
  .ai-chat-panel { display: none; }
  .ai-chat-panel.active { display: block; }
  .ai-chat-hint { font-size: 12px; color: var(--gray-500); margin: 6px 0 14px; line-height: 1.7; }
  .ai-chat-form { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; max-width: 760px; margin-bottom: 16px; }
  .ai-chat-form .full { grid-column: 1 / -1; }
  .ai-chat-form label { display: block; font-size: 12px; color: var(--gray-600); }
  .ai-chat-form input, .ai-chat-form select, .ai-chat-form textarea { width: 100%; margin-top: 5px; padding: 8px 10px; border: 1px solid var(--border-color); border-radius: 7px; font-size: 13px; background: var(--bg-card); color: inherit; }
  .ai-chat-form textarea { resize: vertical; min-height: 90px; }
  .ai-chat-actions { display: flex; gap: 8px; align-items: center; }
  .ai-chat-msg { font-size: 12px; color: var(--success, #10b981); margin-left: 8px; }
  .ai-chat-msg.err { color: var(--danger, #ef4444); }
  .ai-chat-role-card { border: 1px solid var(--border-color); border-radius: 10px; padding: 12px 14px; margin-bottom: 10px; background: var(--bg-card); }
  .ai-chat-role-card h3 { font-size: 14px; margin-bottom: 4px; }
  .ai-chat-role-card p { font-size: 12px; color: var(--gray-600); white-space: pre-wrap; line-height: 1.6; }
  .ai-chat-role-card .ai-chat-actions { margin-top: 8px; }
  .ai-chat-model-row { border: 1px solid var(--border-color); border-radius: 10px; padding: 10px 14px; margin-bottom: 10px; display: flex; align-items: center; gap: 10px; background: var(--bg-card); }
  .ai-chat-model-row .info { flex: 1; }
  .ai-chat-model-row .info strong { font-size: 13px; }
  .ai-chat-model-row .info span { font-size: 12px; color: var(--gray-500); margin-left: 8px; }
  .badge-key { font-size: 11px; padding: 2px 8px; border-radius: 10px; background: rgba(16, 185, 129, .12); color: var(--success, #10b981); }
  .badge-nokey { font-size: 11px; padding: 2px 8px; border-radius: 10px; background: rgba(239, 68, 68, .1); color: var(--danger, #ef4444); }
  .badge-default { font-size: 11px; padding: 2px 8px; border-radius: 10px; background: rgba(236, 72, 153, .15); color: var(--primary, #ec4899); }
</style>

<div class="ai-chat-tabs">
  <button type="button" class="active" data-tab="models">模型</button>
  <button type="button" data-tab="roles">角色</button>
  <button type="button" data-tab="settings">设置</button>
  <button type="button" data-tab="worldbook">默认世界书</button>
  <button type="button" data-tab="knowledge">知识库</button>
  <button type="button" data-tab="quota">配额统计</button>
  <button type="button" data-tab="presets">生成预设</button>
  <button type="button" data-tab="templates">提示词模板</button>
  <% if (isSuperAdmin) { %><button type="button" data-tab="hub">全站角色卡</button><% } %>
</div>

<!-- ============ 模型 ============ -->
<div class="ai-chat-panel active" id="tab-models">
  <div class="ai-chat-hint">全局模型对所有用户可用（免 Key 的模型无需填写 API Key；用户也可自填自己的模型）。默认模型将作为前台未指定时的首选。</div>
  <div id="modelList">
    <% models.forEach(m => { %>
    <div class="ai-chat-model-row" data-model-id="<%= m.id %>">
      <div class="info">
        <strong><%= m.name %></strong>
        <span><%= m.model_key %></span>
        <span><%= m.provider %></span>
        <% if (m.is_default) { %><span class="badge-default">默认</span><% } %>
        <span style="margin-left:8px;"><%= m.has_key ? '<span class="badge-key">已配置 Key</span>' : '<span class="badge-nokey">未配置 Key</span>' %></span>
      </div>
      <div class="ai-chat-actions">
        <button type="button" class="btn btn-sm" onclick="editModel(<%= m.id %>)">编辑</button>
        <button type="button" class="btn btn-sm" onclick="testModel(<%= m.id %>)">测试</button>
        <button type="button" class="btn btn-sm btn-danger" onclick="deleteModel(<%= m.id %>)">删除</button>
      </div>
    </div>
    <% }) %>
    <% if (!models.length) { %><p class="text-muted" style="font-size:13px;">暂无全局模型</p><% } %>
  </div>
  <div class="ai-chat-hint" style="margin-top:14px;">未配置任何模型时，前台自动使用免费 Pollinations 接口（不稳定，建议尽快配置）。</div>
  <button type="button" class="btn btn-primary" onclick="editModel(0)">＋ 新增模型</button>
</div>

<!-- 模型编辑表单（隐藏） -->
<div id="modelFormWrap" style="display:none; margin-top:16px; padding:16px; border:1px solid var(--border-color); border-radius:10px; background: var(--bg-card);">
  <h3 style="margin-bottom:12px; font-size:15px;" id="modelFormTitle">新增模型</h3>
  <div class="ai-chat-form" id="modelForm">
    <input type="hidden" id="m_id">
    <label>名称<input id="m_name" placeholder="如：DeepSeek V3"></label>
    <label>模型标识 model_key
      <div style="display:flex; gap:8px;">
        <input id="m_model_key" placeholder="如：deepseek-chat" style="flex:1; min-width:0;">
        <button type="button" class="btn btn-sm" onclick="fetchModels()">⟳ 获取模型</button>
      </div>
      <select id="m_fetch_list" style="display:none; margin-top:6px;" onchange="document.getElementById('m_model_key').value=this.value"></select>
      <span id="m_fetch_msg" style="font-size:11px; color:var(--gray-500);"></span>
    </label>
    <label class="full">内置服务商
      <select id="m_provider_preset" onchange="applyAdminProviderPreset()">
        <option value="">自定义</option>
        <% providers.forEach(function(p) { %>
        <option value="<%= p.provider_key %>"><%= p.name %><%= p.requires_key ? '' : '（免费）' %></option>
        <% }) %>
      </select>
    </label>
    <label>服务商标识（OpenAI 兼容）<input id="m_provider" placeholder="如：deepseek / openai / siliconflow"></label>
    <label>API 端点（留空用默认）<input id="m_api_endpoint" placeholder="如：https://api.deepseek.com/v1"></label>
    <label>API Key（留空不修改，新增可不填）<input id="m_api_key" type="password" placeholder="Bearer 密钥"></label>
    <div id="m_get_key_wrap" style="display:none;" class="full">
      <span style="font-size:12px; color:var(--gray-500);">前往获取密钥：</span>
      <a id="m_get_key_link" href="#" target="_blank" rel="noopener" style="font-size:12px;"></a>
    </div>
    <label>max_tokens<input id="m_max_tokens" type="number" value="4096" min="256" max="32768"></label>
    <label>temperature<input id="m_temperature" type="number" value="0.7" step="0.1" min="0" max="2"></label>
    <label class="full" style="display:flex; align-items:center; gap:8px; font-size:13px;">
      <input type="checkbox" id="m_is_default" style="width:auto; margin:0;"> 设为默认模型
      <input type="checkbox" id="m_enabled" style="width:auto; margin:0 0 0 14px;" checked> 启用
    </label>
  </div>
  <div class="ai-chat-actions">
    <button type="button" class="btn btn-primary" onclick="saveModel()">保存</button>
    <button type="button" class="btn" onclick="cancelModelForm()">取消</button>
    <span class="ai-chat-msg" id="modelFormMsg"></span>
  </div>
</div>

<!-- ============ 角色 ============ -->
<div class="ai-chat-panel" id="tab-roles">
  <div class="ai-chat-hint">官方角色对全部用户可见，可在前台一键选用。支持 SillyTavern 角色卡（PNG / JSON）导入导出。</div>
  <div class="ai-chat-actions" style="margin-bottom:10px; flex-wrap:wrap;">
    <input id="roleSearch" placeholder="搜索角色…" oninput="filterRoles()" style="padding:6px 10px;border:1px solid var(--border-color);border-radius:6px;background:var(--bg-card);color:inherit;font-size:13px;">
    <select id="roleCategoryFilter" onchange="filterRoles()" style="padding:6px 8px;border:1px solid var(--border-color);border-radius:6px;background:var(--bg-card);color:inherit;font-size:13px;">
      <option value="">全部分类</option>
      <% roleCategories.forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %>
    </select>
    <button type="button" class="btn" onclick="document.getElementById('roleImportFile').click()">📥 导入 PNG/JSON</button>
    <input type="file" id="roleImportFile" accept=".json,.png" multiple style="display:none;" onchange="importRoles(this.files)">
    <button type="button" class="btn" onclick="location.href='/admin/ai-chat/roles/export'">📦 导出全部 JSON</button>
    <label style="display:inline-flex;align-items:center;gap:6px;font-size:13px;"><input type="checkbox" id="roleSelectAll" onchange="toggleSelectAllRoles(this.checked)" style="width:auto;margin:0;"> 全选</label>
    <span id="roleBatchBar" style="display:none;">
      <button type="button" class="btn" onclick="batchCategoryRoles()">批量改分类</button>
      <button type="button" class="btn" onclick="batchOfficialRoles(1)">批量设为官方</button>
      <button type="button" class="btn" onclick="batchOfficialRoles(0)">批量取消官方</button>
      <button type="button" class="btn btn-danger" onclick="batchDeleteRoles()">批量删除</button>
    </span>
    <button type="button" class="btn btn-primary" onclick="editRole(0)">＋ 新增角色</button>
    <span class="ai-chat-msg" id="roleImportMsg"></span>
  </div>
  <div id="roleList">
    <% roles.forEach(r => { %>
    <div class="ai-chat-role-card" data-role-id="<%= r.id %>" data-category="<%= r.category || 'default' %>" data-name="<%= r.name %>">
      <div style="display:flex;align-items:center;gap:8px;">
        <input type="checkbox" class="role-select" value="<%= r.id %>" onchange="updateBatchBtn()" style="width:auto;margin:0;">
        <% if (r.avatar) { %><img src="<%= r.avatar %>" alt="" style="width:36px;height:36px;border-radius:50%;object-fit:cover;"><% } else { %><span style="font-size:22px;">🎭</span><% } %>
        <h3 style="margin:0;"><%= r.name %> <span style="font-size:12px; color:var(--gray-500);">#<%= r.category || 'default' %></span></h3>
      </div>
      <p><%= r.excerpt %></p>
      <div class="ai-chat-actions" style="flex-wrap:wrap;">
        <button type="button" class="btn btn-sm" title="上移" onclick="moveRole(<%= r.id %>,'up')">▲</button>
        <button type="button" class="btn btn-sm" title="下移" onclick="moveRole(<%= r.id %>,'down')">▼</button>
        <button type="button" class="btn btn-sm" onclick="editRole(<%= r.id %>)">编辑</button>
        <button type="button" class="btn btn-sm" onclick="duplicateRole(<%= r.id %>)">复制</button>
        <button type="button" class="btn btn-sm" onclick="location.href='/admin/ai-chat/roles/export?id=<%= r.id %>'">导出 JSON</button>
        <button type="button" class="btn btn-sm" onclick="location.href='/admin/ai-chat/roles/export-png?id=<%= r.id %>'">导出 PNG</button>
        <button type="button" class="btn btn-sm btn-danger" onclick="deleteRole(<%= r.id %>)">删除</button>
        <span style="font-size:11px;color:var(--gray-500);">
          <% if (r.book_entries) { %>📖 <%= r.book_entries %> 条世界书 · <% } %>
          <% if (r.alternate_count) { %>💬 <%= r.alternate_count %> 条备选开场白 · <% } %>
          <% if (r.creator) { %>作者 <%= r.creator %> · <% } %>
          <% if (r.license) { %><%= r.license %> · <% } %>
          导入 <%= r.import_count %> / 浏览 <%= r.view_count %>
        </span>
      </div>
    </div>
    <% }) %>
    <% if (!roles.length) { %><p class="text-muted" style="font-size:13px;">暂无官方角色，可通过「导入 PNG/JSON」批量导入角色卡。</p><% } %>
  </div>
</div>
<!-- 官方角色卡列表只带摘要；完整正文由 /admin/ai-chat/roles/detail 按需拉取 -->

<!-- 角色编辑表单（隐藏） -->
<div id="roleFormWrap" style="display:none; margin-top:16px; padding:16px; border:1px solid var(--border-color); border-radius:10px; background: var(--bg-card);">
  <h3 style="margin-bottom:12px; font-size:15px;" id="roleFormTitle">新增角色</h3>
  <div class="ai-chat-form" id="roleForm">
    <input type="hidden" id="r_id">
    <label>角色名称<input id="r_name" placeholder="如：冷面侦探"></label>
    <label>分类（自定义标签）<input id="r_category" placeholder="如：rp / writing / default"></label>
    <label class="full">简介<input id="r_description" placeholder="一句话介绍，显示在角色卡片上"></label>
    <label class="full">角色设定（system prompt）<textarea id="r_system_prompt" placeholder="角色身份、性格、说话方式、规则…"></textarea></label>
    <label class="full">开场白（角色对你说的第一句话）<textarea id="r_greeting" placeholder="选择该角色开启新对话时自动发出的第一条 AI 消息，可留空"></textarea></label>
    <label class="full">性格<textarea id="r_personality" placeholder="角色性格特征、口头禅、喜好…（并入角色上下文）"></textarea></label>
    <label class="full">场景<textarea id="r_scenario" placeholder="当前剧情场景、环境设定…（并入角色上下文）"></textarea></label>
    <label class="full">示例对话<textarea id="r_examples" placeholder="展示角色说话风格的对话示例（仅供模仿风格，并入角色上下文）"></textarea></label>
    <label class="full">结尾指令（post_history_instructions）<textarea id="r_post_history_instructions" placeholder="拼接在历史记录之后的指令（SillyTavern 的 jailbreak / author's note 位置）"></textarea></label>
    <label class="full">备选开场白（每行一条，最多 5 条）<textarea id="r_alternate_greetings" placeholder="第一行为主开场白之外的备选，用户建会话时可挑选"></textarea></label>
    <label class="full">世界书（character_book JSON，可留空）<textarea id="r_world_book" placeholder='{"name":"…","description":"…","scan_depth":6,"recursive_scanning":false,"entries":[{"key":["关键词"],"name":"条目名","content":"内容","constant":false,"selective":true,"position":"before_char","depth":4,"probability":100,"enabled":true,"sort_order":0}]}'></textarea></label>
    <label>作者<input id="r_creator" placeholder="原作者署名（导入卡自动填充）"></label>
    <label>卡片版本<input id="r_character_version" placeholder="如 1.0"></label>
    <label>标签（逗号分隔，最多 10 个）<input id="r_tags" placeholder="如：助手,写作,中文"></label>
    <label>许可<input id="r_license" placeholder="如 CC0-1.0 / 未声明（版权归原作者所有）"></label>
    <label class="full">创作者备注<textarea id="r_creator_notes" placeholder="给使用者的说明（会展示在角色卡广场）"></textarea></label>
    <label class="full">头像 URL<input id="r_avatar" placeholder="可留空；支持图片 URL，或点右侧按钮上传" oninput="updateRoleAvatarPreview()"></label>
    <div class="full" style="display:flex;align-items:center;gap:10px;">
      <img id="r_avatar_preview" src="" alt="" style="width:40px;height:40px;border-radius:50%;object-fit:cover;display:none;">
      <button type="button" class="btn btn-sm" onclick="document.getElementById('r_avatar_file').click()">上传头像</button>
      <input type="file" id="r_avatar_file" accept=".png,.jpg,.jpeg,.webp" style="display:none;" onchange="uploadRoleAvatar(this.files[0])">
      <span class="ai-chat-msg" id="r_avatar_msg"></span>
    </div>
  </div>
  <div class="ai-chat-actions">
    <button type="button" class="btn btn-primary" onclick="saveRole()">保存</button>
    <button type="button" class="btn" onclick="cancelRoleForm()">取消</button>
    <span class="ai-chat-msg" id="roleFormMsg"></span>
  </div>
</div>

<!-- ============ 设置 ============ -->
<div class="ai-chat-panel" id="tab-settings">
  <div class="ai-chat-form" style="max-width:760px;">
    <label>功能开关<select id="s_ai_enabled"><option value="1" <%= aiSettings.ai_enabled !== '0' ? 'selected' : '' %>>启用</option><option value="0" <%= aiSettings.ai_enabled === '0' ? 'selected' : '' %>>停用</option></select></label>
    <label>默认模型（model_key，留空自动选择）<input id="s_ai_default_model" value="<%= aiSettings.ai_default_model || '' %>" placeholder="如：deepseek-chat"></label>
    <label>允许用户自填模型/Key<select id="s_ai_allow_user_models"><option value="1" <%= aiSettings.ai_allow_user_models !== '0' ? 'selected' : '' %>>允许</option><option value="0" <%= aiSettings.ai_allow_user_models === '0' ? 'selected' : '' %>>禁止</option></select></label>
    <label>流式输出<select id="s_ai_stream_enabled"><option value="1" <%= aiSettings.ai_stream_enabled !== '0' ? 'selected' : '' %>>启用</option><option value="0" <%= aiSettings.ai_stream_enabled === '0' ? 'selected' : '' %>>关闭（JSON 一次性返回）</option></select></label>
    <label>默认每日限额<input id="s_ai_default_daily_limit" type="number" min="0" value="<%= aiSettings.ai_default_daily_limit || 50 %>"></label>
    <label>默认总量限额<input id="s_ai_default_total_limit" type="number" min="0" value="<%= aiSettings.ai_default_total_limit || 1000 %>"></label>
    <label>摘要记忆（默认开启）<select id="s_ai_memory_enabled"><option value="1" <%= aiSettings.ai_memory_enabled !== '0' ? 'selected' : '' %>>开启</option><option value="0" <%= aiSettings.ai_memory_enabled === '0' ? 'selected' : '' %>>关闭</option></select></label>
    <label>记忆模式<select id="s_ai_memory_mode">
      <option value="summary" <%= aiSettings.ai_memory_mode !== 'vector' && aiSettings.ai_memory_mode !== 'both' && aiSettings.ai_memory_mode !== 'off' ? 'selected' : '' %>>摘要记忆</option>
      <option value="vector" <%= aiSettings.ai_memory_mode === 'vector' ? 'selected' : '' %>>向量记忆</option>
      <option value="both" <%= aiSettings.ai_memory_mode === 'both' ? 'selected' : '' %>>摘要 + 向量</option>
      <option value="off" <%= aiSettings.ai_memory_mode === 'off' ? 'selected' : '' %>>关闭</option>
    </select></label>
    <label>摘要间隔（条）<input id="s_ai_memory_interval" type="number" min="2" value="<%= aiSettings.ai_memory_interval || 10 %>"></label>
    <label>保留最近楼层（原文）<input id="s_ai_memory_keep_recent" type="number" min="1" max="100" value="<%= aiSettings.ai_memory_keep_recent || 10 %>"></label>
    <label>召回最低相似度<input id="s_ai_memory_recall_min_score" type="number" step="0.01" min="0" max="1" value="<%= aiSettings.ai_memory_recall_min_score || 0.48 %>"></label>
    <label>最大召回条数<input id="s_ai_memory_recall_max" type="number" min="1" max="50" value="<%= aiSettings.ai_memory_recall_max || 10 %>"></label>
    <label>二次压缩保留最近轮数<input id="s_ai_memory_group_recent" type="number" min="0" max="500" value="<%= aiSettings.ai_memory_group_recent || 25 %>"></label>
    <label>二次压缩分组大小<input id="s_ai_memory_group_size" type="number" min="1" max="50" value="<%= aiSettings.ai_memory_group_size || 5 %>"></label>
    <label>RAG 知识库问答<select id="s_ai_rag_enabled"><option value="1" <%= aiSettings.ai_rag_enabled === '1' ? 'selected' : '' %>>启用</option><option value="0" <%= aiSettings.ai_rag_enabled !== '1' ? 'selected' : '' %>>关闭</option></select></label>
    <label>RAG 最大召回条数<input id="s_ai_rag_max_results" type="number" min="1" max="20" value="<%= aiSettings.ai_rag_max_results || 5 %>"></label>
    <label>RAG 最低相似度<input id="s_ai_rag_min_score" type="number" step="0.05" min="0" max="1" value="<%= aiSettings.ai_rag_min_score || 0.3 %>"></label>
    <label class="full">嵌入 API 端点（OpenAI 兼容 /embeddings）<input id="s_ai_embedding_api_base" placeholder="如：https://api.openai.com/v1" value="<%= aiSettings.ai_embedding_api_base || '' %>"></label>
    <label class="full">嵌入模型<input id="s_ai_embedding_model" placeholder="如：text-embedding-3-small" value="<%= aiSettings.ai_embedding_model || '' %>"></label>
    <label class="full">嵌入 API Key（留空不修改）<input id="s_ai_embedding_api_key" type="password" placeholder="<%= (aiSettings.ai_embedding_api_key && aiSettings.ai_embedding_api_key.indexOf('ENC:') === 0) ? '已配置（留空保持不变）' : 'Bearer 密钥' %>"></label>

    <div class="full" style="border-top:1px solid var(--border-color); margin:8px 0 4px; padding-top:12px; font-weight:600; font-size:14px;">上下文与生成</div>
    <label>上下文预算（tokens）<input id="s_ai_context_size" type="number" min="2000" max="1000000" step="1000" value="<%= aiSettings.ai_context_size || 16000 %>"></label>
    <label>历史窗口预算（tokens）<input id="s_ai_history_window" type="number" min="500" max="200000" step="500" value="<%= aiSettings.ai_history_window || 3000 %>"></label>
    <label>思维链展示（reasoning）<select id="s_ai_reasoning_enabled"><option value="1" <%= aiSettings.ai_reasoning_enabled !== '0' ? 'selected' : '' %>>开启</option><option value="0" <%= aiSettings.ai_reasoning_enabled === '0' ? 'selected' : '' %>>关闭</option></select></label>
    <label>截断自动续写<select id="s_ai_auto_continue"><option value="1" <%= aiSettings.ai_auto_continue !== '0' ? 'selected' : '' %>>开启</option><option value="0" <%= aiSettings.ai_auto_continue === '0' ? 'selected' : '' %>>关闭</option></select></label>
    <label>自动续写最大次数<input id="s_ai_auto_continue_max" type="number" min="0" max="5" value="<%= aiSettings.ai_auto_continue_max != null ? aiSettings.ai_auto_continue_max : 3 %>"></label>
    <label>预测建议回复<select id="s_ai_predict_enabled"><option value="1" <%= aiSettings.ai_predict_enabled !== '0' ? 'selected' : '' %>>开启（用户可自行开关）</option><option value="0" <%= aiSettings.ai_predict_enabled === '0' ? 'selected' : '' %>>关闭（全站隐藏）</option></select></label>
    <label>预测建议条数<input id="s_ai_predict_count" type="number" min="1" max="5" value="<%= aiSettings.ai_predict_count != null ? aiSettings.ai_predict_count : 3 %>"></label>

    <div class="full" style="border-top:1px solid var(--border-color); margin:8px 0 4px; padding-top:12px; font-weight:600; font-size:14px;">世界书（默认策略，用户会话可覆盖）</div>
    <label>递归扫描<select id="s_ai_world_recursion"><option value="1" <%= aiSettings.ai_world_recursion !== '0' ? 'selected' : '' %>>开启</option><option value="0" <%= aiSettings.ai_world_recursion === '0' ? 'selected' : '' %>>关闭</option></select></label>
    <label>递归最大层数<input id="s_ai_world_recursion_steps" type="number" min="1" max="10" value="<%= aiSettings.ai_world_recursion_steps || 4 %>"></label>
    <label>世界书预算占比 %<input id="s_ai_world_budget_percent" type="number" min="0" max="100" value="<%= aiSettings.ai_world_budget_percent != null ? aiSettings.ai_world_budget_percent : 25 %>"></label>
    <label>扫描深度（最近 N 条）<input id="s_ai_world_scan_depth" type="number" min="1" max="50" value="<%= aiSettings.ai_world_scan_depth || 6 %>"></label>
    <label>自动识别增强<select id="s_ai_world_auto_enhance"><option value="1" <%= aiSettings.ai_world_auto_enhance !== '0' ? 'selected' : '' %>>开启</option><option value="0" <%= aiSettings.ai_world_auto_enhance === '0' ? 'selected' : '' %>>关闭</option></select></label>
    <label>自动补二级触发词<select id="s_ai_world_auto_secondary"><option value="1" <%= aiSettings.ai_world_auto_secondary !== '0' ? 'selected' : '' %>>开启</option><option value="0" <%= aiSettings.ai_world_auto_secondary === '0' ? 'selected' : '' %>>关闭</option></select></label>
    <label>自动识别常驻<select id="s_ai_world_auto_constant"><option value="1" <%= aiSettings.ai_world_auto_constant !== '0' ? 'selected' : '' %>>开启</option><option value="0" <%= aiSettings.ai_world_auto_constant === '0' ? 'selected' : '' %>>关闭</option></select></label>
    <div class="full ai-chat-hint" style="margin-top:2px;">自动识别只在<strong>扫描时叠加</strong>，不会改写用户填写的触发词/二级键/常驻勾选：未勾选「选择性」的条目会从内容里抽专名补成补充触发词（主键或二级键任一命中即注入）；触发词为空、全是「世界观/设定」这类全局标签、或条目名与内容自称全局设定的条目按常驻注入。前台世界书列表与「上下文查看器」会标注哪些条目是自动增强的结果。</div>
  </div>
  <div class="ai-chat-actions">
    <button type="button" class="btn btn-primary" onclick="saveSettings()">保存设置</button>
    <span class="ai-chat-msg" id="settingsMsg"></span>
  </div>
</div>

<!-- ============ 默认世界书 ============ -->
<div class="ai-chat-panel" id="tab-worldbook">
  <div class="ai-chat-hint">默认世界书是全局模板：<strong>用户新建会话时自动复制启用中的条目</strong>到该会话（副本，会话内可自由编辑）；前台世界书弹窗也可手动「从默认模板添加」。触发词留空或勾选常驻 = 始终注入。</div>
  <div class="ai-chat-actions" id="dwbBatchBar" style="display:none;margin-bottom:10px;">
    <span class="ai-chat-hint" id="dwbBatchCount"></span>
    <button type="button" class="btn btn-sm" onclick="dwbBatchEnabled(1)">批量启用</button>
    <button type="button" class="btn btn-sm" onclick="dwbBatchEnabled(0)">批量停用</button>
    <button type="button" class="btn btn-sm" onclick="dwbBatchConstant(1)">批量设为常驻</button>
    <button type="button" class="btn btn-sm" onclick="dwbBatchConstant(0)">批量取消常驻</button>
    <select id="dwbBatchPosition" style="max-width:190px;">
      <option value="">批量改位置…</option>
      <option value="system_top">system_top（系统顶层）</option>
      <option value="before_char">before_char（角色前）</option>
      <option value="after_char">after_char（角色后）</option>
      <option value="user_top">user_top（用户消息前）</option>
      <option value="assistant_top">assistant_top（助手回复前）</option>
      <option value="in_chat">in_chat（按深度插入）</option>
    </select>
    <button type="button" class="btn btn-sm" onclick="dwbBatchPosition()">应用位置</button>
    <button type="button" class="btn btn-sm btn-danger" onclick="dwbBatchDelete()">批量删除</button>
  </div>
  <table class="admin-table" style="max-width:900px;">
    <thead><tr><th style="width:32px;"><input type="checkbox" id="dwbSelectAll" onchange="dwbToggleSelectAll(this.checked)" style="width:auto;margin:0;"></th><th>ID</th><th>触发词</th><th>内容</th><th>位置</th><th>常驻</th><th>状态</th><th>操作</th></tr></thead>
    <tbody>
      <% defaultWorldBook.forEach(w => { %>
      <tr data-dwb-id="<%= w.id %>" data-dwb="<%= JSON.stringify(w) %>">
        <td><input type="checkbox" class="dwb-select" value="<%= w.id %>" onchange="dwbUpdateBatchBar()" style="width:auto;margin:0;"></td>
        <td><%= w.id %></td>
        <td style="max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= w.key || '（常驻）' %></td>
        <td style="max-width:300px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= w.content %></td>
        <td><%= w.position %><%= w.position === 'in_chat' ? ('@' + (w.depth == null ? 4 : w.depth)) : '' %></td>
        <td><%= w.constant ? '是' : '否' %></td>
        <td><%= w.enabled ? '启用' : '停用' %></td>
        <td>
          <button type="button" class="btn btn-sm" onclick="editDefaultWorldBook(<%= w.id %>)">编辑</button>
          <button type="button" class="btn btn-sm" onclick="toggleDefaultWorldBook(<%= w.id %>, <%= w.enabled %>)"><%= w.enabled ? '停用' : '启用' %></button>
          <button type="button" class="btn btn-sm btn-danger" onclick="deleteDefaultWorldBook(<%= w.id %>)">删除</button>
        </td>
      </tr>
      <% }) %>
      <% if (!defaultWorldBook.length) { %><tr><td colspan="8" class="text-muted">暂无默认世界书条目</td></tr><% } %>
    </tbody>
  </table>
  <button type="button" class="btn btn-primary" onclick="editDefaultWorldBook(0)" style="margin-top:8px;">＋ 新增条目</button>
  <button type="button" class="btn" onclick="document.getElementById('dwbImportFile').click()" style="margin-top:8px;">📥 导入世界书</button>
  <input type="file" id="dwbImportFile" accept=".json,.md,.markdown" multiple style="display:none;" onchange="importDefaultWorldBook(this.files)">
  <span class="ai-chat-msg" id="dwbImportMsg" style="margin-left:10px;"></span>
  <div id="dwbFormWrap" style="display:none; margin-top:16px; padding:16px; border:1px solid var(--border-color); border-radius:10px; background: var(--bg-card);">
    <h3 style="margin-bottom:12px; font-size:15px;" id="dwbFormTitle">新增默认世界书条目</h3>
    <div class="ai-chat-form" id="dwbForm">
      <input type="hidden" id="dwb_id">
      <label>触发词（多个用逗号分隔，留空=常驻注入）<input id="dwb_key" placeholder="如：雨夜, 城市"></label>
      <label class="full">内容<textarea id="dwb_content" rows="4" placeholder="注入给 AI 的设定内容…"></textarea></label>
      <label>注入位置
        <select id="dwb_position" onchange="dwbPosChanged()">
          <option value="system_top">system_top（系统顶层）</option>
          <option value="before_char">before_char（角色前）</option>
          <option value="after_char">after_char（角色后）</option>
          <option value="user_top">user_top（用户消息前）</option>
          <option value="assistant_top">assistant_top（助手回复前）</option>
          <option value="in_chat">in_chat（按深度插入历史）</option>
        </select>
      </label>
      <label id="dwb_depth_wrap" style="display:none;">插入深度（倒数第 N 条前）<input id="dwb_depth" type="number" value="4" min="0" max="200"></label>
      <label>触发概率 %<input id="dwb_probability" type="number" value="100" min="0" max="100"></label>
      <label>排序<input id="dwb_sort_order" type="number" value="0" min="0"></label>
      <label>二级触发词（选择性，需同时命中）<input id="dwb_secondary_keys" placeholder="逗号分隔，可留空"></label>
      <label><input type="checkbox" id="dwb_selective" style="width:auto; margin-right:6px;">选择性（需二级键命中）</label>
      <label><input type="checkbox" id="dwb_constant" style="width:auto; margin-right:6px;">常驻注入（忽略触发词）</label>
      <label><input type="checkbox" id="dwb_enabled" style="width:auto; margin-right:6px;" checked>启用</label>
    </div>
    <div style="margin-top:12px; display:flex; gap:10px; align-items:center;">
      <button type="button" class="btn btn-primary" onclick="saveDefaultWorldBook()">保存</button>
      <button type="button" class="btn btn-sm" onclick="document.getElementById('dwbFormWrap').style.display='none'">取消</button>
      <span class="ai-chat-msg" id="dwbMsg"></span>
    </div>
  </div>
</div>

<!-- ============ 知识库 ============ -->
<div class="ai-chat-panel" id="tab-knowledge">
  <div class="ai-chat-hint">上传 .txt / .md 文档（≤2MB），自动分块并嵌入（需配置嵌入模型；未配置则只存文本不嵌入，问答不会命中）。</div>
  <form id="kbForm" style="display:flex; gap:10px; align-items:flex-end; max-width:640px; margin-bottom:16px;">
    <label style="flex:1; font-size:12px; color:var(--gray-600);">文档标题<input name="title" id="kbTitle" placeholder="留空用文件名" style="width:100%; margin-top:5px; padding:8px 10px; border:1px solid var(--border-color); border-radius:7px; font-size:13px; background:var(--bg-card);"></label>
    <label style="flex:1; font-size:12px; color:var(--gray-600);">文件<input type="file" name="file" id="kbFile" accept=".txt,.md" required style="width:100%; margin-top:5px; padding:6px; border:1px solid var(--border-color); border-radius:7px; font-size:13px; background:var(--bg-card);"></label>
    <button type="submit" class="btn btn-primary">上传</button>
  </form>
  <table class="admin-table" style="max-width:900px;">
    <thead><tr><th>ID</th><th>标题</th><th>分块</th><th>创建时间</th><th>操作</th></tr></thead>
    <tbody>
      <% docs.forEach(d => { %>
      <tr data-kb-id="<%= d.id %>">
        <td><%= d.id %></td>
        <td style="max-width:240px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= d.title %></td>
        <td><%= d.chunk_count %></td>
        <td><%= d.created_at %></td>
        <td>
          <button type="button" class="btn btn-sm" onclick="reembedDoc(<%= d.id %>)">重新嵌入</button>
          <button type="button" class="btn btn-sm btn-danger" onclick="deleteDoc(<%= d.id %>)">删除</button>
        </td>
      </tr>
      <% }) %>
      <% if (!docs.length) { %><tr><td colspan="5" class="text-muted">暂无知识库文档</td></tr><% } %>
    </tbody>
  </table>
  <span class="ai-chat-msg" id="kbMsg"></span>
</div>

<!-- ============ 配额统计 ============ -->
<div class="ai-chat-panel" id="tab-quota">
  <div class="ai-chat-hint">管理员 / super_admin 不受配额限制。今日剩余 = daily_limit − daily_used（跨天自动重置）。</div>
  <div id="quotaWrap"></div>
</div>

<!-- ============ 生成预设 ============ -->
<div class="ai-chat-panel" id="tab-presets">
  <div class="ai-chat-hint">全局生成预设对所有用户可见。用户可在前台「生成」面板中加载预设，也可保存自己的私有预设。</div>
  <div id="presetList">
    <% presets.forEach(p => { %>
    <div class="ai-chat-role-card" data-preset-id="<%= p.id %>">
      <h3><%= p.name %> <% if (p.is_default) { %><span class="badge-default">默认</span><% } %></h3>
      <p>Temp <%= p.temperature %> · Top P <%= p.top_p %> · Top K <%= p.top_k %> · Freq <%= p.frequency_penalty %> · Pres <%= p.presence_penalty %> · Max <%= p.max_tokens %></p>
      <div class="ai-chat-actions">
        <button type="button" class="btn btn-sm" onclick="editPreset(<%= p.id %>)">编辑</button>
        <button type="button" class="btn btn-sm btn-danger" onclick="deletePreset(<%= p.id %>)">删除</button>
      </div>
    </div>
    <% }) %>
    <% if (!presets.length) { %><p class="text-muted" style="font-size:13px;">暂无全局预设</p><% } %>
  </div>
  <button type="button" class="btn btn-primary" onclick="editPreset(0)" style="margin-top:10px;">＋ 新增预设</button>
  <div id="presetFormWrap" style="display:none; margin-top:16px; padding:16px; border:1px solid var(--border-color); border-radius:10px; background:var(--bg-card);">
    <h3 style="margin-bottom:12px; font-size:15px;" id="presetFormTitle">新增预设</h3>
    <div class="ai-chat-form">
      <input type="hidden" id="p_id">
      <label>名称<input id="p_name" placeholder="如：创意写作"></label>
      <label>Temperature<input id="p_temperature" type="number" step="0.05" min="0" max="2" value="0.7"></label>
      <label>Top P<input id="p_top_p" type="number" step="0.05" min="0" max="1" value="1"></label>
      <label>Top K<input id="p_top_k" type="number" step="1" min="0" max="100" value="0"></label>
      <label>Freq Penalty<input id="p_frequency_penalty" type="number" step="0.1" min="-2" max="2" value="0"></label>
      <label>Pres Penalty<input id="p_presence_penalty" type="number" step="0.1" min="-2" max="2" value="0"></label>
      <label>Max Tokens<input id="p_max_tokens" type="number" step="256" min="256" max="32768" value="4096"></label>
      <label style="display:flex;align-items:center;gap:8px;"><input type="checkbox" id="p_is_default" style="width:auto;"> 设为默认</label>
    </div>
    <div class="ai-chat-actions">
      <button type="button" class="btn btn-primary" onclick="savePreset()">保存</button>
      <button type="button" class="btn" onclick="document.getElementById('presetFormWrap').style.display='none'">取消</button>
      <span class="ai-chat-msg" id="presetMsg"></span>
    </div>
  </div>
</div>

<!-- ============ 提示词模板 ============ -->
<div class="ai-chat-panel" id="tab-templates">
  <div class="ai-chat-hint">全局提示词模板对所有用户可见。支持变量：{{char}}、{{user}}、{{scenario}}、{{personality}}。用户也可创建私有模板。</div>
  <div id="templateList">
    <% promptTemplates.forEach(t => { %>
    <div class="ai-chat-role-card" data-template-id="<%= t.id %>">
      <h3><%= t.name %></h3>
      <p><%= (t.content || '').slice(0, 200) %></p>
      <div class="ai-chat-actions">
        <button type="button" class="btn btn-sm" onclick="editTemplate(<%= t.id %>)">编辑</button>
        <button type="button" class="btn btn-sm btn-danger" onclick="deleteTemplate(<%= t.id %>)">删除</button>
      </div>
    </div>
    <% }) %>
    <% if (!promptTemplates.length) { %><p class="text-muted" style="font-size:13px;">暂无全局模板</p><% } %>
  </div>
  <button type="button" class="btn btn-primary" onclick="editTemplate(0)" style="margin-top:10px;">＋ 新增模板</button>
  <div id="templateFormWrap" style="display:none; margin-top:16px; padding:16px; border:1px solid var(--border-color); border-radius:10px; background:var(--bg-card);">
    <h3 style="margin-bottom:12px; font-size:15px;" id="templateFormTitle">新增模板</h3>
    <div class="ai-chat-form">
      <input type="hidden" id="t_id">
      <label class="full">名称<input id="t_name" placeholder="如：角色扮演标准模板"></label>
      <label class="full">内容<textarea id="t_content" rows="8" placeholder="{{char}} 是一个...&#10;{{user}} 是...&#10;场景：{{scenario}}"></textarea></label>
      <label class="full">描述（可选）<input id="t_description" placeholder="简短说明模板用途"></label>
    </div>
    <div class="ai-chat-actions">
      <button type="button" class="btn btn-primary" onclick="saveTemplate()">保存</button>
      <button type="button" class="btn" onclick="document.getElementById('templateFormWrap').style.display='none'">取消</button>
      <span class="ai-chat-msg" id="templateMsg"></span>
    </div>
  </div>
</div>

<% if (isSuperAdmin) { %>
<!-- ============ 全站角色卡（仅超级管理员） ============ -->
<div class="ai-chat-panel" id="tab-hub">
  <div class="ai-chat-hint">
    查询全站所有用户的角色卡：自建（self）、外部导入（external）、广场导入（hub）、官方（official）。
    广场导入的卡在服务层就禁止导出与二次分享，防止站内内容外溢。治理动作（屏蔽 / 强制下架 / 提升官方 / 强制删除）均写入审计日志。
    <strong>屏蔽</strong>后该卡在广场仅上传者本人可见，分享链接同时失效；<strong>下架</strong>只取消公开分享，作者仍可自行重新分享。
  </div>
  <div id="hubStats" style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;font-size:12px;color:var(--gray-500);"></div>
  <div class="ai-chat-actions" style="margin-bottom:10px;flex-wrap:wrap;">
    <input id="hubQ" placeholder="搜索卡名/简介/作者/标签/用户名…" style="padding:6px 10px;border:1px solid var(--border-color);border-radius:6px;background:var(--bg-card);color:inherit;font-size:13px;min-width:240px;">
    <input id="hubUserId" placeholder="按用户 ID 过滤" style="padding:6px 10px;border:1px solid var(--border-color);border-radius:6px;background:var(--bg-card);color:inherit;font-size:13px;width:130px;">
    <select id="hubSource" style="padding:6px 8px;border:1px solid var(--border-color);border-radius:6px;background:var(--bg-card);color:inherit;font-size:13px;">
      <option value="">全部来源</option>
      <option value="self">自建 self</option>
      <option value="external">外部导入 external</option>
      <option value="hub">广场导入 hub</option>
      <option value="official">官方 official</option>
    </select>
    <select id="hubShared" style="padding:6px 8px;border:1px solid var(--border-color);border-radius:6px;background:var(--bg-card);color:inherit;font-size:13px;">
      <option value="">分享状态（全部）</option>
      <option value="1">已分享到广场</option>
      <option value="0">未分享</option>
    </select>
    <select id="hubOfficial" style="padding:6px 8px;border:1px solid var(--border-color);border-radius:6px;background:var(--bg-card);color:inherit;font-size:13px;">
      <option value="">官方标记（全部）</option>
      <option value="1">官方卡</option>
      <option value="0">用户卡</option>
    </select>
    <select id="hubBlocked" style="padding:6px 8px;border:1px solid var(--border-color);border-radius:6px;background:var(--bg-card);color:inherit;font-size:13px;">
      <option value="">屏蔽状态（全部）</option>
      <option value="1">已屏蔽</option>
      <option value="0">未屏蔽</option>
    </select>
    <select id="hubSort" style="padding:6px 8px;border:1px solid var(--border-color);border-radius:6px;background:var(--bg-card);color:inherit;font-size:13px;">
      <option value="updated">最近更新</option>
      <option value="new">最新创建</option>
      <option value="hot">最热（导入数）</option>
      <option value="name">名称</option>
      <option value="owner">按用户</option>
    </select>
    <button type="button" class="btn btn-primary" onclick="loadHubRoles(1)">查询</button>
    <span class="ai-chat-msg" id="hubMsg"></span>
  </div>
  <div class="ai-chat-actions" id="hubBatchBar" style="display:none;margin-bottom:10px;">
    <span style="font-size:13px;color:var(--gray-500);" id="hubBatchCount"></span>
    <button type="button" class="btn btn-sm" onclick="hubBatchBlock(1)">批量屏蔽</button>
    <button type="button" class="btn btn-sm" onclick="hubBatchBlock(0)">批量解除屏蔽</button>
    <button type="button" class="btn btn-sm" onclick="hubBatchUnshare()">批量强制下架</button>
    <button type="button" class="btn btn-sm" onclick="hubBatchPromote(1)">批量设为官方</button>
    <button type="button" class="btn btn-sm" onclick="hubBatchPromote(0)">批量取消官方</button>
    <button type="button" class="btn btn-sm btn-danger" onclick="hubBatchDelete()">批量删除</button>
  </div>
  <div style="overflow-x:auto;">
    <table class="admin-table" id="hubTable" style="width:100%;font-size:12px;">
      <thead>
        <tr>
          <th style="width:32px;"><input type="checkbox" id="hubSelectAll" onchange="hubToggleSelectAll(this.checked)" style="width:auto;margin:0;"></th>
          <th>ID</th><th>名称</th><th>作者/归属</th><th>来源</th><th>分类</th>
          <th>分享</th><th>屏蔽</th><th>世界书</th><th>导入/浏览</th><th>更新时间</th><th>操作</th>
        </tr>
      </thead>
      <tbody id="hubBody"><tr><td colspan="12" style="color:var(--gray-500);">点击「查询」加载全站角色卡</td></tr></tbody>
    </table>
  </div>
  <div class="ai-chat-actions" style="margin-top:10px;">
    <button type="button" class="btn btn-sm" id="hubPrev" onclick="loadHubRoles(hubPage-1)">上一页</button>
    <span id="hubPageInfo" style="font-size:12px;color:var(--gray-500);"></span>
    <button type="button" class="btn btn-sm" id="hubNext" onclick="loadHubRoles(hubPage+1)">下一页</button>
  </div>
  <div id="hubDetailWrap" style="display:none;margin-top:16px;padding:16px;border:1px solid var(--border-color);border-radius:10px;background:var(--bg-card);">
    <h3 style="margin-bottom:10px;font-size:15px;" id="hubDetailTitle">角色卡详情</h3>
    <pre id="hubDetailBody" style="max-height:420px;overflow:auto;white-space:pre-wrap;word-break:break-word;font-size:12px;background:var(--bg-secondary);padding:10px;border-radius:8px;"></pre>
    <div class="ai-chat-actions">
      <button type="button" class="btn btn-sm" onclick="document.getElementById('hubDetailWrap').style.display='none'">关闭</button>
    </div>
  </div>
</div>
<% } %>

<script>
(function () {
  var tabs = document.querySelectorAll('.ai-chat-tabs button');
  tabs.forEach(function (btn) {
    btn.addEventListener('click', function () {
      tabs.forEach(function (b) { b.classList.remove('active'); });
      document.querySelectorAll('.ai-chat-panel').forEach(function (p) { p.classList.remove('active'); });
      btn.classList.add('active');
      document.getElementById('tab-' + btn.getAttribute('data-tab')).classList.add('active');
      if (btn.getAttribute('data-tab') === 'quota') loadQuota();
    });
  });

  // 内置服务商数据（与前端一致）
  var adminProviders = <%- JSON.stringify(providers) %>;

  // 选择内置服务商 → 自动带出端点/默认模型/获取密钥链接
  window.applyAdminProviderPreset = function () {
    var key = document.getElementById('m_provider_preset').value;
    var providerInput = document.getElementById('m_provider');
    var endpointInput = document.getElementById('m_api_endpoint');
    var getWrap = document.getElementById('m_get_key_wrap');
    var getLink = document.getElementById('m_get_key_link');
    if (!key) {
      providerInput.value = '';
      endpointInput.value = '';
      getWrap.style.display = 'none';
      return;
    }
    var p = adminProviders.filter(function (x) { return x.provider_key === key; })[0];
    if (!p) return;
    providerInput.value = p.provider_key;
    endpointInput.value = p.api_base || '';
    if (p.api_key_url) {
      getLink.href = p.api_key_url;
      getLink.textContent = p.name + ' 获取密钥 →';
      getWrap.style.display = '';
    } else {
      getWrap.style.display = 'none';
    }
  };

  // ============ 模型 ============
  window.editModel = function (id) {
    var wrap = document.getElementById('modelFormWrap');
    wrap.style.display = 'block';
    wrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    document.getElementById('modelFormMsg').textContent = '';
    var presetSel = document.getElementById('m_provider_preset');
    var getWrap = document.getElementById('m_get_key_wrap');
    if (!id) {
      document.getElementById('modelFormTitle').textContent = '新增模型';
      ['m_id', 'm_name', 'm_model_key', 'm_provider', 'm_api_endpoint', 'm_api_key'].forEach(function (f) { document.getElementById(f).value = ''; });
      presetSel.value = '';
      getWrap.style.display = 'none';
      document.getElementById('m_max_tokens').value = 4096;
      document.getElementById('m_temperature').value = 0.7;
      document.getElementById('m_is_default').checked = false;
      document.getElementById('m_enabled').checked = true;
      return;
    }
    var row = document.querySelector('.ai-chat-model-row[data-model-id="' + id + '"]');
    if (!row) return;
    document.getElementById('modelFormTitle').textContent = '编辑模型 #' + id;
    document.getElementById('m_id').value = id;
    var strong = row.querySelector('strong').textContent;
    var spans = row.querySelectorAll('.info span');
    document.getElementById('m_name').value = strong;
    document.getElementById('m_model_key').value = spans[0] ? spans[0].textContent : '';
    var providerVal = spans[1] ? spans[1].textContent : '';
    document.getElementById('m_provider').value = providerVal;
    // 尝试匹配内置服务商下拉
    var matched = adminProviders.filter(function (p) { return p.provider_key === providerVal; })[0];
    presetSel.value = matched ? matched.provider_key : '';
    if (matched && matched.api_key_url) {
      document.getElementById('m_get_key_link').href = matched.api_key_url;
      document.getElementById('m_get_key_link').textContent = matched.name + ' 获取密钥 →';
      getWrap.style.display = '';
    } else {
      getWrap.style.display = 'none';
    }
    document.getElementById('m_api_endpoint').value = '';
    document.getElementById('m_api_key').value = '';
    document.getElementById('m_max_tokens').value = 4096;
    document.getElementById('m_temperature').value = 0.7;
    document.getElementById('m_is_default').checked = !!row.querySelector('.badge-default');
    document.getElementById('m_enabled').checked = true;
  };

  window.cancelModelForm = function () { document.getElementById('modelFormWrap').style.display = 'none'; };

  // 自动获取模型列表（按端点 + Key 调 OpenAI 兼容 /models）
  window.fetchModels = function () {
    var endpoint = document.getElementById('m_api_endpoint').value.trim();
    var key = document.getElementById('m_api_key').value.trim();
    var msg = document.getElementById('m_fetch_msg');
    var sel = document.getElementById('m_fetch_list');
    if (!endpoint && !key) { msg.textContent = '请先填写 API 端点与 API Key'; return; }
    msg.textContent = '获取中…';
    sel.style.display = 'none';
    sel.innerHTML = '';
    csrfFetch('/admin/ai-chat/api/models/fetch', {
      method: 'POST',
      body: JSON.stringify({ api_endpoint: endpoint, api_key: key })
    }, 35000)
      .then(function (json) {
        if (!json.success) { msg.textContent = json.error || '获取失败'; return; }
        var list = json.data || [];
        if (!list.length) { msg.textContent = '未获取到模型'; return; }
        list.forEach(function (md) {
          var opt = document.createElement('option');
          opt.value = md.id;
          opt.textContent = md.id + (md.owned_by ? '（' + md.owned_by + '）' : '');
          sel.appendChild(opt);
        });
        sel.style.display = 'block';
        msg.textContent = '共 ' + list.length + ' 个模型，选择后自动填入 model_key';
      })
      .catch(function (err) { msg.textContent = (err && err.message) || '获取失败'; });
  };

  window.saveModel = function () {
    var msg = document.getElementById('modelFormMsg');
    msg.textContent = '';
    // modelForm 是 div 而非 form，不能直接 new FormData(div)
    var fd = new FormData();
    [['id', 'm_id'], ['name', 'm_name'], ['model_key', 'm_model_key'], ['provider', 'm_provider'],
      ['api_endpoint', 'm_api_endpoint'], ['api_key', 'm_api_key'], ['max_tokens', 'm_max_tokens'],
      ['temperature', 'm_temperature']].forEach(function (p) {
      fd.append(p[0], document.getElementById(p[1]).value);
    });
    fd.append('is_default', document.getElementById('m_is_default').checked ? '1' : '0');
    fd.append('enabled', document.getElementById('m_enabled').checked ? '1' : '0');
    csrfFetch('/admin/ai-chat/models/save', {
      method: 'POST',
      body: fd
    }, 30000).then(function (json) {
      if (json.success) { msg.textContent = '保存成功'; setTimeout(function () { location.reload(); }, 600); }
      else { msg.textContent = json.error || '保存失败'; msg.className = 'ai-chat-msg err'; }
    }).catch(function () { msg.textContent = '保存失败，请重试'; msg.className = 'ai-chat-msg err'; });
  };

  window.testModel = function (id) {
    var btn = event.target;
    btn.disabled = true;
    btn.textContent = '测试中…';
    var fd = new FormData();
    fd.append('id', id);
    csrfFetch('/admin/ai-chat/models/test', { method: 'POST', body: fd }, 35000)
      .then(function (json) { alert(json.success ? ('连接成功：' + (json.data.reply || '')) : (json.error || '测试失败')); })
      .catch(function (err) { alert(err.message || '测试失败'); })
      .then(function () { btn.disabled = false; btn.textContent = '测试'; });
  };

  window.deleteModel = function (id) {
    if (!window.confirm('确定删除该模型？')) return;
    var fd = new FormData();
    fd.append('id', id);
    csrfFetch('/admin/ai-chat/models/delete', { method: 'POST', body: fd }, 20000)
      .then(function (json) {
        if (json.success) { var row = document.querySelector('.ai-chat-model-row[data-model-id="' + id + '"]'); if (row) row.remove(); }
        else alert(json.error || '删除失败');
      })
      .catch(function (err) { alert(err.message || '删除失败'); });
  };

  // ============ 角色 ============
  // 官方卡可能上百张，页面只带摘要；编辑时按需向 /admin/ai-chat/roles/detail 拉全文

  window.filterRoles = function () {
    var kw = (document.getElementById('roleSearch').value || '').toLowerCase();
    var cat = document.getElementById('roleCategoryFilter').value;
    document.querySelectorAll('#roleList .ai-chat-role-card').forEach(function (card) {
      var name = (card.getAttribute('data-name') || '').toLowerCase();
      var c = card.getAttribute('data-category') || '';
      card.style.display = (!kw || name.indexOf(kw) !== -1) && (!cat || c === cat) ? '' : 'none';
    });
  };

  window.updateBatchBtn = function () {
    var n = document.querySelectorAll('#roleList .role-select:checked').length;
    document.getElementById('roleBatchBar').style.display = n ? '' : 'none';
    var all = document.querySelectorAll('#roleList .role-select');
    var selAll = document.getElementById('roleSelectAll');
    if (selAll) selAll.checked = all.length > 0 && n === all.length;
  };

  window.toggleSelectAllRoles = function (checked) {
    document.querySelectorAll('#roleList .role-select').forEach(function (c) {
      // 仅勾选当前可见（未被搜索/分类筛选隐藏）的卡片
      var card = c.closest('.ai-chat-role-card');
      if (card && card.style.display === 'none') { c.checked = false; return; }
      c.checked = checked;
    });
    updateBatchBtn();
  };

  function selectedRoleIds() {
    return Array.prototype.map.call(document.querySelectorAll('#roleList .role-select:checked'), function (c) { return c.value; });
  }

  window.batchCategoryRoles = function () {
    var ids = selectedRoleIds();
    if (!ids.length) return;
    var cat = window.prompt('将选中的 ' + ids.length + ' 个角色归入分类（留空为 default）：', '');
    if (cat === null) return;
    csrfFetch('/admin/ai-chat/roles/batch-category', { method: 'POST', body: JSON.stringify({ ids: ids, category: cat }) }, 20000)
      .then(function (json) {
        if (json.success) location.reload();
        else alert(json.error || '操作失败');
      })
      .catch(function (err) { alert(err.message || '操作失败'); });
  };

  window.batchOfficialRoles = function (official) {
    var ids = selectedRoleIds();
    if (!ids.length) return;
    var tip = official ? '设为官方后对所有用户可见，确定将选中的 ' + ids.length + ' 个角色设为官方？' : '取消官方后这些角色将降为自建、不再对全站可见，确定取消选中的 ' + ids.length + ' 个？';
    if (!window.confirm(tip)) return;
    csrfFetch('/admin/ai-chat/roles/batch-official', { method: 'POST', body: JSON.stringify({ ids: ids, official: official }) }, 20000)
      .then(function (json) {
        if (json.success) {
          var d = json.data || {};
          if (d.skipped && d.skipped.length) alert('已更新 ' + d.updated + ' 个，跳过同名：' + d.skipped.join('、'));
          location.reload();
        } else alert(json.error || '操作失败');
      })
      .catch(function (err) { alert(err.message || '操作失败'); });
  };

  window.importRoles = function (files) {
    if (!files || !files.length) return;
    var msg = document.getElementById('roleImportMsg');
    msg.className = 'ai-chat-msg';
    msg.textContent = '导入中…';
    var fd = new FormData();
    Array.prototype.forEach.call(files, function (f) { fd.append('files', f); });
    csrfFetch('/admin/ai-chat/roles/import', { method: 'POST', body: fd }, 60000)
      .then(function (json) {
        document.getElementById('roleImportFile').value = '';
        if (json.success) {
          var d = json.data;
          msg.textContent = '导入 ' + d.imported + ' 个，跳过 ' + d.skipped + ' 个' + (d.errors && d.errors.length ? '。' + d.errors.join('；') : '');
          if (d.imported) setTimeout(function () { location.reload(); }, 1500);
        } else { msg.textContent = json.error || '导入失败'; msg.className = 'ai-chat-msg err'; }
      })
      .catch(function (err) { msg.textContent = err.message || '导入失败'; msg.className = 'ai-chat-msg err'; });
  };

  window.batchDeleteRoles = function () {
    var ids = selectedRoleIds();
    if (!ids.length) return;
    if (!window.confirm('确定删除选中的 ' + ids.length + ' 个角色？')) return;
    csrfFetch('/admin/ai-chat/roles/batch-delete', { method: 'POST', body: JSON.stringify({ ids: ids }) }, 20000)
      .then(function (json) {
        if (json.success) location.reload();
        else alert(json.error || '删除失败');
      })
      .catch(function (err) { alert(err.message || '删除失败'); });
  };

  window.duplicateRole = function (id) {
    var fd = new FormData();
    fd.append('id', id);
    csrfFetch('/admin/ai-chat/roles/duplicate', { method: 'POST', body: fd }, 20000)
      .then(function (json) {
        if (json.success) location.reload();
        else alert(json.error || '复制失败');
      })
      .catch(function (err) { alert(err.message || '复制失败'); });
  };

  window.moveRole = function (id, dir) {
    var fd = new FormData();
    fd.append('id', id);
    fd.append('dir', dir);
    csrfFetch('/admin/ai-chat/roles/move', { method: 'POST', body: fd }, 20000)
      .then(function (json) {
        if (json.success) location.reload();
        else alert(json.error || '移动失败');
      })
      .catch(function (err) { alert(err.message || '移动失败'); });
  };

  window.updateRoleAvatarPreview = function () {
    var url = (document.getElementById('r_avatar').value || '').trim();
    var img = document.getElementById('r_avatar_preview');
    if (url) { img.src = url; img.style.display = ''; }
    else { img.style.display = 'none'; }
  };

  window.uploadRoleAvatar = function (file) {
    if (!file) return;
    var msg = document.getElementById('r_avatar_msg');
    msg.className = 'ai-chat-msg';
    msg.textContent = '上传中…';
    var fd = new FormData();
    fd.append('file', file);
    csrfFetch('/admin/ai-chat/roles/avatar', { method: 'POST', body: fd }, 30000)
      .then(function (json) {
        document.getElementById('r_avatar_file').value = '';
        if (json.success) {
          document.getElementById('r_avatar').value = json.data.url;
          updateRoleAvatarPreview();
          msg.textContent = '上传成功';
        } else { msg.textContent = json.error || '上传失败'; msg.className = 'ai-chat-msg err'; }
      })
      .catch(function (err) { msg.textContent = err.message || '上传失败'; msg.className = 'ai-chat-msg err'; });
  };

  var ROLE_FIELDS = ['r_id', 'r_name', 'r_category', 'r_description', 'r_system_prompt', 'r_post_history_instructions',
    'r_greeting', 'r_alternate_greetings', 'r_personality', 'r_scenario', 'r_examples', 'r_world_book',
    'r_creator', 'r_character_version', 'r_tags', 'r_license', 'r_creator_notes', 'r_avatar'];

  function fillRoleForm(role) {
    role = role || {};
    document.getElementById('r_id').value = role.id || '';
    document.getElementById('r_name').value = role.name || '';
    document.getElementById('r_category').value = role.category || '';
    document.getElementById('r_description').value = role.description || '';
    document.getElementById('r_system_prompt').value = role.system_prompt || '';
    document.getElementById('r_post_history_instructions').value = role.post_history_instructions || '';
    document.getElementById('r_greeting').value = role.greeting || '';
    document.getElementById('r_alternate_greetings').value = (role.alternate_greetings || []).join('\n');
    document.getElementById('r_personality').value = role.personality || '';
    document.getElementById('r_scenario').value = role.scenario || '';
    document.getElementById('r_examples').value = role.examples || '';
    document.getElementById('r_world_book').value = role.world_book ? JSON.stringify(role.world_book, null, 2) : '';
    document.getElementById('r_creator').value = role.creator || '';
    document.getElementById('r_character_version').value = role.character_version || '';
    document.getElementById('r_tags').value = (role.tags || []).join(',');
    document.getElementById('r_license').value = role.license || '';
    document.getElementById('r_creator_notes').value = role.creator_notes || '';
    document.getElementById('r_avatar').value = role.avatar || '';
    updateRoleAvatarPreview();
  }

  window.editRole = function (id) {
    var wrap = document.getElementById('roleFormWrap');
    var msg = document.getElementById('roleFormMsg');
    wrap.style.display = 'block';
    wrap.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    msg.textContent = '';
    msg.className = 'ai-chat-msg';
    if (!id) {
      document.getElementById('roleFormTitle').textContent = '新增角色';
      fillRoleForm(null);
      return;
    }
    document.getElementById('roleFormTitle').textContent = '编辑角色 #' + id + '（加载中…）';
    // 完整正文按需拉取：官方卡可能上百张，页面只带摘要
    csrfFetch('/admin/ai-chat/roles/detail?id=' + encodeURIComponent(id), { method: 'GET' }, 20000)
      .then(function (json) {
        if (!json.success) throw new Error(json.error || '加载失败');
        document.getElementById('roleFormTitle').textContent = '编辑角色 #' + id;
        fillRoleForm(json.data);
      })
      .catch(function (err) {
        document.getElementById('roleFormTitle').textContent = '编辑角色 #' + id;
        msg.textContent = err.message || '加载失败';
        msg.className = 'ai-chat-msg err';
      });
  };

  window.cancelRoleForm = function () { document.getElementById('roleFormWrap').style.display = 'none'; };

  window.saveRole = function () {
    var msg = document.getElementById('roleFormMsg');
    msg.textContent = '';
    msg.className = 'ai-chat-msg';
    // 世界书 JSON 先在前端校验，避免把非法 JSON 送到后端再报错
    var bookRaw = document.getElementById('r_world_book').value.trim();
    if (bookRaw) {
      try { JSON.parse(bookRaw); } catch (e) {
        msg.textContent = '世界书不是合法 JSON：' + e.message;
        msg.className = 'ai-chat-msg err';
        return;
      }
    }
    // roleForm 是 div 而非 form，不能直接 new FormData(div)
    var fd = new FormData();
    ['id', 'name', 'category', 'description', 'system_prompt', 'post_history_instructions',
      'greeting', 'personality', 'scenario', 'examples', 'creator', 'character_version',
      'license', 'creator_notes', 'avatar'].forEach(function (f) {
      fd.append(f, document.getElementById('r_' + f).value);
    });
    fd.append('alternate_greetings', JSON.stringify(document.getElementById('r_alternate_greetings').value
      .split('\n').map(function (s) { return s.trim(); }).filter(Boolean)));
    fd.append('tags', JSON.stringify(document.getElementById('r_tags').value
      .split(/[,，]/).map(function (s) { return s.trim(); }).filter(Boolean)));
    if (bookRaw) fd.append('world_book', bookRaw);
    csrfFetch('/admin/ai-chat/roles/save', { method: 'POST', body: fd }, 20000)
      .then(function (json) {
        if (json.success) { msg.textContent = '保存成功'; setTimeout(function () { location.reload(); }, 600); }
        else { msg.textContent = json.error || '保存失败'; msg.className = 'ai-chat-msg err'; }
      })
      .catch(function () { msg.textContent = '保存失败，请重试'; msg.className = 'ai-chat-msg err'; });
  };

  window.deleteRole = function (id) {
    if (!window.confirm('确定删除该角色？')) return;
    var fd = new FormData();
    fd.append('id', id);
    csrfFetch('/admin/ai-chat/roles/delete', { method: 'POST', body: fd }, 20000)
      .then(function (json) {
        if (json.success) { var card = document.querySelector('.ai-chat-role-card[data-role-id="' + id + '"]'); if (card) card.remove(); }
        else alert(json.error || '删除失败');
      })
      .catch(function (err) { alert(err.message || '删除失败'); });
  };

  // ============ 设置 ============
  window.saveSettings = function () {
    var msg = document.getElementById('settingsMsg');
    msg.textContent = '';
    var form = new FormData();
    ['s_ai_enabled', 's_ai_default_model', 's_ai_allow_user_models', 's_ai_stream_enabled',
      's_ai_default_daily_limit', 's_ai_default_total_limit', 's_ai_memory_enabled', 's_ai_memory_mode',
      's_ai_memory_interval', 's_ai_memory_keep_recent', 's_ai_memory_recall_min_score', 's_ai_memory_recall_max',
      's_ai_memory_group_recent', 's_ai_memory_group_size', 's_ai_rag_enabled', 's_ai_rag_max_results', 's_ai_rag_min_score',
      's_ai_embedding_api_base', 's_ai_embedding_model', 's_ai_embedding_api_key',
      's_ai_context_size', 's_ai_history_window', 's_ai_reasoning_enabled', 's_ai_auto_continue', 's_ai_auto_continue_max',
      's_ai_world_recursion', 's_ai_world_recursion_steps', 's_ai_world_budget_percent', 's_ai_world_scan_depth',
      's_ai_world_auto_enhance', 's_ai_world_auto_secondary', 's_ai_world_auto_constant',
      's_ai_predict_enabled', 's_ai_predict_count'].forEach(function (id) {
      // 服务端读取不带 s_ 前缀的字段名，此处剥离前缀以对齐（历史遗留：此前未剥离导致保存被忽略）
