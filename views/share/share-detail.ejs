<%# ===== 页面模板：share/share-detail.ejs =====%>
<%# 说明：分享-详情页（EJS 服务端模板，由 Express 渲染，变量与部分逻辑见对应路由） %>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= state === 'ok' ? (title || '图片分享') : '内容不可用' %></title>
  <meta name="robots" content="noindex, nofollow">
  <% if (state === 'ok') { %>
    <meta property="og:title" content="<%= title || '图片分享' %>">
    <meta property="og:description" content="<%= (description || '').slice(0, 200) %>">
    <meta property="og:image" content="<%= absoluteImageUrl %>">
    <meta property="og:type" content="image">
  <% } %>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f5f7fa; color: #333; min-height: 100vh; }
    .wrap { max-width: 640px; margin: 0 auto; padding: 20px 16px 40px; }
    .card { background: #fff; border-radius: 12px; box-shadow: 0 2px 10px rgba(0,0,0,.06); overflow: hidden; margin-bottom: 16px; }
    .img-box { background: #111; text-align: center; }
    .img-box img { max-width: 100%; max-height: 70vh; display: block; margin: 0 auto; }
    .info { padding: 16px 18px; }
    .info h1 { font-size: 17px; margin-bottom: 8px; word-break: break-all; }
    .desc { font-size: 13px; color: #666; line-height: 1.7; word-break: break-word; white-space: pre-wrap; margin-bottom: 10px; }
    .meta { font-size: 12px; color: #999; }
    .meta span { margin-right: 14px; }
    .actions { padding: 0 18px 18px; display: flex; gap: 10px; }
    .btn { flex: 1; display: inline-block; padding: 11px 0; border-radius: 8px; text-align: center; text-decoration: none; font-size: 15px; border: none; cursor: pointer; }
    .btn-primary { background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; }
    .btn-ghost { background: #f1f3f5; color: #555; }
    .tip { font-size: 12px; color: #aaa; text-align: center; margin-top: 10px; }
    .gone { padding: 60px 20px; text-align: center; }
    .gone i { font-size: 46px; color: #ccc; display: block; margin-bottom: 14px; }
    .gone h2 { font-size: 18px; color: #666; margin-bottom: 8px; }
    .gone p { font-size: 13px; color: #999; }
    .footer { text-align: center; color: #aaa; font-size: 12px; padding: 12px 0; }
  </style>
</head>
<body>
  <div class="wrap">
    <% if (state === 'ok') { %>
      <div class="card">
        <div class="img-box">
          <img src="<%= imageUrl %>" alt="<%= title %>">
        </div>
        <div class="info">
          <h1><%= title %></h1>
          <% if (description) { %><div class="desc"><%= description %></div><% } %>
          <div class="meta">
            <span>👤 <%= ownerName %></span>
            <span>👁 <%= share.view_count %> 次查看</span>
            <span>⬇ <%= share.download_count %> 次下载</span>
          </div>
        </div>
        <div class="actions">
          <% if (user) { %>
            <a class="btn btn-primary" href="<%= downloadUrl %>">⬇ 下载图片</a>
          <% } else { %>
            <a class="btn btn-primary" href="/auth/frontend/login?returnTo=<%= encodeURIComponent(pageUrl) %>">登录后下载</a>
          <% } %>
        </div>
        <div class="tip">分享自 <%= baseUrl %></div>
      </div>
    <% } else { %>
      <div class="card">
        <div class="gone">
          <i>🔒</i>
          <h2>内容已下架或链接失效</h2>
          <p>该分享链接不存在、已被停用，或内容未通过审核</p>
        </div>
      </div>
    <% } %>
    <div class="footer">图片分享</div>
  </div>
</body>
</html>
