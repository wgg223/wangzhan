<%# ===== 页面模板：share/share-document.ejs =====%>
<%# 说明：分享-在线文档只读页（公开，无需登录）。数据来自 /share/:token/page-view —— 服务端用 renderDocFlow
        把文档排成 HTML 片段，前端只负责分页展示，不下发可编辑快照、不加载 Univer 编辑器包；
        查看者可用的能力仅「字号 / 页宽 / 大纲」，无编辑、无页面设置、无导出。embed=true 时为 iframe 嵌入视图 %>
<%
  // 时间格式化（模板内联 helper）
  function fmtTime(t) {
    if (!t) return '-';
    var d = new Date(t);
    if (isNaN(d.getTime())) return String(t);
    var p = function (n) { return (n < 10 ? '0' : '') + n; };
    return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
  }
  // iframe 嵌入代码（仅普通页展示）
  var embedCode = '<iframe src="' + (baseUrl || '') + (embedUrl || '') + '" width="100%" height="640" frameborder="0" style="border:1px solid #e0e4ea;border-radius:12px;" loading="lazy" allowfullscreen></iframe>';
%>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= state === 'ok' ? (title || '在线文档分享') : '内容不可用' %></title>
  <meta name="robots" content="noindex, nofollow">
  <% if (state === 'ok' && !embed) { %>
    <meta property="og:title" content="<%= title || '在线文档分享' %>">
    <meta property="og:description" content="<%= sheet.description ? String(sheet.description).slice(0, 100) : '一份在线文档分享' %>">
    <meta property="og:type" content="website">
  <% } %>
  <link rel="stylesheet" href="/css/doc-layout.css">
  <% if (state === 'ok') { %>
  <link rel="stylesheet" href="/css/ss-content-protect.css">
  <% } %>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif; background: #fdf5f9; color: #43303e; min-height: 100vh; }
    body.embed { background: #fff; overflow: hidden; }

    /* ---- 嵌入视图：仅阅读区 ---- */
    body.embed .reader-only { position: fixed; inset: 0; }
    body.embed #shareLoading, body.embed #shareError {
      position: absolute; inset: 0; display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 10px; background: #fff; z-index: 30;
    }

    /* ---- 普通视图 ---- */
    .wrap { max-width: 1080px; margin: 0 auto; padding: 20px 16px 40px; }
    .card { background: #fff; border-radius: 12px; box-shadow: 0 2px 10px rgba(0,0,0,.06); overflow: hidden; margin-bottom: 16px; }
    .head-card { padding: 18px 20px; }
    .head-card h1 { font-size: 18px; word-break: break-all; }
    .head-card .meta { font-size: 12px; color: #999; margin-top: 8px; }
    .head-card .meta span { margin-right: 16px; }
    .head-card .desc { font-size: 13px; color: #666; line-height: 1.7; margin-top: 10px; word-break: break-all; }
    .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
    .btn { display: inline-block; border: 1px solid #e0e4ea; background: #fff; color: #333; font-size: 13px; padding: 7px 14px; border-radius: 8px; cursor: pointer; transition: background .15s, border-color .15s; }
    .btn:hover { background: #f3f6fa; border-color: #c8d0dc; }
    .badge-readonly { display: inline-block; background: #eef2ff; color: #4338ca; border-radius: 999px; padding: 3px 10px; font-size: 12px; font-weight: 600; vertical-align: 2px; }

    /* 只读阅读器：固定高度 + 内部滚动，避免出现任何编辑控件 */
    .doc-card { position: relative; }
    .reader-host { position: relative; height: 78vh; min-height: 460px; background: #e8eaed; display: flex; flex-direction: column; }
    .reader-host .dl-bar { flex: 0 0 auto; border-bottom: 1px solid #e2e5ea; }
    .reader-host .dl-body { flex: 1 1 auto; min-height: 0; }
    .reader-host select { padding: 4px 8px; border: 1px solid #d7dbe3; border-radius: 6px; font-size: 13px; background: #fff; color: #333; font-family: inherit; }
    .reader-host label { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: #374151; }
    .sheet-loading, .sheet-error { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; background: rgba(250, 251, 253, .95); z-index: 5; }
    .sheet-error p { font-size: 13px; color: #b91c1c; }
    .spin { width: 28px; height: 28px; border: 3px solid #dbe3ee; border-top-color: #2563eb; border-radius: 50%; animation: spin .8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    [hidden] { display: none !important; }

    .embed-card { padding: 14px 20px; }
    .embed-card h3 { font-size: 14px; margin-bottom: 8px; }
    .embed-card textarea { width: 100%; height: 64px; font-size: 12px; font-family: Consolas, Monaco, monospace; color: #666; border: 1px solid #e0e4ea; border-radius: 8px; padding: 8px 10px; resize: none; background: #fafbfc; }
    .tip { font-size: 12px; color: #aaa; text-align: center; margin-top: 4px; }
    .footer { text-align: center; color: #aaa; font-size: 12px; padding: 12px 0; }

    @media (max-width: 720px) {
      .reader-host { height: 68vh; min-height: 380px; }
      .reader-host .dl-body { top: 76px; }
      .reader-host .dl-side { display: none; }
    }
  </style>
</head>
<body class="<%= embed ? 'embed' : 'page' %>">
  <% if (state === 'ok') { %>
    <% if (!embed) { %>
    <div class="wrap">
      <div class="card head-card">
        <h1><%= sheet.name || '在线文档' %> <span class="badge-readonly">🔒 只读</span></h1>
        <div class="meta">
          <span>👤 <%= ownerName %></span>
          <% if (stats) { %>
          <span>🔖 v<%= stats.version || 0 %></span>
          <span>🕘 更新于 <%= fmtTime(stats.updatedAt) %></span>
          <span>👁 <%= stats.viewCount || 0 %> 次查看</span>
          <% } %>
        </div>
        <% if (sheet.description) { %><p class="desc"><%= sheet.description %></p><% } %>
        <div class="actions">
          <button type="button" class="btn" id="btnShareCopy">🔗 复制链接</button>
        </div>
      </div>

      <div class="card doc-card">
        <div class="reader-host" id="readerHost">
          <div class="sheet-loading" id="shareLoading">
            <div class="spin"></div>
            <p style="font-size:13px;color:#888;">正在加载文档…</p>
          </div>
          <div class="sheet-error" id="shareError" hidden>
            <p>⚠️ 文档加载失败</p>
            <p id="shareErrorMsg">请稍后刷新重试</p>
          </div>
        </div>
        <div class="tip" style="padding:10px 14px;text-align:left;color:#8a94a6;">
          只读分享：可调节字号与页宽、用大纲跳转；不含编辑、页面设置、打印与下载。
        </div>
      </div>

      <div class="card embed-card">
        <h3>嵌入到网页</h3>
        <textarea id="shareEmbedCode" readonly spellcheck="false" data-ss-copy-ok><%= embedCode %></textarea>
      </div>
      <div class="tip">分享自 <%= baseUrl %> · 只读分享（不支持下载），如需编辑请向作者申请权限</div>
    </div>
    <% } else { %>
    <div class="reader-host reader-only" id="readerHost">
      <div id="shareLoading">
        <div class="spin"></div>
        <p style="font-size:13px;color:#888;">正在加载文档…</p>
      </div>
      <div id="shareError" hidden>
        <p style="font-size:13px;color:#b91c1c;">⚠️ 文档加载失败</p>
      </div>
    </div>
    <% } %>

    <script>
      // 分享页配置（后端注入）
      window.__SHARE__ = {
        viewUrl: <%- JSON.stringify('/share/' + (share.share_token) + '/page-view').replace(/</g, '\\u003c') %>,
        embed: <%= embed ? 'true' : 'false' %>
      };
      // 只读分享内容保护配置（防复制 + 访客 IP 水印溯源）
      window.__SS_PROTECT__ = {
        watermark: <%- JSON.stringify('只读分享' + (typeof clientIp !== 'undefined' && clientIp ? ' · ' + clientIp : '')).replace(/</g, '\\u003c') %>,
        tip: '只读分享内容受保护，禁止复制或截图'
      };
    </script>
    <script src="/js/ss-content-protect.js" defer></script>
    <script src="/js/doc-layout.js"></script>
    <script>
      // 只读文档查看器：服务端已排好版，这里只挂阅读视图并暴露字号 / 页宽 / 大纲三个查看项
      (function () {
        /* global DocLayout */
        var CFG = window.__SHARE__ || {};
        var host = document.getElementById('readerHost');
        var mask = document.getElementById('shareLoading');
        var errBox = document.getElementById('shareError');
        var errMsg = document.getElementById('shareErrorMsg');

        var FONT_SIZES = [14, 15, 16, 17, 19, 21, 24];
        var PAGE_WIDTHS = [{ v: 680, label: '窄栏' }, { v: 780, label: '标准' }, { v: 960, label: '宽栏' }, { v: 0, label: '自适应' }];

        var state = { instance: null, data: null, fontSize: 17, pageWidth: 780, outline: false };

        function fail(msg) {
          if (mask) mask.hidden = true;
          if (errBox) errBox.hidden = false;
          if (errMsg && msg) errMsg.textContent = msg;
        }

        function options(list, current) {
          return list.map(function (it) {
            var v = typeof it === 'object' ? it.v : it;
            var label = typeof it === 'object' ? it.label : it + 'px';
            return '<option value="' + v + '"' + (String(v) === String(current) ? ' selected' : '') + '>' + label + '</option>';
          }).join('');
        }

        /** 阅读工具栏：仅查看类控件（嵌入视图不显示） */
        function buildBar() {
          if (CFG.embed) return null;
          var bar = document.createElement('div');
          bar.className = 'dl-bar';
          bar.innerHTML = ''
            + '<label>字号<select id="drFont">' + options(FONT_SIZES, state.fontSize) + '</select></label>'
            + '<label>页宽<select id="drWidth">' + options(PAGE_WIDTHS, state.pageWidth) + '</select></label>'
            + '<button type="button" class="btn" id="drOutline">🧭 大纲：关</button>'
            + '<span class="dl-bar-info" id="drInfo"></span>';
          host.insertBefore(bar, host.firstChild);
          bar.querySelector('#drFont').addEventListener('change', function () {
            state.fontSize = parseFloat(this.value) || 17;
            if (state.instance) state.instance.setFontSize(state.fontSize);
          });
          bar.querySelector('#drWidth').addEventListener('change', function () {
            state.pageWidth = parseFloat(this.value) || 0;
            if (state.instance) state.instance.setPageWidth(state.pageWidth);
          });
          bar.querySelector('#drOutline').addEventListener('click', function () {
            state.outline = !state.outline;
            this.textContent = '🧭 大纲：' + (state.outline ? '开' : '关');
            var side = document.getElementById('drSide');
            // 显式写 block：窄屏样式里 .dl-side 默认 display:none，空串盖不住它
            if (side) side.style.display = state.outline ? 'block' : 'none';
          });
          return bar;
        }

        function buildBody() {
          var body = document.createElement('div');
          body.className = 'dl-body';
          if (CFG.embed) body.style.position = 'static';
          var side = document.createElement('aside');
          side.className = 'dl-side';
          side.id = 'drSide';
          side.style.display = 'none';
          side.innerHTML = '<div class="dl-side-head">大纲导航</div><div class="dl-outline" id="drOutlineBox"></div>';
          var viewer = document.createElement('div');
          viewer.className = 'dl-viewer';
          viewer.id = 'drViewer';
          body.appendChild(side);
          body.appendChild(viewer);
          host.appendChild(body);
          return viewer;
        }

        function renderOutline(toc) {
          var box = document.getElementById('drOutlineBox');
          if (!box) return;
          box.textContent = '';
          if (!toc.length) {
            var hint = document.createElement('div');
            hint.className = 'dl-outline-empty';
            hint.textContent = '这份文档还没有设置标题，无法生成大纲。';
            box.appendChild(hint);
            return;
          }
          toc.forEach(function (item) {
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'dl-ol-item dl-ol-lv' + Math.max(1, Math.min(6, item.level || 1));
            btn.dataset.anchor = item.anchor;
            btn.textContent = item.text || '（空标题）';
            btn.title = item.text || '';
            btn.addEventListener('click', function () {
              if (state.instance) state.instance.goTo(this.dataset.anchor);
            });
            box.appendChild(btn);
          });
        }

        function highlightOutline(anchor) {
          var box = document.getElementById('drOutlineBox');
          if (!box) return;
          var items = box.querySelectorAll('.dl-ol-item');
          for (var i = 0; i < items.length; i++) {
            items[i].classList.toggle('is-active', Boolean(anchor) && items[i].dataset.anchor === anchor);
          }
        }

        function mount(data) {
          var viewer = buildBody();
          state.instance = DocLayout.mountReading(viewer, data, {
            fontSize: state.fontSize,
            pageWidth: state.pageWidth,
            onActiveAnchor: highlightOutline,
            onReady: function (count, warnings) {
              var info = document.getElementById('drInfo');
              if (info) {
                info.textContent = '正文 ' + count + ' 段 · ' + ((data.toc || []).length) + ' 个标题'
                  + (warnings && warnings.length ? ' · ' + warnings.join('；') : '');
              }
              if (mask) mask.hidden = true;
            }
          });
          renderOutline(data.toc || []);
        }

        function load() {
          if (typeof DocLayout === 'undefined' || !DocLayout.mountReading) {
            fail('阅读组件加载失败，请刷新页面');
            return;
          }
          buildBar();
          fetch(CFG.viewUrl).then(function (r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.json();
          }).then(function (json) {
            if (!json || !json.success || !json.data || !json.data.sections) {
              throw new Error((json && json.error) || '文档数据为空');
            }
            state.data = json.data;
            mount(json.data);
          }).catch(function (e) {
            fail(e.message || '文档加载失败，请刷新重试');
          });
        }

        // 复制链接（分享页仅在线只读查看，不提供下载）
        var btnCopy = document.getElementById('btnShareCopy');
        var embedCode = document.getElementById('shareEmbedCode');
        if (btnCopy) btnCopy.addEventListener('click', function () {
          var text = location.origin + <%- JSON.stringify(pageUrl) %>;
          function ok() {
            btnCopy.textContent = '✅ 已复制';
            setTimeout(function () { btnCopy.textContent = '🔗 复制链接'; }, 1600);
          }
          function fallback() {
            var ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); ok(); } catch (e) { /* 忽略 */ }
            document.body.removeChild(ta);
          }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(ok, fallback);
          } else fallback();
        });
        if (embedCode) embedCode.addEventListener('focus', function () { embedCode.select(); });

        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', load);
        else load();
      })();
    </script>
    <% if (!embed) { %><div class="footer">在线文档分享 · 只读</div><% } %>
  <% } else { %>
    <div class="wrap">
      <div class="card">
        <div style="padding:60px 20px;text-align:center;">
          <div style="font-size:46px;color:#ccc;margin-bottom:14px;">🔒</div>
          <h2 style="font-size:18px;color:#666;margin-bottom:8px;">内容已下架或链接失效</h2>
          <p style="font-size:13px;color:#999;">该分享链接不存在、已被停用，或内容已删除</p>
        </div>
      </div>
    </div>
  <% } %>
</body>
</html>
