<%# ===== 页面模板：frontend/office-list.ejs =====%>
<%# 说明：在线Office统一入口页（文档/表格/演示文稿）：能力介绍 + 快速新建/导入 + 类型分页 + 权限筛选 + 跨文档待审批面板 %>
<%
  var typeMeta = {
    document: { icon: '📄', name: '文档', hint: '排版、目录、页眉页脚、导出 PDF' },
    spreadsheet: { icon: '📊', name: '表格', hint: '公式、图表、条件格式、批量编辑' },
    presentation: { icon: '📽️', name: '演示文稿', hint: '幻灯片、切页动画、全屏放映' }
  };
  var typeOrder = ['document', 'spreadsheet', 'presentation'];
  var counts = { all: docs.length, document: 0, spreadsheet: 0, presentation: 0 };
  docs.forEach(function (d) { var t = d.doc_type || 'spreadsheet'; if (counts[t] === undefined) counts[t] = 0; counts[t]++; });
  function agoText(value) {
    if (!value) return '';
    var t = new Date(value).getTime();
    if (isNaN(t)) return String(value);
    var diff = Date.now() - t;
    if (diff < 60000) return '刚刚';
    if (diff < 3600000) return Math.floor(diff / 60000) + ' 分钟前';
    if (diff < 86400000) return Math.floor(diff / 3600000) + ' 小时前';
    if (diff < 2592000000) return Math.floor(diff / 86400000) + ' 天前';
    return new Date(value).toLocaleDateString('zh-CN');
  }
  var permLabel = ['无权限', '只读查看', '可评论', '可编辑', '可管理'];
%>
<div class="container office-page">
  <div class="of-hero">
    <div class="of-hero-main">
      <h1 class="of-title">🗂️ 在线Office</h1>
      <p class="page-desc">文档 · 表格 · 演示文稿 — 浏览器内直接编辑，自动保存，可随时回到历史版本。</p>
      <div class="of-caps">
        <span class="of-cap">🤝 多人协同</span>
        <span class="of-cap">💾 自动保存</span>
        <span class="of-cap">🕘 版本历史</span>
        <span class="of-cap">🤖 AI 助手</span>
        <span class="of-cap">📥 Office 导入导出</span>
        <span class="of-cap">🔗 只读分享</span>
        <span class="of-cap">🔐 权限申请</span>
      </div>
    </div>
    <div class="of-hero-acts">
      <% if (canCreate) { %>
        <% typeOrder.forEach(function (t) { %>
        <button type="button" class="of-new of-new-<%= t %>" data-new-type="<%= t %>">
          <span class="of-new-icon"><%= typeMeta[t].icon %></span>
          <span class="of-new-text"><em>新建</em><strong><%= typeMeta[t].name %></strong><i><%= typeMeta[t].hint %></i></span>
        </button>
        <% }); %>
        <button type="button" class="of-import" id="btnImportDoc">📥 导入文件<span>docx / xlsx / csv / pptx</span></button>
      <% } %>
      <% if (canManage) { %><a href="/admin/spreadsheets" class="of-admin">⚙️ 后台管理</a><% } %>
    </div>
  </div>

  <div class="office-approvals" id="permApprovals" hidden>
    <div class="oa-head">
      <span class="oa-title">📥 待审批的权限申请 <em class="oa-count" id="oaCount">0</em></span>
      <button type="button" class="oa-toggle" id="oaToggle">收起 ▲</button>
    </div>
    <div class="oa-list" id="oaList"></div>
  </div>

  <div class="of-toolbar">
    <div class="of-tabs" id="docTypeTabs">
      <button type="button" class="of-tab active" data-type="all">全部 <em><%= counts.all %></em></button>
      <% typeOrder.forEach(function (t) { %>
      <button type="button" class="of-tab" data-type="<%= t %>"><%= typeMeta[t].icon %> <%= typeMeta[t].name %> <em><%= counts[t] %></em></button>
      <% }); %>
    </div>
    <div class="of-filters">
      <input type="search" id="docSearch" class="sheet-search-input" placeholder="🔍 搜索文档名称 / 描述 / 创建者…" autocomplete="off">
      <select id="docPermFilter" class="sheet-perm-filter" title="按权限筛选">
        <option value="all">全部权限</option>
        <option value="4">可管理</option>
        <option value="3">可编辑</option>
        <option value="2">可评论</option>
        <option value="1">只读查看</option>
        <option value="0">无权限</option>
      </select>
      <select id="docSort" class="sheet-perm-filter" title="排序">
        <option value="updated">最近编辑</option>
        <option value="created">创建时间</option>
        <option value="name">名称</option>
      </select>
    </div>
  </div>

  <% if (docs.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">📋</div>
    <h3>还没有文档</h3>
    <p><% if (canCreate) { %>用上方「新建」创建文档、表格或演示文稿，也可以直接导入本地的 Office 文件。<% } else { %>还没有可访问的文档，可联系管理员创建或申请访问权限。<% } %></p>
  </div>
  <% } else { %>
  <div class="sheet-grid" id="docGrid">
    <% docs.forEach(function(doc) { %>
    <% var docType = doc.doc_type || 'spreadsheet'; %>
    <% var meta = typeMeta[docType] || typeMeta.spreadsheet; %>
    <% var lvl = Math.max(0, Math.min(4, doc.permLevel || 0)); %>
    <% var isMine = doc.created_by === user.id; %>
    <% var pendingType = (typeof myPending !== 'undefined' && myPending[doc.id]) || ''; %>
    <a href="/office/<%= doc.id %>" class="sheet-card type-<%= docType %>" data-name="<%= (doc.name || '').toLowerCase() %>"
       data-desc="<%= ((doc.description || '')).toLowerCase() %>" data-creator="<%= ((doc.creator_name || '')).toLowerCase() %>"
       data-perm="<%= doc.permLevel %>" data-type="<%= docType %>" data-updated="<%= new Date(doc.updated_at || doc.created_at || 0).getTime() %>"
       data-created="<%= new Date(doc.created_at || 0).getTime() %>" data-sortname="<%= (doc.name || '').toLowerCase() %>">
      <div class="sheet-card-icon"><%= meta.icon %></div>
      <div class="sheet-card-body">
        <div class="sheet-card-top">
          <h3 class="sheet-card-title"><%= doc.name %></h3>
          <span class="sheet-tag perm-<%= lvl %>" title="<%= permLabel[lvl] %>"><%= permLabel[lvl] %></span>
        </div>
        <p class="sheet-card-desc"><%= doc.description || '暂无描述' %></p>
        <div class="sheet-card-meta">
          <span><%= meta.name %></span>
          <span>👤 <%= doc.creator_name || '未知' %><% if (isMine) { %>（我）<% } %></span>
          <span>v<%= doc.doc_version || 0 %></span>
          <span title="<%= doc.updated_at || '' %>">🕘 <%= agoText(doc.updated_at || doc.created_at) %></span>
        </div>
        <div class="sheet-card-tags">
          <% if (doc.is_public_read) { %>
          <span class="sheet-tag tag-public" title="公开只读：所有登录用户可查看">🌐 公开可读</span>
          <% } %>
          <% if (lvl === 0 && pendingType) { %>
          <span class="sheet-tag tag-pending" title="申请已提交，等待创建者或管理员审批">⏳ 审批中</span>
          <% } else if (lvl === 0) { %>
          <span class="sheet-tag tag-apply">📩 点击卡片申请访问</span>
          <% } %>
        </div>
      </div>
    </a>
    <% }); %>
  </div>
  <div class="empty-state" id="noSearchResult" hidden>
    <div class="empty-icon">🔍</div>
    <h3>没有匹配的文档</h3>
    <p>换个关键词，或把类型 / 权限筛选改回「全部」试试</p>
  </div>
  <% } %>
</div>

<!-- 新建对话框挂载点 -->
<div id="sheetModalRoot"></div>
<div id="toastRoot"></div>

<link rel="stylesheet" href="/css/spreadsheets.css">
<script>
// 入口页交互：类型分页 + 搜索 + 权限/排序筛选 + 快速新建 + 导入 + 跨文档待审批
document.addEventListener('DOMContentLoaded', function() {
  var searchInput = document.getElementById('docSearch');
  var permFilter = document.getElementById('docPermFilter');
  var sortSelect = document.getElementById('docSort');
  var tabs = document.getElementById('docTypeTabs');
  var grid = document.getElementById('docGrid');
  var noResult = document.getElementById('noSearchResult');
  var activeType = 'all';

  function applyFilters() {
    if (!grid) return;
    var keyword = (searchInput ? searchInput.value : '').toLowerCase();
    var permVal = permFilter ? permFilter.value : 'all';
    var cards = [].slice.call(grid.querySelectorAll('.sheet-card'));
    var visible = [];
    cards.forEach(function(card) {
      var name = card.getAttribute('data-name') || '';
      var desc = card.getAttribute('data-desc') || '';
      var creator = card.getAttribute('data-creator') || '';
      var perm = card.getAttribute('data-perm') || '0';
      var type = card.getAttribute('data-type') || 'spreadsheet';
      var matchKeyword = !keyword || name.indexOf(keyword) !== -1 || desc.indexOf(keyword) !== -1 || creator.indexOf(keyword) !== -1;
      var matchType = activeType === 'all' || type === activeType;
      var matchPerm = permVal === 'all' || perm === permVal;
      var show = matchKeyword && matchType && matchPerm;
      card.style.display = show ? '' : 'none';
      if (show) visible.push(card);
    });
    var mode = sortSelect ? sortSelect.value : 'updated';
    visible.sort(function (a, b) {
      if (mode === 'name') return (a.getAttribute('data-sortname') || '').localeCompare(b.getAttribute('data-sortname') || '', 'zh-CN');
      var key = mode === 'created' ? 'data-created' : 'data-updated';
      return Number(b.getAttribute(key) || 0) - Number(a.getAttribute(key) || 0);
    });
    visible.forEach(function (card) { grid.appendChild(card); });
    if (noResult) noResult.hidden = visible.length > 0;
  }

  if (searchInput) searchInput.addEventListener('input', applyFilters);
  if (permFilter) permFilter.addEventListener('change', applyFilters);
  if (sortSelect) sortSelect.addEventListener('change', applyFilters);
  if (tabs) tabs.addEventListener('click', function (e) {
    var btn = e.target.closest('.of-tab');
    if (!btn) return;
    activeType = btn.getAttribute('data-type') || 'all';
    [].forEach.call(tabs.querySelectorAll('.of-tab'), function (t) { t.classList.toggle('active', t === btn); });
    applyFilters();
  });

  // 待审批权限申请面板：通过/拒绝复用文档级审批接口
  (function initApprovals() {
    var panel = document.getElementById('permApprovals');
    var listEl = document.getElementById('oaList');
    var countEl = document.getElementById('oaCount');
    var toggleBtn = document.getElementById('oaToggle');
    if (!panel || !listEl) return;
    var collapsed = false;

    function toggle() {
      collapsed = !collapsed;
      listEl.hidden = collapsed;
      toggleBtn.textContent = collapsed ? '展开 ▼' : '收起 ▲';
    }
    if (toggleBtn) toggleBtn.addEventListener('click', toggle);

    function fmtTime(v) {
      if (!v) return '';
      var d = new Date(v);
      return isNaN(d.getTime()) ? String(v) : d.toLocaleString('zh-CN', { hour12: false });
    }

    function row(app) {
      var el = document.createElement('div');
      el.className = 'oa-item';

      var info = document.createElement('div');
      info.className = 'oa-info';
      var line1 = document.createElement('strong');
      line1.textContent = app.applicant + ' 申请「' + app.docTypeName + '」';
      var line2 = document.createElement('span');
      line2.className = 'oa-doc';
      var reason = document.createElement('span');
      reason.className = 'oa-reason';
      reason.textContent = app.reason ? '理由：' + app.reason : '未填写理由';
      var time = document.createElement('span');
      time.className = 'oa-time';
      time.textContent = fmtTime(app.createdAt);
      info.appendChild(line1);
      info.appendChild(line2);
      info.appendChild(reason);
      info.appendChild(time);

      var acts = document.createElement('div');
      acts.className = 'oa-actions';
      var openBtn = document.createElement('a');
      openBtn.className = 'oa-btn oa-open';
      openBtn.href = '/office/' + app.spreadsheetId;
      openBtn.textContent = app.docName;
      var okBtn = document.createElement('button');
      okBtn.type = 'button';
      okBtn.className = 'oa-btn oa-approve';
      okBtn.textContent = '✓ 通过 ' + app.permName;
      var noBtn = document.createElement('button');
      noBtn.type = 'button';
      noBtn.className = 'oa-btn oa-reject';
      noBtn.textContent = '✕ 拒绝';
      acts.appendChild(openBtn);
      acts.appendChild(okBtn);
      acts.appendChild(noBtn);

      el.appendChild(info);
      el.appendChild(acts);

      function handle(approved, btn) {
        okBtn.disabled = true;
        noBtn.disabled = true;
        function revert() { btn.disabled = false; okBtn.disabled = false; noBtn.disabled = false; }
        csrfFetch('/api/spreadsheet/' + app.spreadsheetId + '/permission/approve', {
          method: 'POST',
          body: JSON.stringify({ application_id: app.id, approved: approved ? 1 : 0 })
        }).then(function (json) {
          if (json && json.success) {
            showToast(json.message || (approved ? '已通过' : '已拒绝'), 'success');
            el.classList.add('oa-done');
            okBtn.disabled = true;
            noBtn.disabled = true;
            openBtn.textContent = app.docName + '（已' + (approved ? '通过' : '拒绝') + '）';
          } else {
            showToast((json && json.error) || '操作失败', 'error');
            revert();
          }
        }).catch(function (err) {
          showToast('网络错误：' + (err && err.message ? err.message : '操作失败'), 'error');
          revert();
        });
      }
      okBtn.addEventListener('click', function () { handle(true, okBtn); });
      noBtn.addEventListener('click', function () { handle(false, noBtn); });
      return el;
    }

    csrfFetch('/api/office/permission/pending').then(function (json) {
      if (!json || !json.success) return;
      var apps = (json.data && json.data.applications) || [];
      countEl.textContent = String(apps.length);
      if (!apps.length) { panel.hidden = true; return; }
      panel.hidden = false;
      listEl.innerHTML = '';
      apps.forEach(function (app) { listEl.appendChild(row(app)); });
    }).catch(function () { /* 面板加载失败不影响列表页主流程 */ });
  })();

  // 新建文档对话框（quickType：入口「新建文档/表格/演示文稿」预选类型）
  function openCreateModal(quickType) {
    var modalRoot = document.getElementById('sheetModalRoot');
    if (!modalRoot) return;
    var backdrop = document.createElement('div');
    backdrop.className = 'ss-modal-backdrop';
    backdrop.innerHTML = '<div class="ss-modal">'
      + '<div class="ss-modal-head"><h3>新建文档</h3><button type="button" class="ss-modal-close">&times;</button></div>'
      + '<div class="ss-modal-body">'
      + '<div class="ss-field"><label>文档类型</label>'
      + '<select id="newDocType" style="width:100%;padding:8px;border:1px solid #e2e8f0;border-radius:6px;font-size:14px">'
      + '<option value="document">📄 文档</option>'
      + '<option value="spreadsheet">📊 表格</option>'
      + '<option value="presentation">📽️ 演示文稿</option>'
      + '</select></div>'
      + '<div class="ss-field"><label>文档名称</label>'
      + '<input type="text" id="newDocName" placeholder="未命名文档" maxlength="100" style="width:100%;padding:8px;border:1px solid #e2e8f0;border-radius:6px;font-size:14px;box-sizing:border-box"></div>'
      + '<div class="ss-field"><label>描述（可选）</label>'
      + '<textarea id="newDocDesc" rows="2" maxlength="500" style="width:100%;padding:8px;border:1px solid #e2e8f0;border-radius:6px;font-size:14px;box-sizing:border-box;resize:vertical"></textarea></div>'
      + '</div>'
      + '<div class="ss-modal-actions">'
      + '<button type="button" class="ss-btn" id="btnCancelCreate">取消</button>'
      + '<button type="button" class="ss-btn ss-btn-primary" id="btnConfirmCreate">创建</button>'
      + '</div></div>';
    modalRoot.appendChild(backdrop);
    if (quickType) backdrop.querySelector('#newDocType').value = quickType;

    var close = function() { if (backdrop.parentNode) backdrop.parentNode.removeChild(backdrop); };
    backdrop.querySelector('.ss-modal-close').addEventListener('click', close);
    backdrop.querySelector('#btnCancelCreate').addEventListener('click', close);
    backdrop.addEventListener('mousedown', function(e) { if (e.target === backdrop) close(); });

    backdrop.querySelector('#btnConfirmCreate').addEventListener('click', function() {
      var docType = backdrop.querySelector('#newDocType').value;
      var name = backdrop.querySelector('#newDocName').value.trim();
      var desc = backdrop.querySelector('#newDocDesc').value.trim();
      var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
      fetch('/api/spreadsheet', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
        credentials: 'same-origin',
        body: JSON.stringify({ docType: docType, name: name || undefined, description: desc || undefined })
      }).then(function(res) { return res.json(); }).then(function(json) {
        if (json.success && json.data && json.data.id) {
          close();
          window.location.href = '/office/' + json.data.id;
        } else {
          alert(json.error || '创建失败');
        }
      }).catch(function(err) { alert('请求失败：' + err.message); });
    });
  }

  var hero = document.querySelector('.of-hero-acts');
  if (hero) hero.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-new-type]');
    if (!btn) return;
    openCreateModal(btn.getAttribute('data-new-type'));
  });

  // 导入文件对话框（Office 全格式：按扩展名分派为表格 / 文档 / 演示文稿）
  var IMPORT_ACCEPT = <%- JSON.stringify((typeof importLimits !== 'undefined' && importLimits && importLimits.accept) ? importLimits.accept : ['.docx', '.doc', '.xlsx', '.xls', '.csv', '.pptx', '.ppt']) %>;
  var IMPORT_MAX_MB = <%= (typeof importLimits !== 'undefined' && importLimits ? importLimits.maxMb : 50) %>;

  var btnImport = document.getElementById('btnImportDoc');
  if (btnImport) {
    btnImport.addEventListener('click', function () {
      var modalRoot = document.getElementById('sheetModalRoot');
      if (!modalRoot) return;
      var picked = null;
      var backdrop = document.createElement('div');
      backdrop.className = 'ss-modal-backdrop';
      backdrop.innerHTML = '<div class="ss-modal">'
        + '<div class="ss-modal-head"><h3>📥 导入文件</h3><button type="button" class="ss-modal-close">&times;</button></div>'
        + '<div class="ss-modal-body">'
        + '<div class="ss-field"><label>选择文件（' + IMPORT_ACCEPT.join(' / ') + '，最大 ' + IMPORT_MAX_MB + 'MB）</label>'
        + '<div id="importDrop" style="padding:18px;border:2px dashed #cbd5e1;border-radius:8px;text-align:center;cursor:pointer;font-size:14px;color:#475569">点击选择文件，或拖拽到此处</div>'
        + '<input type="file" id="importFileInput" accept="' + IMPORT_ACCEPT.join(',') + '" hidden></div>'
        + '<div class="ss-field"><label>文档名称（默认取文件名）</label>'
        + '<input type="text" id="importDocName" maxlength="100" placeholder="留空则使用文件名" style="width:100%;padding:8px;border:1px solid #e2e8f0;border-radius:6px;font-size:14px;box-sizing:border-box"></div>'
        + '<p style="font-size:13px;color:#64748b;margin:8px 0 0">导入后按扩展名自动创建表格 / 文档 / 演示文稿；演示文稿会保留文字、图片、表格、形状、备注与切页动画，.docx 图片暂不支持。旧版 .doc/.ppt 需服务器安装 LibreOffice。</p>'
        + '<div id="importWarn" style="display:none;margin-top:8px;padding:8px;border-radius:6px;background:#fffbeb;color:#92400e;font-size:13px"></div>'
        + '</div>'
        + '<div class="ss-modal-actions">'
        + '<button type="button" class="ss-btn" id="btnCancelImport">取消</button>'
        + '<button type="button" class="ss-btn ss-btn-primary" id="btnConfirmImport">导入</button>'
        + '</div></div>';
      modalRoot.appendChild(backdrop);

      var close = function () { if (backdrop.parentNode) backdrop.parentNode.removeChild(backdrop); };
      var drop = backdrop.querySelector('#importDrop');
      var fileInput = backdrop.querySelector('#importFileInput');
      var warnBox = backdrop.querySelector('#importWarn');
      var confirmBtn = backdrop.querySelector('#btnConfirmImport');

      backdrop.querySelector('.ss-modal-close').addEventListener('click', close);
      backdrop.querySelector('#btnCancelImport').addEventListener('click', close);
      backdrop.addEventListener('mousedown', function (e) { if (e.target === backdrop) close(); });
      drop.addEventListener('click', function () { fileInput.click(); });
      fileInput.addEventListener('change', function () { setFile(fileInput.files[0]); });
      drop.addEventListener('dragover', function (e) { e.preventDefault(); drop.style.borderColor = '#4338ca'; });
      drop.addEventListener('dragleave', function () { drop.style.borderColor = '#cbd5e1'; });
      drop.addEventListener('drop', function (e) {
        e.preventDefault();
        drop.style.borderColor = '#cbd5e1';
        setFile(e.dataTransfer.files[0]);
      });

      function showMsg(text, isError) {
        warnBox.style.display = '';
        warnBox.style.background = isError ? '#fef2f2' : '#fffbeb';
        warnBox.style.color = isError ? '#b91c1c' : '#92400e';
        warnBox.textContent = text;
      }

      function setFile(file) {
        if (!file) return;
        var ext = (file.name || '').split('.').pop().toLowerCase();
        if (IMPORT_ACCEPT.indexOf('.' + ext) === -1) {
          showMsg('仅支持 ' + IMPORT_ACCEPT.join(' / ') + ' 文件', true);
          return;
        }
        if (file.size > IMPORT_MAX_MB * 1024 * 1024) {
          showMsg('文件超过 ' + IMPORT_MAX_MB + 'MB 限制，请拆分后再导入', true);
          return;
        }
        picked = file;
        drop.textContent = '已选择：' + file.name + '（' + (file.size / 1024 / 1024).toFixed(2) + ' MB）';
      }

      confirmBtn.addEventListener('click', function () {
        if (!picked) { showMsg('请先选择文件', true); return; }
        var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
        var formData = new FormData();
        formData.append('file', picked);
        var nameVal = backdrop.querySelector('#importDocName').value.trim();
        if (nameVal) formData.append('name', nameVal);
        confirmBtn.disabled = true;
        confirmBtn.textContent = '导入中…';
        fetch('/api/spreadsheet/import', {
          method: 'POST',
          headers: { 'X-CSRF-Token': csrf, 'X-Requested-With': 'XMLHttpRequest' },
          credentials: 'same-origin',
          body: formData
        }).then(function (res) {
          if (res.status === 413) {
            throw new Error('文件过大，服务器拒绝接收（413）。若使用 Nginx 反向代理，请确认 client_max_body_size 已放大');
          }
          return res.json();
        }).then(function (json) {
          if (json.success && json.data && json.data.id) {
            var warns = json.data.warnings || [];
            // 有提示（如忽略了图片）时先展示结果，由用户确认后再打开文档
            if (warns.length) {
              showMsg('导入成功：' + warns.join('；'), false);
              confirmBtn.disabled = false;
              confirmBtn.textContent = '打开文档';
              confirmBtn.onclick = function () { window.location.href = '/office/' + json.data.id; };
            } else {
              window.location.href = '/office/' + json.data.id;
            }
          } else {
            showMsg(json.error || '导入失败', true);
            confirmBtn.disabled = false;
            confirmBtn.textContent = '导入';
          }
        }).catch(function (err) {
          showMsg('导入失败：' + err.message, true);
          confirmBtn.disabled = false;
          confirmBtn.textContent = '导入';
        });
      });
    });
  }

  applyFilters();
});
</script>
