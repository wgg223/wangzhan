<%# ===== 页面模板：frontend/spreadsheet-editor.ejs =====%>
<%# 说明：Univer 在线表格编辑器页（独立布局，layout:false）：应用栏 + Univer 容器 + 批注/版本/分享/权限/AI 面板挂载点，交互见 public/js/spreadsheet-editor.js %>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= sheet.name %> - 在线表格</title>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <link rel="stylesheet" href="/css/fonts.css">
  <script src="/js/font-switcher.js"></script>
  <link rel="stylesheet" href="/vendor/univer/index.css">
  <link rel="stylesheet" href="/css/spreadsheet-editor.css">
  <% if (permLevel === 1) { %>
  <link rel="stylesheet" href="/css/ss-content-protect.css">
  <% } %>
</head>
<body>
  <!-- 应用栏：返回 / 标题 / 状态 / 在线协作者 / 功能入口 -->
  <header class="ss-appbar">
    <div class="ss-appbar-left">
      <a href="/spreadsheet" class="ss-back-btn" title="返回列表">←</a>
      <div class="ss-title-block">
        <h1 id="ssDocName" class="ss-doc-name" title="<%= sheet.description || '' %>"><%= sheet.name %></h1>
        <div class="ss-subinfo">
          <span id="ssSaveStatus" class="ss-save-status">加载中…</span>
          <span class="ss-meta">v<%= sheet.doc_version || 0 %></span>
          <% if (sheet.is_locked) { %><span class="ss-badge ss-badge-locked" title="表格已被锁定，禁止编辑">🔒 已锁定</span><% } %>
          <% if (permLevel >= 3) { %><span class="ss-badge ss-badge-edit">可编辑</span><% } else if (permLevel >= 2) { %><span class="ss-badge ss-badge-comment">可评论</span><% } else { %><span class="ss-badge ss-badge-view" title="只读查看：内容受保护（禁止复制/截图/导出）">👁️ 只读 · 内容保护</span><% } %>
        </div>
      </div>
    </div>

    <div class="ss-appbar-center" id="ssPresenceBar" title="在线协作者"></div>

    <div class="ss-appbar-right">
      <button type="button" class="ss-btn" id="btnSsSave" hidden>💾 保存</button>
      <button type="button" class="ss-btn" id="btnSsComments" title="批注 / 评论 / 任务">💬 批注<span class="ss-btn-badge" id="ssCommentCount" hidden>0</span></button>
      <button type="button" class="ss-btn" id="btnSsCharts" title="图表看板">📈 图表</button>
      <button type="button" class="ss-btn" id="btnSsVersions" title="历史版本">🕘 版本</button>
      <% if (canManage) { %>
      <button type="button" class="ss-btn" id="btnSsShare" title="分享 / 嵌入">🔗 分享</button>
      <button type="button" class="ss-btn" id="btnSsPerms" title="文档权限管理">🔐 权限</button>
      <% } else if (permLevel === 1) { %>
      <button type="button" class="ss-btn" id="btnSsApplyPerm" title="申请更高权限">🔓 申请权限</button>
      <% } %>
      <button type="button" class="ss-btn" id="btnSsAi" title="AI 助手：生成 / 公式 / 清洗 / 分析">✨ AI</button>
      <button type="button" class="ss-btn" id="btnSsExport" title="导出 xlsx / csv">⬇️ 导出</button>
      <div class="ss-user-chip">
        <img src="<%- user.avatar || '/assets/images/default-avatar.png' %>" alt="" class="ss-user-avatar">
        <span class="ss-user-name"><%= user.nickname || user.username %></span>
      </div>
    </div>
  </header>

  <!-- Univer 编辑器容器 -->
  <main class="ss-main">
    <div id="univer-container"></div>
    <div class="ss-loading-mask" id="ssLoadingMask">
      <div class="ss-loading-box">
        <div class="ss-spinner"></div>
        <p>正在加载表格…</p>
      </div>
    </div>
  </main>

  <!-- 批注侧栏（JS 渲染内容） -->
  <aside class="ss-comment-panel" id="ssCommentPanel" hidden>
    <div class="ss-comment-panel-head">
      <h3>💬 批注与任务</h3>
      <button type="button" class="ss-panel-close" id="ssCommentClose">&times;</button>
    </div>
    <div class="ss-comment-list" id="ssCommentList"></div>
    <div class="ss-comment-form" id="ssCommentForm">
      <input type="text" id="ssCommentInput" class="ss-input" data-ss-copy-ok placeholder="发表评论，@用户 可提醒，输入 /task 可指派任务…" maxlength="1000">
      <button type="button" class="ss-btn ss-btn-primary" id="ssCommentSend">发送</button>
    </div>
  </aside>

  <!-- 面板 / 对话框 / 轻提示挂载点（JS 动态渲染） -->
  <div id="ssModalRoot"></div>
  <div id="ssToastRoot"></div>

  <script>
    // 编辑器配置（后端注入 → spreadsheet-editor.js 读取）
    window.__SHEET__ = {
      sheetId: <%= sheet.id %>,
      name: <%- JSON.stringify(sheet.name || '') %>,
      description: <%- JSON.stringify(sheet.description || '') %>,
      version: <%= sheet.doc_version || 0 %>,
      isLocked: <%= sheet.is_locked ? 'true' : 'false' %>,
      permLevel: <%= permLevel %>,
      canEdit: <%= canEdit ? 'true' : 'false' %>,
      canManage: <%= canManage ? 'true' : 'false' %>,
      user: <%- JSON.stringify({ id: user.id, username: user.username, nickname: user.nickname || user.username, avatar: user.avatar || '' }) %>,
      csrf: (document.querySelector('meta[name="csrf-token"]') || {}).content || '',
      api: {
        doc: '/api/spreadsheet/<%= sheet.id %>/doc',
        meta: '/api/spreadsheet/<%= sheet.id %>/meta',
        export: '/api/spreadsheet/<%= sheet.id %>/export',
        versions: '/api/spreadsheet/<%= sheet.id %>/versions',
        comments: '/api/spreadsheet/<%= sheet.id %>/comments',
        charts: '/api/spreadsheet/<%= sheet.id %>/charts',
        presence: '/api/spreadsheet/<%= sheet.id %>/presence',
        changes: '/api/spreadsheet/<%= sheet.id %>/changes',
        lock: '/api/spreadsheet/<%= sheet.id %>/lock',
        share: '/api/spreadsheet/<%= sheet.id %>/share',
        permissions: '/api/spreadsheet/<%= sheet.id %>/permissions',
        myPerm: '/api/spreadsheet/<%= sheet.id %>/permission/my',
        revokePerm: '/api/spreadsheet/<%= sheet.id %>/permission',
        applications: '/api/spreadsheet/<%= sheet.id %>/permission/applications',
        approve: '/api/spreadsheet/<%= sheet.id %>/permission/approve',
        apply: '/api/spreadsheet/<%= sheet.id %>/permission/apply',
        users: '/api/spreadsheet/<%= sheet.id %>/users',
        ai: {
          formula: '/api/spreadsheet/<%= sheet.id %>/ai/formula',
          generate: '/api/spreadsheet/<%= sheet.id %>/ai/generate',
          analyze: '/api/spreadsheet/<%= sheet.id %>/ai/analyze',
          chart: '/api/spreadsheet/<%= sheet.id %>/ai/chart'
        }
      }
    };
  </script>
  <script src="/vendor/univer/univer.min.js"></script>
  <% if (permLevel === 1) { %>
  <script>
    // 只读内容保护配置（permLevel===1 用户：防复制 + 用户名水印溯源）
    window.__SS_PROTECT__ = {
      watermark: <%- JSON.stringify((user.nickname || user.username) + ' #' + user.id) %>,
      tip: '只读内容受保护：禁止复制、截图与导出，如需更高权限请点击「申请权限」'
    };
  </script>
  <script src="/js/ss-content-protect.js" defer></script>
  <% } %>
  <script src="/js/spreadsheet-editor.js" defer></script>
</body>
</html>
