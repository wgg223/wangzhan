<%# ===== 页面模板：frontend/spreadsheet-editor.ejs =====%>
<%# 说明：Luckysheet 在线表格编辑页（功能接近 Excel） %>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= sheet.name %> - 在线表格</title>
  <link rel='stylesheet' href='https://cdn.jsdelivr.net/npm/luckysheet@2.1.13/dist/plugins/css/pluginsCss.css' />
  <link rel='stylesheet' href='https://cdn.jsdelivr.net/npm/luckysheet@2.1.13/dist/plugins/plugins.css' />
  <link rel='stylesheet' href='https://cdn.jsdelivr.net/npm/luckysheet@2.1.13/dist/css/luckysheet.css' />
  <link rel='stylesheet' href='https://cdn.jsdelivr.net/npm/luckysheet@2.1.13/dist/assets/iconfont/iconfont.css' />
  <script src="https://cdn.jsdelivr.net/npm/luckysheet@2.1.13/dist/plugins/js/plugin.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/luckysheet@2.1.13/dist/luckysheet.umd.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { width: 100%; height: 100%; overflow: hidden; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
    #luckysheet { margin: 0; padding: 0; width: 100%; height: calc(100vh - 0px); left: 0; top: 0; bottom: 0; position: absolute; }
    .editor-header {
      position: fixed; top: 0; left: 0; right: 0; height: 48px;
      background: #fff; border-bottom: 1px solid #e0e0e0; z-index: 1000;
      display: flex; align-items: center; padding: 0 16px; gap: 12px;
    }
    .editor-header .back-link {
      color: #1a73e8; text-decoration: none; font-size: 14px; cursor: pointer;
    }
    .editor-header .back-link:hover { text-decoration: underline; }
    .editor-header .title {
      font-size: 16px; font-weight: 600; color: #333; flex: 1;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .editor-header .role-badge {
      padding: 2px 10px; border-radius: 12px; font-size: 12px; font-weight: 500;
    }
    .editor-header .admin-badge { background: #e8f5e9; color: #2e7d32; }
    .editor-header .viewer-badge { background: #fff3e0; color: #e65100; }
    .editor-header .save-status {
      font-size: 12px; color: #999; margin-right: 8px;
    }
    .editor-header .btn {
      padding: 6px 14px; border: 1px solid #ddd; border-radius: 4px;
      background: #fff; cursor: pointer; font-size: 13px; color: #333;
    }
    .editor-header .btn:hover { background: #f5f5f5; }
    .editor-header .btn-primary {
      background: #1a73e8; color: #fff; border-color: #1a73e8;
    }
    .editor-header .btn-primary:hover { background: #1557b0; }
    #luckysheet-container {
      position: absolute; top: 48px; left: 0; right: 0; bottom: 0;
    }
    .loading-mask {
      position: fixed; top: 0; left: 0; right: 0; bottom: 0;
      background: #fff; display: flex; align-items: center; justify-content: center;
      z-index: 2000; font-size: 16px; color: #666;
    }
  </style>
</head>
<body>
  <div class="editor-header">
    <a href="/spreadsheet" class="back-link">← 返回列表</a>
    <span class="title"><%= sheet.name %></span>
    <span class="save-status" id="saveStatus">已保存</span>
    <% if (canManage) { %>
    <span class="role-badge admin-badge">编辑模式</span>
    <button class="btn btn-primary" id="btnSave">💾 保存</button>
    <% } else { %>
    <span class="role-badge viewer-badge">只读模式</span>
    <% } %>
  </div>
  <div id="luckysheet-container">
    <div id="luckysheet"></div>
  </div>
  <div class="loading-mask" id="loadingMask">正在加载表格...</div>

  <script>
    (function() {
      const sheetId = <%= sheet.id %>;
      const canManage = <%= canManage ? 'true' : 'false' %>;
      let saveTimer = null;
      let isDirty = false;

      // 生成默认空表格
      function createEmptySheet() {
        return [{
          name: 'Sheet1',
          color: '',
          status: 1,
          order: 0,
          data: [],
          config: {},
          index: 0,
          luckysheet_select_save: [],
          scrollLeft: 0,
          scrollTop: 0,
          zoomRatio: 1,
          showGridLines: 1,
          defaultRowHeight: 28,
          defaultColWidth: 100,
          row: 36,
          column: 18,
          visibledatacolumn: 18,
          visibledatarow: 36
        }];
      }

      // 初始化 Luckysheet
      function initLuckysheet(data) {
        const options = {
          container: 'luckysheet',
          lang: 'zh',
          data: data,
          title: '<%= sheet.name %>',
          showinfobar: false,
          showsheetbar: true,
          showstatisticBar: true,
          allowEdit: canManage,
          allowCopy: true,
          enableAddRow: canManage,
          enableAddCol: canManage,
          enableAddBackTop: true,
          userInfo: false,
          showConfigWindowResize: true,
          forceCalculation: true,
          hook: {
            workbookCreateAfter: function() {
              document.getElementById('loadingMask').style.display = 'none';
            },
            cellUpdated: function(r, c, oldValue, newValue, isRefresh) {
              if (canManage) {
                isDirty = true;
                document.getElementById('saveStatus').textContent = '未保存';
                // 自动保存（防抖3秒）
                clearTimeout(saveTimer);
                saveTimer = setTimeout(autoSave, 3000);
              }
            },
            sheetActivate: function(index) {
              if (canManage) {
                isDirty = true;
                document.getElementById('saveStatus').textContent = '未保存';
                clearTimeout(saveTimer);
                saveTimer = setTimeout(autoSave, 3000);
              }
            }
          }
        };
        luckysheet.create(options);
      }

      // 自动保存
      function autoSave() {
        if (!canManage || !isDirty) return;
        saveData(function(success) {
          if (success) {
            isDirty = false;
            document.getElementById('saveStatus').textContent = '已保存 ' + new Date().toLocaleTimeString();
          }
        });
      }

      // 保存数据到后端
      function saveData(callback) {
        try {
          const allSheets = luckysheet.getAllSheets();
          // 清理不需要的字段，减小数据量
          const cleanData = allSheets.map(function(s) {
            return {
              name: s.name,
              color: s.color || '',
              status: s.status,
              order: s.order,
              data: s.data || [],
              config: s.config || {},
              index: s.index,
              scrollLeft: s.scrollLeft || 0,
              scrollTop: s.scrollTop || 0,
              zoomRatio: s.zoomRatio || 1,
              showGridLines: s.showGridLines != null ? s.showGridLines : 1,
              defaultRowHeight: s.defaultRowHeight || 28,
              defaultColWidth: s.defaultColWidth || 100,
              row: s.row || 36,
              column: s.column || 18,
              visibledatacolumn: s.visibledatacolumn || 18,
              visibledatarow: s.visibledatarow || 36,
              celldata: s.celldata || null,
              chart: s.chart || null,
              image: s.image || null,
              dataVerification: s.dataVerification || null,
              conditionFormat: s.conditionFormat || null,
              pivotTable: s.pivotTable || null
            };
          });

          const jsonData = JSON.stringify(cleanData);
          document.getElementById('saveStatus').textContent = '保存中...';

          fetch('/api/spreadsheet/' + sheetId + '/luckysheet/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ data: jsonData })
          })
          .then(function(res) { return res.json(); })
          .then(function(result) {
            if (result.success) {
              if (callback) callback(true);
            } else {
              document.getElementById('saveStatus').textContent = '保存失败: ' + (result.error || '未知错误');
              if (callback) callback(false);
            }
          })
          .catch(function(err) {
            document.getElementById('saveStatus').textContent = '保存失败: 网络错误';
            if (callback) callback(false);
          });
        } catch (e) {
          document.getElementById('saveStatus').textContent = '保存失败: ' + e.message;
          if (callback) callback(false);
        }
      }

      // 加载数据
      function loadData() {
        fetch('/api/spreadsheet/' + sheetId + '/luckysheet/data')
          .then(function(res) { return res.json(); })
          .then(function(result) {
            if (result.success && result.data) {
              try {
                const parsed = JSON.parse(result.data);
                if (parsed && parsed.length > 0) {
                  initLuckysheet(parsed);
                  return;
                }
              } catch (e) {
                console.error('解析表格数据失败，使用空表格', e);
              }
            }
            // 没有数据或解析失败，使用空表格
            initLuckysheet(createEmptySheet());
          })
          .catch(function() {
            initLuckysheet(createEmptySheet());
          });
      }

      // 手动保存按钮
      document.getElementById('btnSave').addEventListener('click', function() {
        saveData(function(success) {
          if (success) {
            isDirty = false;
            document.getElementById('saveStatus').textContent = '已保存 ' + new Date().toLocaleTimeString();
          }
        });
      });

      // 离开页面前提示保存
      window.addEventListener('beforeunload', function(e) {
        if (canManage && isDirty) {
          e.preventDefault();
          e.returnValue = '表格有未保存的更改，确定要离开吗？';
        }
      });

      // Ctrl+S 保存
      document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 's') {
          e.preventDefault();
          if (canManage) {
            saveData(function(success) {
              if (success) {
                isDirty = false;
                document.getElementById('saveStatus').textContent = '已保存 ' + new Date().toLocaleTimeString();
              }
            });
          }
        }
      });

      // 启动
      loadData();
    })();
  </script>
</body>
</html>
