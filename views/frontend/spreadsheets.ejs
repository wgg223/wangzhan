<%# ===== 页面模板：frontend/spreadsheets.ejs =====%>
<%# 说明：在线表格列表页（Univer 版）：卡片网格 + 搜索 + 创建/导入（EJS 服务端模板，交互见 public/js/spreadsheets.js） %>
<div class="container">
  <div class="page-header">
    <h1>📊 在线表格</h1>
    <p class="page-desc">协同编辑 · 公式 · 图表 · 批注 · 版本历史 · AI 助手</p>
  </div>

  <div class="action-bar">
    <input type="search" id="sheetSearch" class="sheet-search-input" placeholder="🔍 搜索表格名称 / 描述 / 创建者…" autocomplete="off">
    <select id="sheetPermFilter" class="sheet-perm-filter" title="按我的权限筛选">
      <option value="all">全部权限</option>
      <option value="0">无权限</option>
      <option value="1">只读查看</option>
      <option value="2">可评论</option>
      <option value="3">可编辑</option>
      <option value="4">可管理</option>
    </select>
    <% if (canManage) { %>
    <button type="button" class="btn btn-primary" id="btnCreateSheet">＋ 新建表格</button>
    <button type="button" class="btn btn-outline" id="btnImportSheet">📥 导入文件</button>
    <a href="/admin/spreadsheets" class="btn btn-outline">⚙️ 后台管理</a>
    <% } %>
  </div>

  <% if (sheets.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">📋</div>
    <h3>暂无表格</h3>
    <p><% if (canManage) { %>点击「新建表格」创建第一个在线表格，或导入 .xlsx / .csv 文件<% } else { %>还没有任何共享表格，请联系管理员创建<% } %></p>
  </div>
  <% } else { %>
  <div class="sheet-grid" id="sheetGrid">
    <% sheets.forEach(function(sheet) { %>
    <a href="/spreadsheet/<%= sheet.id %>" class="sheet-card" data-name="<%= (sheet.name || '').toLowerCase() %>"
       data-desc="<%= ((sheet.description || '')).toLowerCase() %>" data-creator="<%= ((sheet.creator_name || '')).toLowerCase() %>"
       data-perm="<%= sheet.permLevel %>">
      <div class="sheet-card-icon">
        <% if (sheet.permLevel >= 3) { %>✏️<% } else if (sheet.permLevel >= 2) { %>💬<% } else if (sheet.permLevel >= 1) { %>👁️<% } else { %>🔒<% } %>
      </div>
      <div class="sheet-card-body">
        <h3 class="sheet-card-title"><%= sheet.name %></h3>
        <p class="sheet-card-desc"><%= sheet.description || '暂无描述' %></p>
        <div class="sheet-card-meta">
          <span>👤 <%= sheet.creator_name || '未知' %></span>
          <span>v<%= sheet.doc_version || 0 %></span>
          <span><%= sheet.updated_at ? new Date(sheet.updated_at).toLocaleDateString('zh-CN') : '' %></span>
        </div>
        <div class="sheet-card-tags">
          <span class="sheet-tag perm-<%= sheet.permLevel %>">
            <% if (sheet.permLevel >= 4) { %>可管理<% } else if (sheet.permLevel >= 3) { %>可编辑<% } else if (sheet.permLevel >= 2) { %>可评论<% } else if (sheet.permLevel >= 1) { %>只读查看<% } else { %>无权限<% } %>
          </span>
          <% if (sheet.is_public_read) { %>
          <span class="sheet-tag" title="公开只读：所有登录用户可查看">🌐 公开</span>
          <% } %>
          <% if (sheet.permLevel === 0) { %>
          <button type="button" class="sheet-tag sheet-tag-apply" data-apply="<%= sheet.id %>">📩 申请访问</button>
          <% } %>
        </div>
      </div>
    </a>
    <% }); %>
  </div>
  <div class="empty-state" id="noSearchResult" hidden>
    <div class="empty-icon">🔍</div>
    <h3>没有匹配的表格</h3>
    <p>换个关键词试试</p>
  </div>
  <% } %>
</div>

<!-- 新建/导入 对话框挂载点（由 JS 动态渲染） -->
<div id="sheetModalRoot"></div>
<div id="toastRoot"></div>

<link rel="stylesheet" href="/css/spreadsheets.css">
<script src="/js/spreadsheets.js" defer></script>
