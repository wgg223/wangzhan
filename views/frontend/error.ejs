<%# ===== 页面模板：frontend/error.ejs =====%>
<%# 说明：错误提示页（403/404/500）（EJS 服务端模板，由 Express 渲染，变量与部分逻辑见对应路由） %>
<div class="container">
  <div class="error-page" style="text-align:center; padding:80px 20px; max-width:500px; margin:0 auto;">
    <div style="font-size:64px; margin-bottom:20px; opacity:0.6;">
      <%= typeof status !== 'undefined' && status === 404 ? '🔍' : '⚠️' %>
    </div>
    <h1 style="font-size:24px; margin-bottom:12px; color:#333;"><%= message %></h1>
    <p style="color:#666; margin-bottom:30px; line-height:1.6;"><%= error %></p>
    <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
      <a href="/" class="btn" style="padding:10px 24px; border-radius:6px; text-decoration:none;">返回首页</a>
      <button onclick="history.back()" class="btn" style="padding:10px 24px; border-radius:6px; background:#f5f5f5; color:#333; border:1px solid #ddd; cursor:pointer;">返回上一页</button>
    </div>
  </div>
</div>
