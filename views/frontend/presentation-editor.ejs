<%# ===== 页面模板：frontend/presentation-editor.ejs =====%>
<%# 说明：演示文稿编辑器页（独立布局，layout:false）。渲染层见 /js/ppt-scene.js，放映见 /js/ppt-slideshow.js，交互见 /js/presentation-editor.js %>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= doc.name %> - 演示文稿</title>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <link rel="stylesheet" href="/css/fonts.css">
  <script src="/js/font-switcher.js"></script>
  <link rel="stylesheet" href="/css/spreadsheet-editor.css">
  <link rel="stylesheet" href="/css/ppt-scene.css?v=20261103">
  <link rel="stylesheet" href="/css/ppt-slideshow.css?v=20261103">
  <link rel="stylesheet" href="/css/ppt-editor.css?v=20261103">
  <link rel="stylesheet" href="/css/anime-theme.css">
  <% if (permLevel === 1) { %>
  <link rel="stylesheet" href="/css/ss-content-protect.css">
  <% } %>
</head>
<body class="ppt-body">
  <!-- 应用栏 -->
  <header class="ss-appbar">
    <div class="ss-appbar-left">
      <a href="/office" class="ss-back-btn" title="返回列表">←</a>
      <div class="ss-title-block">
        <h1 id="ssDocName" class="ss-doc-name" title="<%= doc.description || '' %>"><%= doc.name %></h1>
        <div class="ss-subinfo">
          <span id="ssSaveStatus" class="ss-save-status">加载中…</span>
          <span class="ss-meta">v<%= doc.doc_version || 0 %></span>
          <span class="ss-badge" style="background:#fff7ed;color:#c2410c">📽️ 演示文稿</span>
          <span class="ss-meta" id="pptSlideCount"></span>
          <% if (doc.is_locked) { %><span class="ss-badge ss-badge-locked">🔒 已锁定</span><% } %>
          <% if (doc.is_public_read) { %><span class="ss-badge ss-badge-public">🌐 公开只读</span><% } %>
          <% if (permLevel >= 3) { %><span class="ss-badge ss-badge-edit">可编辑</span><% } else if (permLevel >= 2) { %><span class="ss-badge ss-badge-comment">可评论</span><% } else { %><span class="ss-badge ss-badge-view">👁️ 只读</span><% } %>
        </div>
      </div>
    </div>

    <div class="ss-appbar-center" id="ssPresenceBar" title="在线协作者"></div>

    <div class="ss-appbar-right">
      <button type="button" class="ss-btn ss-btn-primary" id="btnPptShow" title="从当前页放映（F5）">▶ 放映</button>
      <button type="button" class="ss-btn" id="btnPptShowPresenter" title="演讲者视图（Shift+F5）">🗣 演讲者视图</button>
      <button type="button" class="ss-btn" id="btnPptRehearse" title="排练计时：记录每页停留时长并写回文档">🎗 排练</button>
      <button type="button" class="ss-btn" id="btnSsSave" hidden>💾 保存</button>
      <button type="button" class="ss-btn" id="btnSsVersions" title="历史版本">🕘 版本</button>
      <% if (canManage) { %>
      <button type="button" class="ss-btn" id="btnSsShare" title="分享 / 嵌入">🔗 分享</button>
      <button type="button" class="ss-btn" id="btnSsPerms" title="文档权限管理">🔐 权限</button>
      <% } else if (permLevel === 1) { %>
      <button type="button" class="ss-btn" id="btnSsApplyPerm" title="申请更高权限">🔓 申请权限</button>
      <% } %>
      <button type="button" class="ss-btn" id="btnSsExport" title="导出演示文稿">⬇️ 导出</button>
      <div class="ss-user-chip">
        <img src="<%= user.avatar || '/assets/images/default-avatar.png' %>" alt="" class="ss-user-avatar">
        <span class="ss-user-name"><%= user.nickname || user.username %></span>
      </div>
    </div>
  </header>

  <!-- 功能区（工具栏由 presentation-editor.js 按配置生成） -->
  <div class="ppt-ribbon" id="pptRibbon"></div>

  <main class="ss-main ppt-main">
    <!-- 幻灯片列表 -->
    <aside class="ppt-panel" id="pptPanel">
      <div class="ppt-panel-head">
        <span>幻灯片</span>
        <button type="button" class="ss-mini-btn" id="pptAddSlide" title="新建幻灯片">＋</button>
      </div>
      <div class="ppt-thumb-list" id="pptThumbList"></div>
    </aside>

    <!-- 画布 -->
    <section class="ppt-center">
      <div class="ppt-canvas-scroll" id="pptCanvasScroll">
        <div class="ppt-canvas-wrap" id="pptCanvasWrap">
          <div class="ppt-canvas is-editing" id="pptCanvas"></div>
          <div class="ppt-marquee" id="pptMarquee" hidden></div>
        </div>
      </div>
      <div class="ppt-statusbar">
        <span id="pptSelInfo">未选中</span>
        <span class="ppt-grow"></span>
        <button type="button" class="ppt-zoom-btn" id="pptZoomOut" title="缩小">−</button>
        <input type="range" id="pptZoomRange" min="30" max="240" step="10" value="100">
        <button type="button" class="ppt-zoom-btn" id="pptZoomIn" title="放大">＋</button>
        <span id="pptZoomLabel">100%</span>
        <button type="button" class="ppt-zoom-btn" id="pptZoomFit" title="适应窗口">适应</button>
        <button type="button" class="ppt-zoom-btn" id="pptNotesToggle" title="备注栏">备注</button>
      </div>
      <div class="ppt-notes" id="pptNotesBox" hidden>
        <div class="ppt-notes-head">
          <span>演讲者备注</span>
          <span class="ppt-grow"></span>
          <span class="ppt-notes-hint">放映与演讲者视图中显示</span>
        </div>
        <textarea id="pptNotes" placeholder="在此输入本页备注，放映时按 S 打开演讲者视图可查看…"></textarea>
      </div>
    </section>

    <!-- 格式面板 -->
    <aside class="ppt-props" id="pptProps">
      <div class="ppt-props-tabs">
        <button type="button" class="is-active" data-tab="element">元素</button>
        <button type="button" data-tab="slide">页面</button>
      </div>
      <div class="ppt-props-body" id="pptPropsBody"></div>
    </aside>

    <div class="ss-loading-mask" id="ssLoadingMask">
      <div class="ss-loading-box">
        <div class="ss-spinner"></div>
        <p>正在加载演示文稿…</p>
      </div>
    </div>
  </main>

  <!-- 隐藏的文件选择器（插入图片用） -->
  <input type="file" id="pptImageInput" accept="image/png,image/jpeg,image/webp,image/gif" hidden>

  <div id="ssModalRoot"></div>
  <div id="ssToastRoot"></div>

  <script>
    window.__SHEET__ = {
      sheetId: <%= doc.id %>,
      docType: 'presentation',
      name: <%- JSON.stringify(doc.name || '').replace(/</g, '\\u003c') %>,
      description: <%- JSON.stringify(doc.description || '').replace(/</g, '\\u003c') %>,
      version: <%= doc.doc_version || 0 %>,
      isLocked: <%= doc.is_locked ? 'true' : 'false' %>,
      isPublicRead: <%= doc.is_public_read ? 'true' : 'false' %>,
      permLevel: <%= permLevel %>,
      canEdit: <%= canEdit ? 'true' : 'false' %>,
      canManage: <%= canManage ? 'true' : 'false' %>,
      user: <%- JSON.stringify({ id: user.id, username: user.username, nickname: user.nickname || user.username, avatar: user.avatar || '' }).replace(/</g, '\\u003c') %>,
      csrf: (document.querySelector('meta[name="csrf-token"]') || {}).content || '',
      api: {
        doc: '/api/spreadsheet/<%= doc.id %>/doc',
        meta: '/api/spreadsheet/<%= doc.id %>/meta',
        export: '/api/spreadsheet/<%= doc.id %>/export',
        media: '/api/spreadsheet/<%= doc.id %>/media',
        versions: '/api/spreadsheet/<%= doc.id %>/versions',
        presence: '/api/spreadsheet/<%= doc.id %>/presence',
        changes: '/api/spreadsheet/<%= doc.id %>/changes',
        lock: '/api/spreadsheet/<%= doc.id %>/lock',
        publicRead: '/api/spreadsheet/<%= doc.id %>/public-read',
        share: '/api/spreadsheet/<%= doc.id %>/share',
        permissions: '/api/spreadsheet/<%= doc.id %>/permissions',
        myPerm: '/api/spreadsheet/<%= doc.id %>/permission/my',
        revokePerm: '/api/spreadsheet/<%= doc.id %>/permission',
        applications: '/api/spreadsheet/<%= doc.id %>/permission/applications',
        approve: '/api/spreadsheet/<%= doc.id %>/permission/approve',
        apply: '/api/spreadsheet/<%= doc.id %>/permission/apply',
        users: '/api/spreadsheet/<%= doc.id %>/users'
      }
    };
  </script>
  <% if (permLevel === 1) { %>
  <script>
    window.__SS_PROTECT__ = {
      watermark: <%- JSON.stringify((user.nickname || user.username) + ' #' + user.id + (typeof clientIp !== 'undefined' && clientIp ? ' · ' + clientIp : '')).replace(/</g, '\\u003c') %>,
      tip: '只读内容受保护：禁止复制、截图与导出'
    };
  </script>
  <script src="/js/ss-content-protect.js" defer></script>
  <% } %>
  <script src="/js/ppt-scene.js?v=20261103" defer></script>
  <script src="/js/ppt-slideshow.js?v=20261103" defer></script>
  <script src="/js/presentation-editor.js?v=20261103" defer></script>
</body>
</html>
