<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>AI 聊天 - <%= settings.site_name || '我的网站' %></title>
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="theme-color" content="#ec4899">
  <%
  function acBust(p) {
    var u = typeof cdn !== 'undefined' ? cdn.getUrl(p) : p;
    return u + (u.indexOf('?') !== -1 ? '&' : '?') + 'v=20261110g';
  }
  %>
  <link rel="stylesheet" href="<%= acBust('/css/ai-chat.css') %>">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/marked/9.1.6/marked.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.0.6/purify.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
</head>
<body>
<div class="ac-app" id="acApp">
  <aside class="ac-sidebar" id="acSidebar">
    <div class="ac-brand">
      <img class="ac-user-avatar" src="<%= user.avatar %>" alt="">
      <h1 class="ac-user-name"><%= user.nickname || user.username %></h1>
    </div>
    <button class="ac-btn ac-btn-primary ac-new-chat" id="acNewChat">＋ 新对话</button>
    <button class="ac-btn ac-new-chat ac-new-group" id="acNewGroup">👥 新群聊</button>
    <div class="ac-conv-search"><input type="search" id="acConvSearch" placeholder="搜索会话…" autocomplete="off" spellcheck="false"></div>
    <div class="ac-conv-list" id="acConvList"></div>
    <div class="ac-sidebar-foot">
      <span class="ac-quota-badge" id="acQuotaBadge"></span>
      <p>会话数据仅自己可见</p>
    </div>
  </aside>

  <main class="ac-main">
    <header class="ac-topbar">
      <button class="ac-menu-btn" id="acMenuBtn" aria-label="菜单">☰</button>
      <div class="ac-conv-title" id="acConvTitle">新对话</div>
      <span class="ac-conv-tokens" id="acConvTokens"></span>
      <div class="ac-toolbar">
        <button class="ac-tool" id="acHelpBtn" title="使用指南">❓ <span>指南</span></button>
        <button class="ac-tool" id="acThemeBtn" title="切换深色/浅色">🌙 <span>夜间</span></button>
        <button class="ac-tool" id="acFullscreenBtn" title="全屏聊天">⛶ <span>全屏</span></button>
        <button class="ac-tool" id="acShareBtn" title="分享" style="display:none;">🔗 <span>分享</span></button>
        <button class="ac-tool" id="acModelBtn" title="切换模型">⚙️ <span id="acModelLabel">自动</span></button>
        <button class="ac-tool" id="acRoleBtn" title="角色预设">🎭 <span id="acRoleLabel">角色</span></button>
        <button class="ac-tool" id="acPanelToggle" title="设置面板">🎛️ <span>设置</span></button>
      </div>
    </header>

    <div class="ac-group-bar" id="acGroupBar" hidden>
      <div class="ac-group-members" id="acGroupMembers"></div>
      <button type="button" class="ac-btn ac-btn-sm" id="acGroupEdit">👥 成员</button>
    </div>

    <div class="ac-models-card" id="acModelsCard">
      <div class="ac-models-head">
        <span class="ac-models-title">🔑 我的 API 模型</span>
        <span class="ac-models-hint">自填优先 · Key 加密存储</span>
        <button type="button" class="ac-models-toggle" id="acModelsToggle">展开 ▾</button>
      </div>
      <div class="ac-models-body collapsed" id="acModelsBody">
        <div id="acMyModels"></div>
        <div class="ac-model-add-row" id="acModelAddRow" hidden>
          <span class="ac-model-add-name">提供商</span>
          <select class="ac-model-input" id="acmProvider"><option value="">自定义</option></select>
          <input type="text" class="ac-model-input" id="acmKey" placeholder="模型标识" maxlength="100" autocomplete="off">
          <button type="button" class="ac-btn ac-btn-sm" id="acmFetch">⟳ 获取模型</button>
          <input type="text" class="ac-model-input ac-model-input-wide" id="acmEndpoint" placeholder="API 端点" maxlength="300" autocomplete="off">
          <input type="password" class="ac-model-input ac-model-input-wide" id="acmApiKey" placeholder="API Key" maxlength="300" autocomplete="new-password">
          <label class="ac-model-default"><input type="checkbox" id="acmDefault"> 默认</label>
          <button type="button" class="ac-btn ac-btn-primary ac-btn-sm" id="acmSave">保存</button>
          <button type="button" class="ac-btn ac-btn-sm" id="acmCancel">取消</button>
          <div class="ac-model-add-get" id="acmGetWrap" hidden>🔗 <a id="acmGetLink" href="#" target="_blank" rel="noopener">获取 Key</a></div>
          <div class="ac-model-fetch-wrap" id="acmFetchWrap" hidden>
            <select class="ac-model-input" id="acmFetchList"></select>
            <button type="button" class="ac-btn ac-btn-sm" id="acmFetchUse">选用</button>
            <span class="ac-model-fetch-tip" id="acmFetchTip"></span>
          </div>
        </div>
        <button type="button" class="ac-btn ac-btn-sm" id="acModelAddBtn">＋ 添加模型</button>
        <div class="ac-global-models" id="acGlobalModels"></div>
      </div>
    </div>

    <div class="ac-messages" id="acMessages">
      <div class="ac-empty" id="acEmpty">
        <div class="ac-empty-icon">🤖</div>
        <h2>开始一段新对话</h2>
        <p>选择角色预设，或直接输入消息。</p>
        <div class="ac-empty-hint" id="acEmptyHint"></div>
      </div>
    </div>

    <footer class="ac-input-bar">
      <div class="ac-suggestions" id="acSuggestions" hidden></div>
      <textarea id="acInput" rows="3" placeholder="输入消息，Enter 发送，Shift+Enter 换行" maxlength="8000"></textarea>
      <div class="ac-input-foot">
        <span class="ac-input-tip">Enter 发送 · Shift+Enter 换行</span>
        <span class="ac-input-tokens" id="acInputTokens"></span>
        <button type="button" class="ac-btn ac-btn-ghost ac-btn-sm" id="acContinueBtn" title="继续生成">▶ 继续</button>
        <button type="button" class="ac-btn ac-btn-ghost ac-btn-sm" id="acImpersonateBtn" title="模仿用户">👤 模仿</button>
        <button type="button" class="ac-btn ac-btn-ghost ac-btn-sm" id="acCompressBtn" title="压缩对话历史">📦</button>
        <button type="button" class="ac-btn ac-btn-ghost ac-btn-sm" id="acTtsToggle" title="朗读">🔊</button>
        <button type="button" class="ac-btn ac-btn-ghost ac-btn-sm" id="acPredictBtn" title="智能预测：推荐你可能想发的下一条消息">💡 <span>预测</span></button>
        <button type="button" class="ac-btn ac-btn-ghost ac-btn-sm" id="acImageGenBtn" title="生成场景图片">🎨</button>
        <button type="button" class="ac-btn ac-btn-ghost ac-btn-sm" id="acPickPrompt" style="display:none;">📚</button>
        <button type="button" class="ac-btn ac-btn-primary" id="acSend">发送</button>
        <button type="button" class="ac-btn ac-btn-danger" id="acStop" style="display:none;">停止</button>
      </div>
    </footer>
  </main>

  <!-- 右侧设置面板 -->
  <aside class="ac-panel" id="acPanel">
    <div class="ac-panel-tabs">
      <button class="ac-panel-tab active" data-panel="character">🎭 角色</button>
      <button class="ac-panel-tab" data-panel="generation">⚡ 生成</button>
      <button class="ac-panel-tab" data-panel="worldbook">📖 世界书</button>
      <button class="ac-panel-tab" data-panel="memory">🧠 记忆</button>
      <button class="ac-panel-tab" data-panel="advanced">🔧 高级</button>
    </div>
    <div class="ac-panel-content">
      <div class="ac-panel-page active" id="panel-character">
        <div class="ac-panel-section">
          <div class="ac-panel-role-card">
            <div class="ac-panel-role-avatar" id="acPanelRoleAvatar">🎭</div>
            <div class="ac-panel-role-info">
              <h3 id="acPanelRoleName">未选择角色</h3>
              <p id="acPanelRoleDesc">选择角色开始对话</p>
            </div>
          </div>
          <button class="ac-btn ac-btn-sm" id="acPanelRoleSwitch" style="width:100%;margin-top:8px;">切换角色</button>
        </div>
        <div class="ac-panel-section">
          <h4>分支</h4>
          <div id="acPanelBranchList" class="ac-panel-branch-list"></div>
        </div>
      </div>
      <div class="ac-panel-page" id="panel-generation">
        <div class="ac-panel-section">
          <h4>预设</h4>
          <div class="ac-panel-preset-row">
            <select id="acPresetSelect" class="ac-model-input"><option value="">自定义</option></select>
            <button class="ac-btn ac-btn-sm" id="acPresetSave" title="保存预设">💾</button>
            <button class="ac-btn ac-btn-sm" id="acPresetDelete" title="删除预设">🗑</button>
          </div>
        </div>
        <div class="ac-panel-section">
          <h4>生成参数</h4>
          <div class="ac-slider-group"><label>Temperature <span id="acGenTempVal">0.7</span></label><input type="range" id="acGenTemp" min="0" max="2" step="0.05" value="0.7"></div>
          <div class="ac-slider-group"><label>Top P <span id="acGenTopPVal">1.0</span></label><input type="range" id="acGenTopP" min="0" max="1" step="0.05" value="1"></div>
          <div class="ac-slider-group"><label>Top K <span id="acGenTopKVal">0</span></label><input type="range" id="acGenTopK" min="0" max="100" step="1" value="0"><small>0 = 不限制</small></div>
          <div class="ac-slider-group"><label>Freq Penalty <span id="acGenFreqVal">0</span></label><input type="range" id="acGenFreq" min="-2" max="2" step="0.1" value="0"></div>
          <div class="ac-slider-group"><label>Pres Penalty <span id="acGenPresVal">0</span></label><input type="range" id="acGenPres" min="-2" max="2" step="0.1" value="0"></div>
          <div class="ac-slider-group"><label>Max Tokens <span id="acGenMaxVal">4096</span></label><input type="range" id="acGenMax" min="256" max="32768" step="256" value="4096"></div>
          <button class="ac-btn ac-btn-primary ac-btn-sm" id="acGenSave" style="width:100%;margin-top:10px;">保存参数到会话</button>
        </div>
      </div>
      <div class="ac-panel-page" id="panel-worldbook">
        <div class="ac-panel-section">
          <div class="ac-world-toolbar">
            <input type="text" id="acWorldSearch" class="ac-model-input" placeholder="搜索条目…" style="flex:1;">
            <span id="acWorldCount" class="ac-world-count">0 条</span>
          </div>
          <div id="acWorldList" class="ac-world-list ac-panel-world-list"></div>
          <div class="ac-world-batch">
            <button type="button" class="ac-btn ac-btn-sm" id="acWorldEnableAll">全启用</button>
            <button type="button" class="ac-btn ac-btn-sm" id="acWorldDisableAll">全停用</button>
            <button type="button" class="ac-btn ac-btn-danger ac-btn-sm" id="acWorldDeleteAll">清空</button>
          </div>
          <div style="display:flex;gap:6px;margin-top:8px;">
            <button type="button" class="ac-btn ac-btn-sm" id="acWorldImport">⤵ 模板</button>
            <button type="button" class="ac-btn ac-btn-sm" id="acWorldFileImport">📥 导入</button>
            <input type="file" id="acWorldFileInput" accept=".json,.md,.markdown" hidden>
            <button type="button" class="ac-btn ac-btn-primary ac-btn-sm" id="acWorldAdd" style="flex:1;">＋ 添加</button>
          </div>
        </div>
      </div>
      <div class="ac-panel-page" id="panel-memory">
        <div class="ac-panel-section">
          <label class="ac-field ac-check"><input type="checkbox" id="acMemoryEnabled"> 启用长期记忆</label>
          <label class="ac-field ac-check"><input type="checkbox" id="acRagEnabled"> 知识库问答（RAG）</label>
          <label class="ac-field">记忆模式<select id="acMemoryMode"><option value="summary">摘要</option><option value="vector">向量</option><option value="both">摘要+向量</option><option value="off">关闭</option></select></label>
          <div style="display:flex;gap:6px;margin-top:10px;">
            <button class="ac-btn ac-btn-sm" id="acMemoryRefresh">立即总结</button>
            <button class="ac-btn ac-btn-sm" id="acMemoryBackfill">记忆补录</button>
            <button class="ac-btn ac-btn-primary ac-btn-sm" id="acMemorySave" style="flex:1;">保存</button>
          </div>
        </div>
        <div class="ac-panel-section">
          <h4>对话压缩</h4>
          <label class="ac-field ac-check"><input type="checkbox" id="acAutoCompress"> 自动压缩（消息过多时）</label>
          <div class="ac-slider-group"><label>保留最近 <span id="acCompressKeepVal">10</span> 条</label><input type="range" id="acCompressKeep" min="4" max="50" step="1" value="10"></div>
          <button class="ac-btn ac-btn-sm" id="acCompressNow" style="width:100%;margin-top:6px;">立即压缩对话</button>
        </div>
        <div class="ac-panel-section">
          <h4>TTS 语音</h4>
          <label class="ac-field">语音<select id="acTtsVoice"></select></label>
          <div class="ac-slider-group"><label>语速 <span id="acTtsRateVal">1.0</span></label><input type="range" id="acTtsRate" min="0.5" max="2" step="0.1" value="1"></div>
          <div class="ac-slider-group"><label>音调 <span id="acTtsPitchVal">1.0</span></label><input type="range" id="acTtsPitch" min="0" max="2" step="0.1" value="1"></div>
        </div>
      </div>
      <div class="ac-panel-page" id="panel-advanced">
        <div class="ac-panel-section">
          <h4>作者注释</h4>
          <textarea id="acAuthorNote" rows="3" maxlength="2000" placeholder="插入到上下文中的指令…" class="ac-model-input" style="width:100%;resize:vertical;"></textarea>
          <div class="ac-slider-group" style="margin-top:6px;"><label>深度 <span id="acAuthorNoteDepthVal">4</span></label><input type="range" id="acAuthorNoteDepth" min="0" max="20" step="1" value="4"><small>0=最前，N=倒数第N条前</small></div>
        </div>
        <div class="ac-panel-section">
          <h4>提示词模板</h4>
          <select id="acPromptTemplate" class="ac-model-input" style="width:100%;"><option value="">无模板</option></select>
          <button class="ac-btn ac-btn-sm" id="acPromptTemplateManage" style="width:100%;margin-top:6px;">管理模板</button>
        </div>
        <div class="ac-panel-section">
          <h4>正则后处理</h4>
          <button class="ac-btn ac-btn-sm" id="acRegexBtn" style="width:100%;">🧩 管理正则脚本</button>
        </div>
        <div class="ac-panel-section">
          <h4>上下文</h4>
          <button class="ac-btn ac-btn-sm" id="acContextPreview" style="width:100%;">🔍 预览上下文</button>
        </div>
        <div class="ac-panel-section">
          <h4>操作</h4>
          <div style="display:flex;flex-wrap:wrap;gap:6px;">
            <button class="ac-btn ac-btn-sm" id="acChatExport" <%= canExport ? '' : 'style="display:none"' %>>📥 导出</button>
            <button class="ac-btn ac-btn-sm" id="acChatImport">📤 导入</button>
            <input type="file" id="acChatFileInput" accept=".json,.jsonl" hidden>
            <button class="ac-btn ac-btn-sm" id="acRoleImport">⤵ 导入角色</button>
            <button class="ac-btn ac-btn-sm" id="acRoleExport" <%= canExport ? '' : 'style="display:none"' %>>⤴ 导出角色</button>
            <button class="ac-btn ac-btn-sm" id="acRoleImportUrl">🌐 抓取</button>
          </div>
        </div>
      </div>
    </div>
  </aside>
</div>

<!-- 弹窗 -->
<div class="ac-modal-overlay" id="acModelModal" hidden><div class="ac-modal"><div class="ac-modal-head"><h2>选择模型</h2><button class="ac-modal-close" data-ac-close="acModelModal">×</button></div><div class="ac-modal-body" id="acModelList"></div><div class="ac-modal-foot"><span class="ac-modal-hint">每个会话独立记录所选模型</span></div></div></div>

<div class="ac-modal-overlay" id="acRoleModal" hidden><div class="ac-modal ac-modal-lg"><div class="ac-modal-head"><h2>选择角色</h2><button class="ac-modal-close" data-ac-close="acRoleModal">×</button></div><div class="ac-modal-body" style="display:flex;flex-direction:column;max-height:65vh;"><div class="ac-role-filter" id="acRoleFilter"><input type="text" class="ac-role-filter-search" id="acRoleSearch" placeholder="搜索角色…"><button class="ac-role-filter-tag active" data-cat="">全部</button><button class="ac-role-filter-tag" data-cat="default">通用</button><button class="ac-role-filter-tag" data-cat="rp">RP</button><button class="ac-role-filter-tag" data-cat="honkai_sr">星铁</button><button class="ac-role-filter-tag" data-cat="writing">写作</button><button class="ac-role-filter-tag" data-cat="my">我的</button><button class="ac-role-filter-tag" data-cat="fav">⭐ 收藏</button></div><div class="ac-role-grid" id="acRoleList"></div></div><div class="ac-modal-foot"><span class="ac-modal-hint">官方角色由管理员维护</span><button class="ac-btn ac-btn-sm" id="acRoleCreate">＋ 创建角色</button></div></div></div>
<input type="file" id="acRoleFileInput" accept=".json,.png" style="display:none;">

<div class="ac-modal-overlay" id="acRoleUrlModal" hidden><div class="ac-modal"><div class="ac-modal-head"><h2>🌐 抓取角色卡</h2><button class="ac-modal-close" data-ac-close="acRoleUrlModal">×</button></div><div class="ac-modal-body"><label class="ac-field">URL<input id="acRoleUrlInput" type="url" placeholder="https://example.com/characters/xxx" maxlength="500"></label></div><div class="ac-modal-foot"><button class="ac-btn ac-btn-sm" data-ac-close="acRoleUrlModal">取消</button><span style="flex:1"></span><button class="ac-btn ac-btn-primary ac-btn-sm" id="acRoleUrlFetch">抓取并导入</button></div></div></div>

<div class="ac-modal-overlay" id="acRoleCreateModal" hidden><div class="ac-modal"><div class="ac-modal-head"><h2>创建角色</h2><button class="ac-modal-close" data-ac-close="acRoleCreateModal">×</button></div><div class="ac-modal-body"><div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;"><div class="ac-role-card-avatar" id="acNewRoleAvatarPreview" style="width:56px;height:56px;font-size:24px;cursor:pointer;">🎭</div><div style="flex:1;"><label class="ac-field" style="margin-bottom:4px;">头像<input type="text" id="acNewRoleAvatar" placeholder="URL（可选）" maxlength="500" class="ac-model-input" style="margin-top:4px;"></label><input type="file" id="acNewRoleAvatarFile" accept="image/*" style="display:none;"><button type="button" class="ac-btn ac-btn-sm" id="acNewRoleAvatarBtn" style="font-size:11px;">📁 上传</button></div></div><label class="ac-field">名称<input id="acNewRoleName" maxlength="50"></label><label class="ac-field">设定<textarea id="acNewRolePrompt" rows="5" maxlength="4000"></textarea></label><label class="ac-field">开场白<textarea id="acNewRoleGreeting" rows="2" maxlength="1000"></textarea></label><label class="ac-field">简介<textarea id="acNewRoleDesc" rows="2" maxlength="200"></textarea></label><details class="ac-field ac-role-advanced"><summary>高级</summary><label class="ac-field">性格<textarea id="acNewRolePersonality" rows="2" maxlength="2000"></textarea></label><label class="ac-field">场景<textarea id="acNewRoleScenario" rows="2" maxlength="2000"></textarea></label><label class="ac-field">示例<textarea id="acNewRoleExamples" rows="3" maxlength="4000"></textarea></label></details></div><div class="ac-modal-foot"><button class="ac-btn ac-btn-sm" data-ac-close="acRoleCreateModal">取消</button><button class="ac-btn ac-btn-primary ac-btn-sm" id="acRoleSave">保存</button></div></div></div>

<div class="ac-modal-overlay" id="acGroupModal" hidden><div class="ac-modal"><div class="ac-modal-head"><h2 id="acGroupModalTitle">新建群聊</h2><button class="ac-modal-close" data-ac-close="acGroupModal">×</button></div><div class="ac-modal-body"><label class="ac-field">群聊名称<input id="acGroupName" maxlength="100" placeholder="如：主角小队"></label><label class="ac-field">回复模式<select id="acGroupMode"><option value="round">轮流发言（每轮所有成员依次回复）</option><option value="manual">手动指定（点击成员头像触发回复）</option></select></label><label class="ac-field">群成员（2–16 个）</label><div class="ac-group-member-list" id="acGroupMemberList"></div></div><div class="ac-modal-foot"><button class="ac-btn ac-btn-sm" data-ac-close="acGroupModal">取消</button><button class="ac-btn ac-btn-primary ac-btn-sm" id="acGroupSave">创建</button></div></div></div>

<div class="ac-modal-overlay" id="acWorldEditModal" hidden><div class="ac-modal ac-modal-lg"><div class="ac-modal-head"><h2 id="acWorldEditTitle">世界书条目</h2><button class="ac-modal-close" data-ac-close="acWorldEditModal">×</button></div><div class="ac-modal-body"><div class="ac-field-row"><label class="ac-field">触发词<input id="acWorldKey" maxlength="200" placeholder="逗号分隔，留空=常驻"></label><label class="ac-field">位置<select id="acWorldPos"><option value="system_top">系统前</option><option value="before_char">角色前</option><option value="after_char">角色后</option><option value="user_top">用户消息</option><option value="assistant_top">AI前</option><option value="in_chat">按深度插入</option></select></label></div><div class="ac-field-row"><label class="ac-field" id="acWorldDepthWrap" style="display:none;">插入深度<small>倒数第 N 条消息前</small><input id="acWorldDepth" type="number" min="0" max="200" value="4"></label><label class="ac-field">触发概率 %<input id="acWorldProbability" type="number" min="0" max="100" value="100"></label></div><div class="ac-field-row"><label class="ac-field ac-check"><input type="checkbox" id="acWorldConstant"> 常驻</label><label class="ac-field ac-check" id="acWorldSelectiveWrap"><input type="checkbox" id="acWorldSelective"> 选择性（需二级键命中）</label></div><label class="ac-field">二级触发词<small>选择性开启时，需同时命中才注入</small><input id="acWorldSecondary" maxlength="300" placeholder="逗号分隔"></label><label class="ac-field">内容<textarea id="acWorldContent" rows="8" maxlength="20000"></textarea></label></div><div class="ac-modal-foot"><button class="ac-btn ac-btn-danger ac-btn-sm" id="acWorldDelete" style="display:none;">删除</button><span style="flex:1"></span><button class="ac-btn ac-btn-sm" data-ac-close="acWorldEditModal">取消</button><button class="ac-btn ac-btn-primary ac-btn-sm" id="acWorldSave">保存</button></div></div></div>

<div class="ac-modal-overlay" id="acBranchModal" hidden><div class="ac-modal"><div class="ac-modal-head"><h2>剧情分支</h2><button class="ac-modal-close" data-ac-close="acBranchModal">×</button></div><div class="ac-modal-body" id="acBranchList"></div><div class="ac-modal-foot"><span class="ac-modal-hint">在 AI 消息上点「分叉」创建分支</span></div></div></div>

<div class="ac-modal-overlay" id="acShareModal" hidden><div class="ac-modal"><div class="ac-modal-head"><h2>🔗 分享</h2><button class="ac-modal-close" data-ac-close="acShareModal">×</button></div><div class="ac-modal-body"><p class="ac-modal-hint">免登录查看，可停用。</p><div style="display:flex;gap:8px;margin-top:10px;"><input type="text" id="acShareUrl" class="ac-model-input" readonly style="flex:1;"><button type="button" class="ac-btn ac-btn-primary ac-btn-sm" id="acShareCopy">复制</button></div></div><div class="ac-modal-foot"><button type="button" class="ac-btn ac-btn-danger ac-btn-sm" id="acShareToggle" style="display:none;">停用</button><span style="flex:1"></span><button class="ac-btn ac-btn-sm" data-ac-close="acShareModal">关闭</button></div></div></div>

<div class="ac-modal-overlay" id="acPromptModal" hidden><div class="ac-modal ac-modal-lg"><div class="ac-modal-head"><h2>提示词库</h2><button class="ac-modal-close" data-ac-close="acPromptModal">×</button></div><div class="ac-modal-body" style="display:flex;flex-direction:column;max-height:60vh;"><input type="text" class="ac-model-input" id="acPromptSearch" placeholder="搜索…"><div style="padding:6px 0;font-size:12px;color:var(--text-muted);" id="acPromptCount"></div><div id="acPromptList" style="overflow-y:auto;flex:1;"></div><button type="button" class="ac-btn ac-btn-sm" id="acPromptMore" style="display:none;margin-top:8px;">⬇ 更多</button></div></div></div>

<div class="ac-modal-overlay" id="acTemplateModal" hidden><div class="ac-modal ac-modal-lg"><div class="ac-modal-head"><h2>提示词模板</h2><button class="ac-modal-close" data-ac-close="acTemplateModal">×</button></div><div class="ac-modal-body" style="max-height:60vh;overflow-y:auto;"><div id="acTemplateList"></div><div style="margin-top:12px;border-top:1px solid var(--border-color);padding-top:12px;"><h4 style="margin-bottom:8px;">新建</h4><label class="ac-field">名称<input id="acTemplateName" maxlength="100"></label><label class="ac-field">内容<textarea id="acTemplateContent" rows="5" maxlength="8000" placeholder="{{char}} {{user}} {{scenario}} {{personality}}"></textarea></label><button class="ac-btn ac-btn-primary ac-btn-sm" id="acTemplateSave">保存</button></div></div></div></div>

<div class="ac-modal-overlay" id="acRegexModal" hidden><div class="ac-modal ac-modal-lg"><div class="ac-modal-head"><h2 id="acRegexModalTitle">正则后处理脚本</h2><button class="ac-modal-close" data-ac-close="acRegexModal">×</button></div><div class="ac-modal-body" style="max-height:65vh;overflow-y:auto;"><div id="acRegexListView"><p class="ac-modal-hint" style="margin-bottom:10px;">发送前（prompt）替换上下文，或渲染前（display）美化正文；按顺序依次应用。</p><div id="acRegexList"></div><button class="ac-btn ac-btn-primary ac-btn-sm" id="acRegexAdd" style="margin-top:10px;">＋ 新建脚本</button></div><div id="acRegexEditView" hidden><label class="ac-field">名称<input id="acRegexName" maxlength="100" placeholder="如：去除思考标签"></label><label class="ac-field">查找正则<input id="acRegexFind" maxlength="2000" placeholder="如：&lt;thinking&gt;[\s\S]*?&lt;/thinking&gt;" class="ac-regex-mono"></label><label class="ac-field">替换为<textarea id="acRegexReplace" rows="2" maxlength="8000" placeholder="留空=删除匹配；支持 $&amp; $1 捕获组" class="ac-regex-mono"></textarea></label><div class="ac-field-row"><label class="ac-field">标志<input id="acRegexFlags" maxlength="10" value="g" placeholder="g i m s u y" class="ac-regex-mono"></label><label class="ac-field">作用位置<select id="acRegexPlacement"><option value="display">渲染（display）</option><option value="prompt">发送（prompt）</option><option value="both">两者（both）</option></select></label></div><div class="ac-field-row"><label class="ac-field">排序<input id="acRegexSort" type="number" value="0"></label><label class="ac-field ac-check"><input type="checkbox" id="acRegexEnabled" checked> 启用</label></div><details class="ac-field ac-role-advanced"><summary>深度范围（仅 prompt 侧生效）</summary><div class="ac-field-row"><label class="ac-field">最小深度<input id="acRegexMinDepth" type="number" min="0" placeholder="不限"></label><label class="ac-field">最大深度<input id="acRegexMaxDepth" type="number" min="0" placeholder="不限"></label></div><small style="color:var(--text-muted);">距最后一条消息的距离，0=最后一条；留空=不限。</small></details><div style="margin-top:12px;border-top:1px solid var(--border-color);padding-top:12px;"><h4 style="margin-bottom:8px;">测试</h4><label class="ac-field">样本文本<textarea id="acRegexTestSample" rows="3" placeholder="粘贴一段文本测试替换效果"></textarea></label><button class="ac-btn ac-btn-sm" id="acRegexTestBtn">运行测试</button><pre id="acRegexTestResult" class="ac-regex-test-result" hidden></pre></div></div></div><div class="ac-modal-foot"><button class="ac-btn ac-btn-danger ac-btn-sm" id="acRegexDelete" hidden>删除</button><span style="flex:1"></span><button class="ac-btn ac-btn-sm" id="acRegexBack" hidden>← 返回列表</button><button class="ac-btn ac-btn-sm" data-ac-close="acRegexModal">关闭</button><button class="ac-btn ac-btn-primary ac-btn-sm" id="acRegexSave" hidden>保存</button></div></div></div>

<div class="ac-modal-overlay" id="acPresetSaveModal" hidden><div class="ac-modal"><div class="ac-modal-head"><h2>保存预设</h2><button class="ac-modal-close" data-ac-close="acPresetSaveModal">×</button></div><div class="ac-modal-body"><label class="ac-field">名称<input id="acPresetName" maxlength="100" placeholder="如：创意写作"></label><label class="ac-field ac-check"><input type="checkbox" id="acPresetDefault"> 默认</label></div><div class="ac-modal-foot"><button class="ac-btn ac-btn-sm" data-ac-close="acPresetSaveModal">取消</button><button class="ac-btn ac-btn-primary ac-btn-sm" id="acPresetSaveConfirm">保存</button></div></div></div>

<div class="ac-modal-overlay" id="acContextModal" hidden><div class="ac-modal ac-modal-lg"><div class="ac-modal-head"><h2>上下文预览</h2><button class="ac-modal-close" data-ac-close="acContextModal">×</button></div><div class="ac-modal-body" style="max-height:65vh;overflow-y:auto;"><div id="acContextInfo" style="font-size:12px;color:var(--text-muted);margin-bottom:10px;"></div><div id="acContextMessages"></div></div></div></div>

<div class="ac-modal-overlay" id="acHelpModal" hidden><div class="ac-modal ac-modal-lg"><div class="ac-modal-head"><h2>❓ AI 聊天使用指南</h2><button class="ac-modal-close" data-ac-close="acHelpModal">×</button></div><div class="ac-modal-body" style="display:flex;flex-direction:column;max-height:68vh;"><input type="text" class="ac-model-input" id="acHelpSearch" placeholder="搜索问题或关键词…"><div class="ac-help-cats" id="acHelpCats"></div><div class="ac-help-count" id="acHelpCount"></div><div class="ac-help-list" id="acHelpList"></div></div><div class="ac-modal-foot"><span class="ac-modal-hint">首次进入自动弹出，之后可从顶部「❓ 指南」随时打开</span><button class="ac-btn ac-btn-primary ac-btn-sm" id="acHelpOk">我知道了</button></div></div></div>

<div class="ac-modal-overlay" id="acMemoryBackfillModal" hidden><div class="ac-modal"><div class="ac-modal-head"><h2>🧠 记忆补录</h2><button class="ac-modal-close" data-ac-close="acMemoryBackfillModal">×</button></div><div class="ac-modal-body" style="max-height:65vh;overflow-y:auto;"><div id="acBackfillStatus" style="font-size:13px;line-height:1.8;color:var(--text-muted);">加载中…</div><div id="acBackfillEmbWarn" style="display:none;margin-top:10px;padding:8px 10px;border-radius:6px;background:rgba(255,180,0,.14);color:#e0a800;font-size:12px;line-height:1.6;"></div><div id="acBackfillProgress" style="display:none;margin-top:12px;padding:10px;border:1px solid var(--border-color);border-radius:8px;"><div id="acBackfillPhase" style="font-size:13px;font-weight:600;margin-bottom:6px;"></div><div style="height:8px;background:var(--border-color);border-radius:4px;overflow:hidden;"><div id="acBackfillBar" style="height:100%;width:0;background:#6c5ce7;transition:width .3s;"></div></div><div id="acBackfillMeta" style="font-size:12px;color:var(--text-muted);margin-top:6px;"></div></div><p class="ac-modal-hint" style="margin-top:12px;">后台补录会等待当前回复结束后再继续。增强（向量）补录需先在后台配置向量模型。</p></div><div class="ac-modal-foot"><button class="ac-btn ac-btn-danger ac-btn-sm" id="acBackfillCancel" style="display:none;">取消</button><span style="flex:1"></span><button class="ac-btn ac-btn-sm" id="acBackfillSummaries">逐轮总结</button><button class="ac-btn ac-btn-sm" id="acBackfillVectors">向量坐标</button><button class="ac-btn ac-btn-sm" id="acBackfillGroups">二次压缩</button><button class="ac-btn ac-btn-primary ac-btn-sm" id="acBackfillAll">全部补录</button></div></div></div>

<script type="application/json" id="ai-chat-data"><%- JSON.stringify({
  csrfToken: csrfToken,
  user: { id: user.id, username: user.username, role: user.role },
  siteName: settings.site_name || '',
  canPickPrompt: !!canPickPrompt,
  canShareLink: !!canShareLink,
  canExport: !!canExport,
  prompts: canPickPrompt ? prompts.map(function(p) { return { id: p.id, title: p.title, excerpt: p.excerpt || '' }; }) : []
}).replace(/</g, '\\u003c') %></script>
<script src="<%= acBust('/js/utils.js') %>"></script>
<script src="<%= acBust('/js/ai-chat.js') %>" defer></script>
</body>
</html>