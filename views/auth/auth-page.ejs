<%# ===== 页面模板：auth/auth-page.ejs =====%>
<%# 说明：登录/注册公共页面框架（EJS 服务端模板，由 Express 渲染，变量与部分逻辑见对应路由） %>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= modeTitle %> - <%= siteName %></title>
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <script>
    // 暗色模式引导：与 main.js 使用同一 localStorage key，保证认证页与主站主题一致
    (function() {
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (e) {}
    })();
  </script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="<%= typeof cdn !== 'undefined' ? cdn.getUrl('/css/auth.css') : '/css/auth.css' %>">
</head>
<body class="auth-page <%= source %>-theme" data-mode="<%= mode %>">
  <div class="auth-shell">
    <!-- 品牌面板 -->
    <aside class="auth-brand">
      <div class="auth-brand-badge" aria-hidden="true"><span><%= siteName.charAt(0) %></span></div>
      <h1 class="auth-brand-name"><%= siteName %></h1>
      <% if (typeof siteDescription !== 'undefined' && siteDescription) { %>
        <p class="auth-brand-desc"><%= siteDescription %></p>
      <% } %>
      <% if (typeof icpNumber !== 'undefined' && icpNumber) { %>
        <p class="auth-brand-icp"><%= icpNumber %></p>
      <% } %>
    </aside>

    <!-- 表单卡片 -->
    <main class="auth-card">
      <header class="auth-card-header">
        <h2><%= modeTitle %></h2>
        <p><%= modeSubtitle %></p>
      </header>
    
    <% if (error) { %>
      <div class="auth-alert auth-alert-error">
        <i class="fas fa-exclamation-circle"></i>
        <span><%= error %></span>
      </div>
    <% } %>
    <% if (success) { %>
      <div class="auth-alert auth-alert-success">
        <i class="fas fa-check-circle"></i>
        <span><%= success %></span>
      </div>
    <% } %>

    <div class="auth-alert auth-alert-error" id="authErrorAlert" style="display: none;">
      <i class="fas fa-exclamation-circle"></i>
      <span id="authErrorText"></span>
    </div>

    <!-- 登录表单 -->
    <% if (mode === 'login') { %>
      <form action="/auth/<%= source %>/login" method="POST" class="auth-form" id="loginForm" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (typeof returnTo !== 'undefined' && returnTo) { %>
          <input type="hidden" name="returnTo" value="<%= returnTo %>">
        <% } %>
        <div class="form-group" id="group-username">
          <label for="username">用户名</label>
          <input type="text" id="username" name="username" class="auth-input" placeholder="请输入用户名" required value="<%= typeof username !== 'undefined' ? username : '' %>" autocomplete="username">
          <div class="field-error" id="err-username"></div>
        </div>
        
        <div class="form-group" id="group-password">
          <label for="password">密码</label>
          <div class="password-field">
            <input type="password" id="password" name="password" class="auth-input" placeholder="请输入密码" required autocomplete="current-password">
            <button type="button" class="toggle-password" onclick="togglePassword('password')" aria-label="显示密码">
              <i class="fas fa-eye"></i>
            </button>
          </div>
          <div class="field-error" id="err-password"></div>
        </div>
        
        <!-- 用户协议 -->
        <div class="form-group agreement-group" id="group-agree">
          <label class="auth-checkbox-label">
            <input type="checkbox" id="loginAgreeTerms" name="agree_terms" value="1" required>
            <span>我已阅读并同意
              <a href="javascript:void(0)" onclick="showAuthModal('terms')" style="color:#2563eb;text-decoration:underline;">《用户协议》</a>
            </span>
          </label>
          <label class="auth-checkbox-label" style="margin-top:6px;">
            <input type="checkbox" id="loginAgreePrivacy" name="agree_privacy" value="1" required>
            <span>我已阅读并同意
              <a href="javascript:void(0)" onclick="showAuthModal('privacy')" style="color:#2563eb;text-decoration:underline;">《隐私政策》</a>
            </span>
          </label>
          <div class="field-error" id="err-agree"></div>
        </div>

        <label class="remember-me">
          <input type="checkbox" name="remember" id="remember" value="1"> 记住登录（30 天内免登录）
        </label>

        <!-- 登录失败达到阈值后显示图形验证码 -->
        <% if (typeof captchaRequired !== 'undefined' && captchaRequired) { %>
        <div class="form-group captcha-group" id="loginCaptchaGroup">
          <label for="loginCaptcha">图形验证码 <span class="required">*</span></label>
          <div class="captcha-container">
            <div class="captcha-image-wrapper" id="loginCaptchaWrapper" onclick="refreshCaptchaCommon('loginCaptchaWrapper')" title="点击刷新验证码">
              <%- captchaSvg %>
            </div>
            <button type="button" class="captcha-refresh" onclick="refreshCaptchaCommon('loginCaptchaWrapper')" title="刷新验证码">
              <i class="fas fa-sync-alt"></i>
            </button>
          </div>
          <input type="text" id="loginCaptcha" name="captcha" class="auth-input" placeholder="请输入验证码" required maxlength="10" autocomplete="off">
          <div class="field-error" id="err-captcha"></div>
        </div>
        <% } %>

        <!-- 开启两步验证（TOTP）后显示 -->
        <% if (typeof totpRequired !== 'undefined' && totpRequired) { %>
        <div class="form-group" id="loginTotpGroup">
          <label for="loginTotp">两步验证码 <span class="required">*</span></label>
          <input type="text" id="loginTotp" name="totp_code" class="auth-input" placeholder="请输入身份验证器中的 6 位数字" required maxlength="6" autocomplete="one-time-code" inputmode="numeric">
          <div class="field-error" id="err-totp_code"></div>
        </div>
        <% } %>
        
        <button type="submit" class="auth-btn auth-btn-primary" id="loginSubmitBtn">
          <i class="fas fa-sign-in-alt"></i> 登录
        </button>
      </form>

      <!-- 第三方登录 -->
      <% if (typeof oauthProviders !== 'undefined' && oauthProviders && oauthProviders.length > 0) { %>
        <div class="auth-divider">
          <span>其他登录方式</span>
        </div>
        <div class="form-group agreement-group" style="margin-bottom:12px;">
          <label class="auth-checkbox-label">
            <input type="checkbox" id="oauthAgreePrivacy" value="1">
            <span>使用第三方登录即表示您同意
              <a href="javascript:void(0)" onclick="showAuthModal('oauthPrivacy')" style="color:#2563eb;text-decoration:underline;">《第三方登录隐私政策》</a>
            </span>
          </label>
          <label class="auth-checkbox-label" style="margin-top:6px;">
            <input type="checkbox" id="oauthAgreeTerms" value="1">
            <span>我已阅读并同意
              <a href="javascript:void(0)" onclick="showAuthModal('terms')" style="color:#2563eb;text-decoration:underline;">《用户协议》</a>
              和
              <a href="javascript:void(0)" onclick="showAuthModal('privacy')" style="color:#2563eb;text-decoration:underline;">《隐私政策》</a>
            </span>
          </label>
        </div>
        <div class="oauth-buttons">
          <% oauthProviders.forEach(function(provider) { %>
            <button type="button" class="oauth-btn oauth-btn-<%= provider.provider %>" 
                    onclick="oauthLogin('<%= provider.provider %>', '<%= source %>')"
                    title="使用<%= provider.display_name %>登录"
                    style="--oauth-color: <%= provider.color %>">
              <i class="<%= provider.icon %>"></i>
              <span><%= provider.display_name %></span>
            </button>
          <% }); %>
        </div>
      <% } %>
      
      <div class="auth-links">
        <p>还没有账号？<a href="/auth/<%= source %>/register">立即注册</a></p>
        <p><a href="/auth/<%= source %>/forgot-password">忘记密码？</a></p>
        <% if (source === 'image-share') { %>
          <p><a href="/image-share">返回图片分享</a></p>
        <% } else { %>
          <p><a href="/">返回首页</a></p>
        <% } %>
      </div>

    <!-- 注册表单 - 信息填写步骤 -->
    <% } else if (mode === 'register' && step !== 'verify') { %>
      <% if (typeof oauthPending !== 'undefined' && oauthPending) { %>
        <div class="auth-alert auth-alert-success" style="margin-bottom:16px;">
          <i class="fas fa-link"></i>
          <span>您正在通过 <strong><%= oauthPending.providerName %></strong> 第三方账号注册，请填写以下信息完成注册。</span>
        </div>
      <% } %>
      <form action="/auth/<%= source %>/register" method="POST" class="auth-form" id="registerForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="username">用户名 <span class="required">*</span></label>
          <input type="text" id="username" name="username" class="auth-input" placeholder="3-20个字符" required minlength="3" maxlength="20" value="<%= typeof username !== 'undefined' ? username : '' %>">
        </div>

        <% if (source === 'image-share') { %>
          <div class="form-group">
            <label for="nickname">昵称</label>
            <input type="text" id="nickname" name="nickname" class="auth-input" placeholder="选填">
          </div>
        <% } %>
        
        <div class="form-group">
          <label for="email">邮箱 <span class="required">*</span></label>
          <% if (typeof oauthPending !== 'undefined' && oauthPending && oauthPending.userInfo.email) { %>
            <input type="text" id="email" name="email" class="auth-input" required value="<%= email %>" readonly style="background:#f5f5f5;cursor:not-allowed;">
            <small class="form-text" style="color:#999;font-size:12px;display:block;margin-top:4px;">邮箱来自第三方账号，不可修改</small>
          <% } else { %>
            <input type="text" id="email" name="email" class="auth-input" placeholder="请输入邮箱地址（格式如：username@domain.com）" required value="<%= typeof email !== 'undefined' ? email : '' %>" oninput="validateEmailFormat(this)">
            <small id="emailHelp" class="form-text" style="color:#999;font-size:12px;display:block;margin-top:4px;">邮箱格式：用户名@域名（如：username@example.com）</small>
          <% } %>
        </div>
        
        <div class="form-group">
          <label for="password">密码 <% if (typeof oauthPending === 'undefined' || !oauthPending) { %><span class="required">*</span><% } else { %><small style="color:#999;font-weight:normal;">（选填，设置后可用密码登录）</small><% } %></label>
          <div class="password-field">
            <input type="password" id="password" name="password" class="auth-input" placeholder="<%= (typeof oauthPending !== 'undefined' && oauthPending) ? '可选，至少6位' : '至少6个字符' %>" <%= (typeof oauthPending === 'undefined' || !oauthPending) ? 'required' : '' %> minlength="6">
            <button type="button" class="toggle-password" onclick="togglePassword('password')">
              <i class="fas fa-eye"></i>
            </button>
          </div>
        </div>
        
        <div class="form-group">
          <label for="confirm_password">确认密码 <% if (typeof oauthPending === 'undefined' || !oauthPending) { %><span class="required">*</span><% } %></label>
          <div class="password-field">
            <input type="password" id="confirm_password" name="confirm_password" class="auth-input" placeholder="请再次输入密码" <%= (typeof oauthPending === 'undefined' || !oauthPending) ? 'required' : '' %> minlength="6">
            <button type="button" class="toggle-password" onclick="togglePassword('confirm_password')">
              <i class="fas fa-eye"></i>
            </button>
          </div>
          <div id="passwordStrength" style="display: none; margin-top: 8px;">
            <div style="height: 4px; background: #e5e7eb; border-radius: 2px; overflow: hidden;">
              <div id="strengthBar" style="height: 100%; width: 0%; transition: all 0.3s; border-radius: 2px;"></div>
            </div>
            <small id="strengthText" style="font-size: 11px; margin-top: 4px; display: block;"></small>
          </div>
          <small id="passwordMatch" style="font-size: 11px; margin-top: 4px; display: block;"></small>
        </div>
        
        <!-- 图形验证码 -->
        <div class="form-group captcha-group">
          <label for="registerCaptcha">图形验证码 <span class="required">*</span></label>
          <div class="captcha-container">
            <div class="captcha-image-wrapper" id="registerCaptchaWrapper" onclick="refreshRegisterCaptcha()">
              <%- captchaSvg %>
            </div>
            <button type="button" class="captcha-refresh" onclick="refreshRegisterCaptcha()" title="刷新验证码">
              <i class="fas fa-sync-alt"></i>
            </button>
          </div>
          <input type="text" id="registerCaptcha" name="captcha" class="auth-input" 
                 placeholder="请输入验证码" required maxlength="10" autocomplete="off">
        </div>

        <!-- 用户协议 -->
        <div class="form-group agreement-group">
          <label class="auth-checkbox-label">
            <input type="checkbox" id="agreeTerms" name="agree_terms" value="1" required>
            <span>我已阅读并同意
              <a href="javascript:void(0)" onclick="showAuthModal('terms')" style="color:#2563eb;text-decoration:underline;">《用户协议》</a>
            </span>
          </label>
          <label class="auth-checkbox-label" style="margin-top:6px;">
            <input type="checkbox" id="agreePrivacy" name="agree_privacy" value="1" required>
            <span>我已阅读并同意
              <a href="javascript:void(0)" onclick="showAuthModal('privacy')" style="color:#2563eb;text-decoration:underline;">《隐私政策》</a>
            </span>
          </label>
        </div>
        
        <button type="submit" class="auth-btn auth-btn-primary" id="registerBtn">
          <i class="fas fa-user-plus"></i> 注册
        </button>
      </form>
      
      <div class="auth-links">
        <p>已有账号？<a href="/auth/<%= source %>/login">立即登录</a></p>
        <% if (source === 'image-share') { %>
          <p><a href="/image-share">返回图片分享</a></p>
        <% } else { %>
          <p><a href="/">返回首页</a></p>
        <% } %>
      </div>

    <!-- 注册表单 - 验证码步骤 -->
    <% } else if (mode === 'register' && step === 'verify') { %>
      <form action="/auth/<%= source %>/register" method="POST" class="auth-form" id="verifyForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="step" value="verify">
        <div class="form-group">
          <label>邮箱地址</label>
          <input type="text" class="auth-input" value="<%= email %>" disabled style="background:#f5f5f5;">
          <input type="hidden" name="email" value="<%= email %>">
        </div>
        
        <div class="form-group">
          <label for="code">验证码 <span class="required">*</span></label>
          <input type="text" id="code" name="code" class="auth-input auth-input-code" placeholder="请输入验证码" required maxlength="8" pattern="[0-9a-fA-F]{8}" autocomplete="off" style="text-align:center;font-size:24px;letter-spacing:4px;">
        </div>
        
        <div class="form-group">
          <button type="button" class="auth-btn" id="resendCodeBtn" style="background:#f0f0f0;color:#666;font-size:13px;" onclick="resendVerifyCode()">
            <i class="fas fa-redo"></i> <span id="resendText">重新发送验证码</span>
          </button>
        </div>
        
        <button type="submit" class="auth-btn auth-btn-primary" id="verifyBtn">
          <i class="fas fa-check-circle"></i> 验证并注册
        </button>
      </form>
      
      <div class="auth-links">
        <p><a href="/auth/<%= source %>/register">返回上一步</a></p>
        <p>已有账号？<a href="/auth/<%= source %>/login">立即登录</a></p>
        <% if (source === 'frontend') { %>
          <p><a href="/">返回首页</a></p>
        <% } %>
      </div>

    <!-- 忘记密码 - 邮箱步骤 -->
    <% } else if (mode === 'forgot-password' && step === 'email') { %>
      <form action="/auth/<%= source %>/forgot-password/send-code" method="POST" class="auth-form" id="forgotPasswordForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="email">邮箱地址</label>
          <input type="email" id="email" name="email" class="auth-input" value="<%= email %>" placeholder="请输入注册邮箱" required>
        </div>

        <!-- 图形验证码 -->
        <div class="form-group captcha-group">
          <label for="forgotCaptcha">图形验证码 <span class="required">*</span></label>
          <div class="captcha-container">
            <div class="captcha-image-wrapper" id="forgotCaptchaWrapper" onclick="refreshForgotCaptcha()">
              <%- typeof captchaSvg !== 'undefined' && captchaSvg ? captchaSvg : '' %>
            </div>
            <button type="button" class="captcha-refresh" onclick="refreshForgotCaptcha()" title="刷新验证码">
              <i class="fas fa-sync-alt"></i>
            </button>
          </div>
          <input type="text" id="forgotCaptcha" name="captcha" class="auth-input" 
                 placeholder="请输入验证码" required maxlength="10" autocomplete="off">
        </div>

        <button type="submit" class="auth-btn auth-btn-primary">
          <i class="fas fa-paper-plane"></i> 发送验证码
        </button>
      </form>
      
      <div class="auth-links">
        <p><a href="/auth/<%= source %>/login">返回登录</a></p>
      </div>

    <!-- 忘记密码 - 验证码步骤 -->
    <% } else if (mode === 'forgot-password' && step === 'verify') { %>
      <form action="/auth/<%= source %>/forgot-password/reset" method="POST" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="email" value="<%= email %>">
        
        <div class="form-group">
          <label for="code">验证码</label>
          <input type="text" id="code" name="code" class="auth-input auth-input-code" placeholder="请输入验证码" required maxlength="8" pattern="[0-9a-fA-F]{8}">
        </div>

        <div class="form-group">
          <label for="new_password">新密码</label>
          <div class="password-field">
            <input type="password" id="new_password" name="new_password" class="auth-input" placeholder="请输入新密码（至少6位）" required minlength="6">
            <button type="button" class="toggle-password" onclick="togglePassword('new_password')">
              <i class="fas fa-eye"></i>
            </button>
          </div>
        </div>

        <div class="form-group">
          <label for="confirm_password">确认新密码</label>
          <div class="password-field">
            <input type="password" id="confirm_password" name="confirm_password" class="auth-input" placeholder="请再次输入新密码" required minlength="6">
            <button type="button" class="toggle-password" onclick="togglePassword('confirm_password')">
              <i class="fas fa-eye"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="auth-btn auth-btn-primary">
          <i class="fas fa-key"></i> 重置密码
        </button>
      </form>
      
      <div class="auth-links">
        <p><a href="/auth/<%= source %>/forgot-password">重新发送验证码</a></p>
        <p><a href="/auth/<%= source %>/login">返回登录</a></p>
      </div>

    <!-- 修改密码 -->
    <% } else if (mode === 'change-password') { %>
      <form action="/auth/<%= source %>/change-password" method="POST" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (user) { %>
          <div class="form-group">
            <label>当前用户</label>
            <input type="text" value="<%= user.username %>" disabled class="auth-input">
          </div>
        <% } else { %>
          <div class="form-group">
            <label for="username">用户名</label>
            <input type="text" id="username" name="username" class="auth-input" placeholder="请输入用户名" required>
          </div>
        <% } %>

        <div class="form-group">
          <label for="current_password">当前密码</label>
          <div class="password-field">
            <input type="password" id="current_password" name="current_password" class="auth-input" placeholder="请输入当前密码" required>
            <button type="button" class="toggle-password" onclick="togglePassword('current_password')">
              <i class="fas fa-eye"></i>
            </button>
          </div>
        </div>

        <div class="form-group">
          <label for="new_password">新密码</label>
          <div class="password-field">
            <input type="password" id="new_password" name="new_password" class="auth-input" placeholder="请输入新密码（至少6位）" required minlength="6">
            <button type="button" class="toggle-password" onclick="togglePassword('new_password')">
              <i class="fas fa-eye"></i>
            </button>
          </div>
        </div>

        <div class="form-group">
          <label for="confirm_password">确认新密码</label>
          <div class="password-field">
            <input type="password" id="confirm_password" name="confirm_password" class="auth-input" placeholder="请再次输入新密码" required minlength="6">
            <button type="button" class="toggle-password" onclick="togglePassword('confirm_password')">
              <i class="fas fa-eye"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="auth-btn auth-btn-primary">
          <i class="fas fa-key"></i> 修改密码
        </button>
      </form>
      
      <div class="auth-links">
        <p><a href="/">返回首页</a></p>
      </div>

    <!-- 修改用户名 -->
    <% } else if (mode === 'change-username') { %>
      <form action="/auth/<%= source %>/change-username" method="POST" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label>当前用户名</label>
          <input type="text" value="<%= user ? user.username : '' %>" disabled class="auth-input">
        </div>

        <div class="form-group">
          <label for="new_username">新用户名</label>
          <input type="text" id="new_username" name="new_username" class="auth-input" placeholder="3-20个字符，支持中文、字母、数字和下划线" required minlength="3" maxlength="20" value="<%= typeof username !== 'undefined' ? username : '' %>">
        </div>

        <div class="form-group">
          <label for="password">当前密码（验证身份）</label>
          <div class="password-field">
            <input type="password" id="password" name="password" class="auth-input" placeholder="请输入当前密码以验证身份" required>
            <button type="button" class="toggle-password" onclick="togglePassword('password')">
              <i class="fas fa-eye"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="auth-btn auth-btn-primary">
          <i class="fas fa-user-edit"></i> 修改用户名
        </button>
      </form>
      
      <div class="auth-links">
        <p><a href="/">返回首页</a></p>
      </div>

    <!-- 强制修改密码 -->
    <% } else if (mode === 'force-change-password') { %>
      <div class="auth-alert auth-alert-warning">
        <i class="fas fa-exclamation-triangle"></i>
        <span>您的密码已被管理员重置，请设置一个新密码后继续使用。</span>
      </div>

      <form action="/auth/<%= source %>/force-change-password" method="POST" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label>当前用户</label>
          <input type="text" value="<%= user.username %>" disabled class="auth-input">
        </div>

        <div class="form-group">
          <label for="new_password">新密码</label>
          <div class="password-field">
            <input type="password" id="new_password" name="new_password" class="auth-input" placeholder="请输入新密码（至少6位）" required minlength="6">
            <button type="button" class="toggle-password" onclick="togglePassword('new_password')">
              <i class="fas fa-eye"></i>
            </button>
          </div>
        </div>

        <div class="form-group">
          <label for="confirm_password">确认新密码</label>
          <div class="password-field">
            <input type="password" id="confirm_password" name="confirm_password" class="auth-input" placeholder="请再次输入新密码" required minlength="6">
            <button type="button" class="toggle-password" onclick="togglePassword('confirm_password')">
              <i class="fas fa-eye"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="auth-btn auth-btn-primary">
          <i class="fas fa-check-circle"></i> 确认修改
        </button>
      </form>
    <% } %>
    </main>
  </div>

  <!-- 用户协议弹窗 - 仅前端站点 -->
  <% if (mode === 'register' || mode === 'login') { %>
    <div class="auth-modal-overlay" id="termsModal">
      <div class="auth-modal-content">
        <div class="auth-modal-header">
          <h2>用户协议</h2>
          <button class="auth-modal-close" onclick="closeAuthModal('terms')">&times;</button>
        </div>
        <div class="auth-modal-body" id="termsBody" onscroll="onModalScroll('terms')">
          <%- userAgreement || '<p>暂无用户协议内容</p>' %>
        </div>
        <div class="auth-modal-footer">
          <button class="auth-btn auth-btn-primary" id="termsAgreeBtn" style="width:auto; padding: 10px 24px; opacity:0.5; cursor:not-allowed;" disabled onclick="agreeAndCloseAuth('terms')">
            请阅读协议 (<span id="termsCountdown">5</span>s)
          </button>
          <button class="auth-btn" style="width:auto; padding: 10px 24px; background:#f0f0f0; color:#666;" onclick="closeAuthModal('terms')">关闭</button>
        </div>
      </div>
    </div>

    <div class="auth-modal-overlay" id="privacyModal">
      <div class="auth-modal-content">
        <div class="auth-modal-header">
          <h2>隐私政策</h2>
          <button class="auth-modal-close" onclick="closeAuthModal('privacy')">&times;</button>
        </div>
        <div class="auth-modal-body" id="privacyBody" onscroll="onModalScroll('privacy')">
          <%- privacyPolicy || '<p>暂无隐私政策内容</p>' %>
        </div>
        <div class="auth-modal-footer">
          <button class="auth-btn auth-btn-primary" id="privacyAgreeBtn" style="width:auto; padding: 10px 24px; opacity:0.5; cursor:not-allowed;" disabled onclick="agreeAndCloseAuth('privacy')">
            请阅读协议 (<span id="privacyCountdown">5</span>s)
          </button>
          <button class="auth-btn" style="width:auto; padding: 10px 24px; background:#f0f0f0; color:#666;" onclick="closeAuthModal('privacy')">关闭</button>
        </div>
      </div>
    </div>

    <div class="auth-modal-overlay" id="oauthPrivacyModal">
      <div class="auth-modal-content">
        <div class="auth-modal-header">
          <h2>第三方登录隐私政策</h2>
          <button class="auth-modal-close" onclick="closeAuthModal('oauthPrivacy')">&times;</button>
        </div>
        <div class="auth-modal-body" id="oauthPrivacyBody" onscroll="onModalScroll('oauthPrivacy')">
          <%- (typeof oauthPrivacyPolicy !== 'undefined' && oauthPrivacyPolicy) ? oauthPrivacyPolicy : '<p>暂无第三方登录隐私政策内容</p>' %>
        </div>
        <div class="auth-modal-footer">
          <button class="auth-btn auth-btn-primary" id="oauthPrivacyAgreeBtn" style="width:auto; padding: 10px 24px; opacity:0.5; cursor:not-allowed;" disabled onclick="agreeAndCloseAuth('oauthPrivacy')">
            请阅读协议 (<span id="oauthPrivacyCountdown">5</span>s)
          </button>
          <button class="auth-btn" style="width:auto; padding: 10px 24px; background:#f0f0f0; color:#666;" onclick="closeAuthModal('oauthPrivacy')">关闭</button>
        </div>
      </div>
    </div>
  <% } %>

  <script>
    // 邮箱格式验证函数（基础格式校验：用户名@域名）
    function validateEmailFormat(input) {
      var email = input.value.trim();
      var helpEl = document.getElementById('emailHelp');
      if (!helpEl) return;
      if (email.length === 0) {
        input.style.borderColor = '';
        helpEl.style.color = '#999';
        helpEl.textContent = '邮箱格式：用户名@域名（如：username@example.com）';
        return;
      }
      // 标准邮箱格式校验（与后端一致）
      var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (emailRegex.test(email)) {
        input.style.borderColor = '#28a745';
        helpEl.style.color = '#28a745';
        helpEl.textContent = '✓ 邮箱格式正确';
      } else {
        input.style.borderColor = '#dc3545';
        helpEl.style.color = '#dc3545';
        var errMsg = '';
        if (!email.includes('@')) {
          errMsg = '邮箱缺少 @ 符号（如 username@example.com）';
        } else if (!email.includes('.')) {
          errMsg = '邮箱域名不完整，缺少 .xxx 后缀';
        } else {
          errMsg = '邮箱格式不正确，请检查输入';
        }
        helpEl.textContent = '✗ ' + errMsg;
      }
    }

    // 密码显示/隐藏功能
    function togglePassword(inputId) {
      var input = document.getElementById(inputId);
      if (!input) return;
      var icon = input.parentElement.querySelector('.toggle-password i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      }
    }

    // 图形验证码刷新功能 - 通过 JSON 接口获取新的验证码内容并直接替换
    function refreshCaptchaCommon(imgWrapperId) {
      var imgWrapper = document.getElementById(imgWrapperId);
      if (!imgWrapper) return;
      fetch('/auth/captcha')
        .then(function(response) { return response.text(); })
        .then(function(svgData) {
          imgWrapper.innerHTML = svgData;
        })
        .catch(function() {
          location.reload();
        });
    }

    function refreshRegisterCaptcha() {
      refreshCaptchaCommon('registerCaptchaWrapper');
    }

    function refreshForgotCaptcha() {
      refreshCaptchaCommon('forgotCaptchaWrapper');
    }

    <% if (mode === 'login') { %>
    // 记住登录：仅保存用户名（密码不落盘，会话保持由服务端 cookie 控制）
    function saveUsername(username) {
      try {
        localStorage.setItem('auth_remember_<%= source %>', JSON.stringify({
          username: btoa(unescape(encodeURIComponent(username || '')))
        }));
      } catch(e) {}
    }

    function loadUsername() {
      try {
        var data = localStorage.getItem('auth_remember_<%= source %>');
        if (!data) return null;
        var parsed = JSON.parse(data);
        var username = '';
        if (typeof parsed.username === 'string') {
          username = decodeURIComponent(escape(atob(parsed.username)));
          // 旧版格式含密码：迁移为仅用户名，立即清除密码
          if (parsed.password !== undefined) saveUsername(username);
        }
        return username || null;
      } catch(e) {}
      return null;
    }

    function clearUsername() {
      localStorage.removeItem('auth_remember_<%= source %>');
    }

    // 页面加载时自动填充用户名
    (function() {
      var savedUsername = loadUsername();
      if (savedUsername) {
        var usernameInput = document.getElementById('username');
        if (usernameInput) usernameInput.value = savedUsername;
      }
    })();

    // ============ AJAX 登录 ============
    function showAuthError(message) {
      var alert = document.getElementById('authErrorAlert');
      var text = document.getElementById('authErrorText');
      if (!alert || !text) return;
      text.textContent = message || '';
      alert.style.display = message ? 'flex' : 'none';
    }

    function clearFieldErrors() {
      document.querySelectorAll('.auth-form .field-error').forEach(function(el) {
        el.textContent = '';
      });
      document.querySelectorAll('.auth-form .has-error').forEach(function(el) {
        el.classList.remove('has-error');
      });
    }

    function applyFieldErrors(fieldErrors) {
      var errorMap = {
        username: 'err-username',
        password: 'err-password',
        captcha: 'err-captcha',
        agree_terms: 'err-agree',
        agree_privacy: 'err-agree'
      };
      Object.keys(fieldErrors).forEach(function(field) {
        var msg = fieldErrors[field];
        if (!msg) return;
        var errorEl = document.getElementById(errorMap[field]);
        if (errorEl) errorEl.textContent = msg;
        var input = loginForm.querySelector('[name="' + field + '"]');
        if (input) input.classList.add('has-error');
      });
    }

    // 登录失败次数达标后动态插入验证码（复用 /auth/captcha 刷新）
    function ensureLoginCaptcha() {
      if (document.getElementById('loginCaptchaGroup')) {
        refreshCaptchaCommon('loginCaptchaWrapper');
        return;
      }
      var group = document.createElement('div');
      group.className = 'form-group captcha-group';
      group.id = 'loginCaptchaGroup';
      group.innerHTML =
        '<label for="loginCaptcha">图形验证码 <span class="required">*</span></label>' +
        '<div class="captcha-container">' +
          '<div class="captcha-image-wrapper" id="loginCaptchaWrapper" onclick="refreshCaptchaCommon(\'loginCaptchaWrapper\')" title="点击刷新验证码"></div>' +
          '<button type="button" class="captcha-refresh" onclick="refreshCaptchaCommon(\'loginCaptchaWrapper\')" title="刷新验证码"><i class="fas fa-sync-alt"></i></button>' +
        '</div>' +
        '<input type="text" id="loginCaptcha" name="captcha" class="auth-input" placeholder="请输入验证码" required maxlength="10" autocomplete="off">' +
        '<div class="field-error" id="err-captcha"></div>';
      var submitBtn = document.getElementById('loginSubmitBtn');
      loginForm.insertBefore(group, submitBtn);
      refreshCaptchaCommon('loginCaptchaWrapper');
    }

    // 开启两步验证后动态插入 TOTP 输入框（AJAX 登录二次提交）
    function ensureLoginTotp() {
      if (document.getElementById('loginTotpGroup')) return;
      var group = document.createElement('div');
      group.className = 'form-group';
      group.id = 'loginTotpGroup';
      group.innerHTML =
        '<label for="loginTotp">两步验证码 <span class="required">*</span></label>' +
        '<input type="text" id="loginTotp" name="totp_code" class="auth-input" placeholder="请输入身份验证器中的 6 位数字" required maxlength="6" autocomplete="one-time-code" inputmode="numeric">' +
        '<div class="field-error" id="err-totp_code"></div>';
      var submitBtn = document.getElementById('loginSubmitBtn');
      loginForm.insertBefore(group, submitBtn);
    }

    var loginForm = document.getElementById('loginForm');
    if (loginForm) {
      loginForm.addEventListener('submit', function(e) {
        var rememberCheck = document.getElementById('remember');
        var usernameInput = document.getElementById('username');
        if (rememberCheck && rememberCheck.checked) {
          saveUsername(usernameInput ? usernameInput.value : '');
        } else {
          clearUsername();
        }

        e.preventDefault();
        var btn = document.getElementById('loginSubmitBtn');
        if (btn) {
          btn.disabled = true;
          btn.classList.add('is-loading');
        }

        fetch(loginForm.action, {
          method: 'POST',
          headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
          },
          // FormData 会让 fetch 自动发送 multipart/form-data，服务端未解析该类型
          // 转成 URLSearchParams 以 urlencoded 提交，与原生表单保持一致
          body: new URLSearchParams(new FormData(loginForm))
        })
        .then(function(response) {
          return response.json().catch(function() {
            return { ok: false, error: '网络错误，请稍后重试' };
          });
        })
        .then(function(data) {
          clearFieldErrors();
          if (data.ok && data.redirect) {
            window.location.href = data.redirect;
            return;
          }
          if (data.fieldErrors) applyFieldErrors(data.fieldErrors);
          showAuthError(data.error || '登录失败，请重试');
          if (data.captchaRequired) ensureLoginCaptcha();
          if (data.totpRequired) ensureLoginTotp();
        })
        .catch(function() {
          showAuthError('请求失败，请重试');
        })
        .then(function() {
          if (btn) {
            btn.disabled = false;
            btn.classList.remove('is-loading');
          }
        });
      });
    }
    <% } %>

    <% if (mode === 'register' || mode === 'login') { %>
    // 弹窗控制与5秒阅读倒计时
    var modalTimers = {};

    function showAuthModal(type) {
      document.getElementById(type + 'Modal').classList.add('active');
      document.body.style.overflow = 'hidden';
      // 启动5秒倒计时
      startModalTimer(type);
    }

    function closeAuthModal(type) {
      document.getElementById(type + 'Modal').classList.remove('active');
      document.body.style.overflow = '';
      // 重置倒计时
      resetModalTimer(type);
    }

    function startModalTimer(type) {
      var countdownEl = document.getElementById(type + 'Countdown');
      var btnEl = document.getElementById(type + 'AgreeBtn');
      if (!countdownEl || !btnEl) return;

      countdownEl.textContent = '5';
      btnEl.disabled = true;
      btnEl.style.opacity = '0.5';
      btnEl.style.cursor = 'not-allowed';
      btnEl.innerHTML = '请阅读协议 (<span id="' + type + 'Countdown">5</span>s)';

      var seconds = 5;
      modalTimers[type] = setInterval(function() {
        seconds--;
        var el = document.getElementById(type + 'Countdown');
        if (el) el.textContent = seconds;
        if (seconds <= 0) {
          clearInterval(modalTimers[type]);
          modalTimers[type] = null;
          btnEl.disabled = false;
          btnEl.style.opacity = '1';
          btnEl.style.cursor = 'pointer';
          btnEl.textContent = '我已阅读并同意';
        }
      }, 1000);
    }

    function resetModalTimer(type) {
      if (modalTimers[type]) {
        clearInterval(modalTimers[type]);
        modalTimers[type] = null;
      }
      var btnEl = document.getElementById(type + 'AgreeBtn');
      if (btnEl) {
        btnEl.disabled = true;
        btnEl.style.opacity = '0.5';
        btnEl.style.cursor = 'not-allowed';
        btnEl.innerHTML = '请阅读协议 (<span id="' + type + 'Countdown">5</span>s)';
      }
    }

    // 滚动到弹窗内容底部时启用「我已阅读并同意」按钮（与倒计时双保险）
    function onModalScroll(type) {
      var body = document.getElementById(type + 'Body');
      var btnEl = document.getElementById(type + 'AgreeBtn');
      if (!body || !btnEl || !btnEl.disabled) return;
      if (body.scrollHeight - body.scrollTop - body.clientHeight <= 4) {
        btnEl.disabled = false;
        btnEl.style.opacity = '1';
        btnEl.style.cursor = 'pointer';
        btnEl.textContent = '我已阅读并同意';
        if (modalTimers[type]) {
          clearInterval(modalTimers[type]);
          modalTimers[type] = null;
        }
      }
    }

    function agreeAndCloseAuth(type) {
      if (type === 'oauthPrivacy') {
        // 第三方登录隐私政策 -> 勾选对应的复选框
        var oauthPrivacyCheckbox = document.getElementById('oauthAgreePrivacy');
        if (oauthPrivacyCheckbox) oauthPrivacyCheckbox.checked = true;
      } else {
        // 根据当前模式选择对应的复选框
        var checkboxId = '<%= mode %>' === 'login'
          ? 'loginAgree' + (type === 'terms' ? 'Terms' : 'Privacy')
          : 'agree' + (type === 'terms' ? 'Terms' : 'Privacy');
        var checkbox = document.getElementById(checkboxId);
        if (checkbox) checkbox.checked = true;
      }
      closeAuthModal(type);
    }

    // 点击遮罩层关闭弹窗
    document.addEventListener('click', function(e) {
      if (e.target.classList.contains('auth-modal-overlay')) {
        e.target.classList.remove('active');
        document.body.style.overflow = '';
      }
    });

    // 表单提交验证复选框和邮箱格式
    var registerForm = document.getElementById('registerForm');
    if (registerForm) {
      registerForm.addEventListener('submit', function(e) {
        var agreeCheck = document.getElementById('agreeCheck');
        if (agreeCheck && !agreeCheck.checked) {
          e.preventDefault();
          agreeCheck.focus();
          var label = agreeCheck.closest('.auth-checkbox-label');
          if (label) {
            label.style.color = 'var(--auth-error)';
            setTimeout(function() { label.style.color = ''; }, 2000);
          }
          return false;
        }
        // 提交时再次验证邮箱格式
        var emailInput = document.getElementById('email');
        if (emailInput) {
          var email = emailInput.value.trim();
          var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(email)) {
            e.preventDefault();
            validateEmailFormat(emailInput);
            emailInput.focus();
            return false;
          }
        }
      });
    }

    // 抖动动画
    var shakeStyle = document.createElement('style');
    shakeStyle.textContent = '@keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-6px); } 50% { transform: translateX(6px); } 75% { transform: translateX(-3px); } }';
    document.head.appendChild(shakeStyle);

    // 密码强度检测
    var passwordInput = document.getElementById('password');
    var confirmInput = document.getElementById('confirm_password');
    if (passwordInput && confirmInput) {
      passwordInput.addEventListener('input', checkPasswordStrength);
      confirmInput.addEventListener('input', checkPasswordMatch);
    }

    function checkPasswordStrength() {
      var pwd = document.getElementById('password').value;
      var strengthEl = document.getElementById('passwordStrength');
      var bar = document.getElementById('strengthBar');
      var text = document.getElementById('strengthText');
      
      if (!pwd) { strengthEl.style.display = 'none'; return; }
      strengthEl.style.display = 'block';
      
      var score = 0;
      if (pwd.length >= 6) score++;
      if (pwd.length >= 10) score++;
      if (/[A-Z]/.test(pwd) && /[a-z]/.test(pwd)) score++;
      if (/[0-9]/.test(pwd)) score++;
      if (/[^A-Za-z0-9]/.test(pwd)) score++;
      
      var levels = [
        { width: '20%', color: '#ef4444', text: '弱', textColor: '#ef4444' },
        { width: '40%', color: '#f97316', text: '一般', textColor: '#f97316' },
        { width: '60%', color: '#eab308', text: '中等', textColor: '#eab308' },
        { width: '80%', color: '#22c55e', text: '强', textColor: '#22c55e' },
        { width: '100%', color: '#16a34a', text: '非常强', textColor: '#16a34a' }
      ];
      
      var level = levels[Math.min(score, 4)];
      bar.style.width = level.width;
      bar.style.background = level.color;
      text.textContent = '密码强度: ' + level.text;
      text.style.color = level.textColor;
    }

    function checkPasswordMatch() {
      var pwd = document.getElementById('password').value;
      var confirm = document.getElementById('confirm_password').value;
      var matchEl = document.getElementById('passwordMatch');
      
      if (!confirm) { matchEl.textContent = ''; return; }
      
      if (pwd === confirm) {
        matchEl.textContent = '✓ 密码匹配';
        matchEl.style.color = '#16a34a';
      } else {
        matchEl.textContent = '✗ 密码不匹配';
        matchEl.style.color = '#ef4444';
      }
    }
    <% } %>

    <% if (mode === 'register' && step === 'verify') { %>
    // 获取CSRF token
    function getCsrfToken() {
      var meta = document.querySelector('meta[name="csrf-token"]');
      return meta ? meta.getAttribute('content') : '';
    }

    // 验证码步骤 - 重新发送验证码
    function resendVerifyCode() {
      var btn = document.getElementById('resendCodeBtn');
      var text = document.getElementById('resendText');
      if (btn.disabled) return;
      
      btn.disabled = true;
      text.textContent = '发送中...';
      
      // 使用fetch API发送重新发送请求
      fetch('/auth/<%= source %>/register/resend-code', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/x-www-form-urlencoded',
          'X-CSRF-Token': getCsrfToken()
        }
      })
      .then(function(response) {
        return response.text();
      })
      .then(function(html) {
        // 刷新页面内容显示新消息
        document.open();
        document.write(html);
        document.close();
      })
      .catch(function() {
        text.textContent = '发送失败，请重试';
        btn.disabled = false;
        setTimeout(function() {
          text.textContent = '重新发送验证码';
        }, 2000);
      });
    }
    
    // 自动聚焦验证码输入框
    document.addEventListener('DOMContentLoaded', function() {
      var codeInput = document.getElementById('code');
      if (codeInput) {
        codeInput.focus();
      }
    });
    <% } %>

    // 第三方登录
    function oauthLogin(provider, source) {
      // 检查协议勾选
      var agreePrivacy = document.getElementById('oauthAgreePrivacy');
      var agreeTerms = document.getElementById('oauthAgreeTerms');
      if (!agreePrivacy || !agreePrivacy.checked) {
        alert('请先阅读并同意《第三方登录隐私政策》');
        if (agreePrivacy) agreePrivacy.focus();
        return;
      }
      if (!agreeTerms || !agreeTerms.checked) {
        alert('请先阅读并同意《用户协议》和《隐私政策》');
        if (agreeTerms) agreeTerms.focus();
        return;
      }

      var btn = document.querySelector('.oauth-btn-' + provider);
      if (btn) {
        btn.disabled = true;
        btn.style.opacity = '0.6';
      }
      
      fetch('/oauth/auth-url/' + provider + '?source=' + encodeURIComponent(source) + '&intent=login')
        .then(function(response) { return response.json(); })
        .then(function(data) {
          if (data.url) {
            window.location.href = data.url;
          } else {
            alert(data.error || '获取授权链接失败');
            if (btn) {
              btn.disabled = false;
              btn.style.opacity = '1';
            }
          }
        })
        .catch(function() {
          alert('请求失败，请重试');
          if (btn) {
            btn.disabled = false;
            btn.style.opacity = '1';
          }
        });
    }
  </script>
</body>
</html>