<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= modeTitle %> - <%= siteName %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="<%= typeof cdn !== 'undefined' ? cdn.getUrl('/css/auth.css') : '/css/auth.css' %>">
</head>
<body class="auth-page <%= source %>-theme">
  <div class="auth-container">
    <div class="auth-header">
      <h1><%= siteName %></h1>
      <p><%= modeSubtitle %></p>
    </div>
    
    <% if (error) { %>
      <div class="auth-alert auth-alert-error">
        <i class="fas fa-exclamation-circle"></i>
        <span><%= error %></span>
      </div>
    <% } %>
    <% if (success) { %>
      <div class="auth-alert auth-alert-success">
        <i class="fas fa-check-circle"></i>
        <span><%= success %></span>
      </div>
    <% } %>

    <form action="/auth/<%= source %>/login" method="POST" class="auth-form" id="loginForm">
      <div class="form-group">
        <label for="username">用户名</label>
        <input type="text" id="username" name="username" class="auth-input" placeholder="请输入用户名" required value="<%= typeof username !== 'undefined' ? username : '' %>">
      </div>
      
      <div class="form-group">
        <label for="password">密码</label>
        <div class="password-field">
          <input type="password" id="password" name="password" class="auth-input" placeholder="请输入密码" required>
          <button type="button" class="toggle-password" onclick="togglePassword('password')">
            <i class="fas fa-eye"></i>
          </button>
        </div>
      </div>
      
      <label class="remember-me">
        <input type="checkbox" name="remember" id="remember"> 记住用户名
      </label>
      
      <button type="submit" class="auth-btn auth-btn-primary">
        <i class="fas fa-sign-in-alt"></i> 登录
      </button>
    </form>

    <!-- 第三方登录 -->
    <% if (typeof oauthProviders !== 'undefined' && oauthProviders && oauthProviders.length > 0) { %>
      <div class="auth-divider">
        <span>其他登录方式</span>
      </div>
      <div class="oauth-buttons">
        <% oauthProviders.forEach(function(provider) { %>
          <button type="button" class="oauth-btn oauth-btn-<%= provider.provider %>" 
                  onclick="oauthLogin('<%= provider.provider %>', '<%= source %>')"
                  title="使用<%= provider.display_name %>登录"
                  style="--oauth-color: <%= provider.color %>">
            <i class="<%= provider.icon %>"></i>
            <span><%= provider.display_name %></span>
          </button>
        <% }); %>
      </div>
    <% } %>
    
    <div class="auth-links">
      <p>还没有账号？<a href="/auth/<%= source %>/register">立即注册</a></p>
      <p><a href="/auth/<%= source %>/forgot-password">忘记密码？</a></p>
      <% if (source === 'image-share') { %>
        <p><a href="/image-share">返回图片分享</a></p>
      <% } else { %>
        <p><a href="/">返回首页</a></p>
      <% } %>
    </div>
  </div>

  <script>
    function togglePassword(inputId) {
      var input = document.getElementById(inputId);
      if (!input) return;
      var icon = input.parentElement.querySelector('.toggle-password i');
      if (input.type === 'password') {
        input.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      } else {
        input.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      }
    }

    // 安全记住用户名（不保存密码，避免明文凭据泄露）
    function saveUsername(username) {
      try {
        localStorage.setItem('auth_remember_<%= source %>', JSON.stringify({
          username: encodeURIComponent(username || '')
        }));
      } catch(e) {}
    }

    function decodeOldValue(value) {
      try { return decodeURIComponent(escape(atob(value))); } catch(e) { return ''; }
    }

    function loadUsername() {
      try {
        var data = localStorage.getItem('auth_remember_<%= source %>');
        if (!data) return null;
        var parsed = JSON.parse(data);
        var username = '';
        if (typeof parsed.username === 'string') {
          if (parsed.password !== undefined) {
            // 旧版格式（含密码）：仅取用户名，并立即迁移为安全格式清除密码
            username = decodeOldValue(parsed.username);
            if (username) saveUsername(username);
          } else {
            username = decodeURIComponent(parsed.username);
          }
        }
        return username || null;
      } catch(e) {}
      return null;
    }

    function clearCredentials() {
      localStorage.removeItem('auth_remember_<%= source %>');
    }

    (function() {
      var savedUsername = loadUsername();
      if (savedUsername) {
        var usernameInput = document.getElementById('username');
        var rememberCheck = document.getElementById('remember');
        if (usernameInput) usernameInput.value = savedUsername;
        if (rememberCheck) rememberCheck.checked = true;
      }
    })();

    var loginForm = document.getElementById('loginForm');
    if (loginForm) {
      loginForm.addEventListener('submit', function(e) {
        var rememberCheck = document.getElementById('remember');
        var usernameInput = document.getElementById('username');
        if (rememberCheck && rememberCheck.checked) {
          saveUsername(usernameInput.value);
        } else {
          clearCredentials();
        }
      });
    }

    // 第三方登录
    function oauthLogin(provider, source) {
      var btn = document.querySelector('.oauth-btn-' + provider);
      if (btn) {
        btn.disabled = true;
        btn.style.opacity = '0.6';
      }
      
      fetch('/oauth/auth-url/' + provider + '?source=' + encodeURIComponent(source))
        .then(function(response) { return response.json(); })
        .then(function(data) {
          if (data.url) {
            window.location.href = data.url;
          } else {
            alert(data.error || '获取授权链接失败');
            if (btn) {
              btn.disabled = false;
              btn.style.opacity = '1';
            }
          }
        })
        .catch(function(error) {
          alert('请求失败，请重试');
          if (btn) {
            btn.disabled = false;
            btn.style.opacity = '1';
          }
        });
    }
  </script>
</body>
</html>
