<%# ===== 页面模板：image-share/header.ejs =====%>
<%# 说明：图片分享-公共导航头（EJS 服务端模板，由 Express 渲染，变量与部分逻辑见对应路由） %>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' - ' : '' %><%= config.site_name || '图片分享网' %></title>
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #fdf5f9; color: #43303e; min-height: 100vh; }
    a { text-decoration: none; color: inherit; }
    .nav { background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%); color: white; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 2px 10px rgba(236,72,153,0.25); }
    .nav .logo { font-size: 20px; font-weight: bold; }
    .nav .logo a { color: white; }
    .nav-links { display: flex; gap: 15px; align-items: center; }
    .nav-links a { color: rgba(255,255,255,0.9); padding: 8px 12px; border-radius: 6px; transition: all 0.3s; }
    .nav-links a:hover { background: rgba(255,255,255,0.2); color: white; }
    .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
    .btn { display: inline-block; padding: 8px 20px; border-radius: 10px; border: none; cursor: pointer; font-size: 14px; transition: all 0.3s; text-align: center; }
    .btn-primary { background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%); color: white; box-shadow: 0 4px 12px -4px rgba(236,72,153,0.45); }
    .btn-primary:hover { opacity: 0.92; transform: translateY(-1px); }
    .btn-success { background: #10b981; color: white; }
    .btn-danger { background: #f43f5e; color: white; }
    .btn-warning { background: #f59e0b; color: #43303e; }
    .btn-sm { padding: 5px 12px; font-size: 12px; }
    .card { background: white; border-radius: 14px; padding: 20px; margin-bottom: 20px; box-shadow: 0 2px 10px rgba(236,72,153,0.08); }
    .form-group { margin-bottom: 15px; }
    .form-group label { display: block; margin-bottom: 5px; font-weight: 500; color: #7c5e70; }
    .form-group input, .form-group textarea, .form-group select { width: 100%; padding: 10px 12px; border: 1px solid #f0d6e2; border-radius: 8px; font-size: 14px; transition: border-color 0.3s; background: #fff; }
    .form-group input:focus, .form-group textarea:focus, .form-group select:focus { outline: none; border-color: #ec4899; box-shadow: 0 0 0 3px rgba(236,72,153,0.12); }
    .form-group textarea { resize: vertical; min-height: 80px; }
    .alert { padding: 12px 16px; border-radius: 10px; margin-bottom: 15px; }
    .alert-success { background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0; }
    .alert-danger { background: #ffe4e6; color: #9f1239; border: 1px solid #fecdd3; }
    .alert-info { background: #e0f2fe; color: #075985; border: 1px solid #bae6fd; }
    .alert-warning { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
    .image-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; }
    .image-card { background: white; border-radius: 14px; overflow: hidden; box-shadow: 0 2px 10px rgba(236,72,153,0.08); transition: transform 0.3s, box-shadow 0.3s; display: block; }
    .image-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(236,72,153,0.18); }
    .image-card img { width: 100%; height: 200px; object-fit: cover; }
    .image-card .info { padding: 12px; }
    .image-card .title { font-weight: 600; margin-bottom: 5px; }
    .image-card .meta { font-size: 12px; color: #c39fb4; }
    .category-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 15px; }
    .category-card { background: white; border-radius: 14px; padding: 20px; text-align: center; box-shadow: 0 2px 10px rgba(236,72,153,0.08); transition: all 0.3s; cursor: pointer; display: block; }
    .category-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(236,72,153,0.15); }
    .category-card i { font-size: 32px; color: #ec4899; margin-bottom: 10px; display: block; }
    .category-card h3 { font-size: 14px; color: #7c5e70; }
    .badge { display: inline-block; padding: 3px 8px; border-radius: 10px; font-size: 11px; font-weight: 500; }
    .badge-success { background: #d1fae5; color: #065f46; }
    .badge-warning { background: #fef3c7; color: #92400e; }
    .badge-danger { background: #ffe4e6; color: #9f1239; }
    .badge-info { background: #e0f2fe; color: #075985; }
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 15px; margin-bottom: 20px; }
    .stat-card { background: white; border-radius: 14px; padding: 20px; text-align: center; box-shadow: 0 2px 10px rgba(236,72,153,0.08); }
    .stat-card .number { font-size: 28px; font-weight: bold; color: #ec4899; }
    .stat-card .label { font-size: 13px; color: #c39fb4; margin-top: 5px; }
    table { width: 100%; border-collapse: collapse; }
    table th, table td { padding: 12px; text-align: left; border-bottom: 1px solid #f9e9f1; }
    table th { background: #fdf5f9; font-weight: 600; color: #7c5e70; }
    table tr:hover { background: #fdf2f8; }
    .search-bar { display: flex; gap: 10px; margin-bottom: 20px; }
    .search-bar input { flex: 1; padding: 10px 15px; border: 1px solid #f0d6e2; border-radius: 10px; font-size: 14px; }
    .search-bar input:focus { outline: none; border-color: #ec4899; box-shadow: 0 0 0 3px rgba(236,72,153,0.12); }
    .footer { background: #2a1e3e; color: #c3b7d3; text-align: center; padding: 20px; margin-top: 40px; }
    .tabs { display: flex; gap: 5px; margin-bottom: 20px; border-bottom: 2px solid #f9e9f1; padding-bottom: 10px; }
    .tabs a { padding: 8px 16px; border-radius: 10px 10px 0 0; color: #7c5e70; transition: all 0.3s; }
    .tabs a.active, .tabs a:hover { background: linear-gradient(135deg, #ec4899, #8b5cf6); color: white; }
    .empty-state { text-align: center; padding: 50px; color: #c39fb4; }
    .empty-state i { font-size: 48px; margin-bottom: 15px; display: block; }
    @media (max-width: 768px) {
      .nav { flex-direction: column; gap: 10px; padding: 12px 16px; }
      .nav-links { flex-wrap: wrap; justify-content: center; gap: 8px; }
      .nav-links a { padding: 6px 10px; font-size: 13px; }
      .image-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
      .category-grid { grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 10px; }
      .stats { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .container { padding: 12px; }
      .card { padding: 16px; }
      .image-card img { height: 150px; }
    }
    @media (max-width: 480px) {
      .nav .logo { font-size: 17px; }
      .nav-links a { padding: 5px 8px; font-size: 12px; }
      .image-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .category-grid { grid-template-columns: repeat(2, 1fr); }
      .stats { grid-template-columns: 1fr; }
      .stat-card { padding: 14px; }
      .stat-card .number { font-size: 22px; }
      .image-card img { height: 120px; }
      .image-card .info { padding: 8px; }
      .image-card .title { font-size: 13px; }
      .container { padding: 8px; }
      table { font-size: 13px; }
      table th, table td { padding: 8px 6px; }
    }
  </style>
  <link rel="stylesheet" href="/css/anime-theme.css">
</head>
<body>
  <nav class="nav">
    <div class="logo"><a href="/image-share"><i class="fas fa-images"></i> <%= config.site_name || '图片分享网' %></a></div>
    <div class="nav-links">
      <a href="/" style="background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3);" title="返回主站"><i class="fas fa-arrow-left"></i> 返回主站</a>
      <a href="/image-share"><i class="fas fa-home"></i> 首页</a>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/image-share/user"><i class="fas fa-user"></i> 我的图片</a>
        <a href="/image-share/user/upload"><i class="fas fa-upload"></i> 上传</a>
        <% if (user.role === 1 || user.role === 'admin' || user.role === 'super_admin') { %>
          <a href="/admin/image-share"><i class="fas fa-cog"></i> 管理</a>
        <% } %>
        <span style="color: rgba(255,255,255,0.7);">|</span>
        <a href="/image-share/user/profile"><i class="fas fa-user-circle"></i> <%= user.nickname || user.username %></a>
        <a href="/image-share/logout"><i class="fas fa-sign-out-alt"></i> 退出</a>
      <% } else { %>
        <a href="/image-share/login"><i class="fas fa-sign-in-alt"></i> 登录</a>
        <a href="/image-share/register"><i class="fas fa-user-plus"></i> 注册</a>
      <% } %>
    </div>
  </nav>
  <div class="container">